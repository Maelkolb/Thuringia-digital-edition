<zone xml:id="f0283-l21" type="line" n="21" ulx="73" uly="1227" lrx="1421" lry="1270"/><zone xml:id="f0283-l22" type="line" n="22" ulx="74" uly="1271" lrx="1418" lry="1314"/><zone xml:id="f0283-l23" type="line" n="23" ulx="73" uly="1315" lrx="1421" lry="1356"/><zone xml:id="f0283-l24" type="line" n="24" ulx="71" uly="1358" lrx="1421" lry="1398"/><zone xml:id="f0283-l25" type="line" n="25" ulx="71" uly="1398" lrx="1420" lry="1441"/><zone xml:id="f0283-l26" type="line" n="26" ulx="70" uly="1441" lrx="1420" lry="1484"/><zone xml:id="f0283-l27" type="line" n="27" ulx="70" uly="1488" lrx="1420" lry="1527"/><zone xml:id="f0283-l28" type="line" n="28" ulx="70" uly="1525" lrx="1421" lry="1568"/><zone xml:id="f0283-l29" type="line" n="29" ulx="71" uly="1569" lrx="1417" lry="1612"/><zone xml:id="f0283-l30" type="line" n="30" ulx="70" uly="1612" lrx="1418" lry="1655"/><zone xml:id="f0283-l31" type="line" n="31" ulx="76" uly="1656" lrx="1420" lry="1699"/><zone xml:id="f0283-l32" type="line" n="32" ulx="73" uly="1698" lrx="1418" lry="1741"/><zone xml:id="f0283-l33" type="line" n="33" ulx="74" uly="1740" lrx="1417" lry="1783"/><zone xml:id="f0283-l34" type="line" n="34" ulx="71" uly="1784" lrx="1417" lry="1827"/><zone xml:id="f0283-l35" type="line" n="35" ulx="68" uly="1826" lrx="1417" lry="1868"/><zone xml:id="f0283-l36" type="line" n="36" ulx="68" uly="1866" lrx="1415" lry="1909"/><zone xml:id="f0283-l37" type="line" n="37" ulx="70" uly="1911" lrx="1415" lry="1954"/><zone xml:id="f0283-l38" type="line" n="38" ulx="70" uly="1953" lrx="1415" lry="1996"/><zone xml:id="f0283-l39" type="line" n="39" ulx="68" uly="1997" lrx="1415" lry="2040"/><zone xml:id="f0283-l40" type="line" n="40" ulx="70" uly="2038" lrx="1415" lry="2081"/><zone xml:id="f0283-l41" type="line" n="41" ulx="67" uly="2082" lrx="1414" lry="2125"/><zone xml:id="f0283-l42" type="line" n="42" ulx="70" uly="2128" lrx="1415" lry="2168"/><zone xml:id="f0283-l43" type="line" n="43" ulx="70" uly="2165" lrx="1414" lry="2208"/><zone xml:id="f0283-l44" type="line" n="44" ulx="70" uly="2211" lrx="1414" lry="2254"/><zone xml:id="f0283-l45" type="line" n="45" ulx="142" uly="2287" lrx="1414" lry="2330"/><zone xml:id="f0283-l46" type="line" n="46" ulx="68" uly="2323" lrx="1412" lry="2365"/><zone xml:id="f0283-l47" type="line" n="47" ulx="68" uly="2363" lrx="492" lry="2401"/></surface></facsimile>
<text><body>
<pb n="269" facs="#f0281" xml:id="p269"/>
<fw type="header" place="top">1. Die Verfassung.</fw>
<div type="section" n="c)" xml:id="sec-t1-4-1c">
<p xml:id="p269-b2">c) <lb n="9" facs="#f0281-l9"/>Gemeindeverfassung. An die Stelle der früher bestandenen ver<lb n="10" break="no" facs="#f0281-l10"/>schiedenen Land- und Stadtgemeindeordnungen trat den 13. Februar 1850 eine <lb n="11" facs="#f0281-l11"/>allgemeine, durch Verordnungen vom 8. Juli 1856, 10. December 1857 und <lb n="12" facs="#f0281-l12"/>10. April 1863 revidirte, im Gegensatze zu den früheren unselbstständigen Ge<lb n="13" break="no" facs="#f0281-l13"/>meinden auf das Recht freier Verwaltung gestützte Gemeindeordnung mit fol<lb n="14" break="no" facs="#f0281-l14"/>genden Hauptgrundlagen: Die ganze Bevölkerung des Staates zerfällt in Orts<lb n="15" break="no" facs="#f0281-l15"/>gemeinden und das ganze Staatsgebiet in Gemeindebezirke; jeder Staatsange<lb n="16" break="no" facs="#f0281-l16"/>hörige muß einer Gemeinde angehören und jedes Grundstück einem Gemeinde<lb n="17" break="no" facs="#f0281-l17"/>bezirke mit Ausnahme der zur unmittelbaren Benutzung des Landesregenten <lb n="18" facs="#f0281-l18"/>dienenden Grundbesitzungen und der <rs type="concept" ref="#concept-wald">Waldungen</rs> von ausgedehnterem Umfange; <lb n="19" facs="#f0281-l19"/>jede Gemeinde hat das Recht der Persönlichkeit, der selbstständigen Verwaltung <lb n="20" facs="#f0281-l20"/>ihrer Angelegenheiten unter gesetzlich geordneter Oberaufsicht des Staates, der <lb n="21" facs="#f0281-l21"/>Errichtung von Ortsstatuten, die aber weder den Gesetzen des Staates, noch <lb n="22" facs="#f0281-l22"/>wohlerworbenen Rechten Anderer zuwider laufen dürfen und der Erlassung <lb n="23" facs="#f0281-l23"/>von Geboten und Verboten mit Strafandrohung bis zu vier Tagen Gefängniß <lb n="24" facs="#f0281-l24"/>oder zwei Thalern Geldstrafe; sie ist zu allen Leistungen verpflichtet, die das <lb n="25" facs="#f0281-l25"/>aus dem Gemeindezwecke entspringende Bedürfniß (Ortsanstalten, <rs type="concept" ref="#concept-weg">Wege</rs>, <rs type="concept" ref="#concept-steg">Stege</rs>, <lb n="26" facs="#f0281-l26"/><rs type="concept" ref="#concept-wasserleitung">Wasserleitungen</rs>) erfordert; sie verwaltet das Gemeindevermögen; für sie sind <lb n="27" facs="#f0281-l27"/>alle Handlungen des Gemeindevorstandes rechtsverbindlich, wenn dieselben von <lb n="28" facs="#f0281-l28"/>der Gemeindeversammlung und den zuständigen Verwaltungsbehörden genehmigt <lb n="29" facs="#f0281-l29"/>sind. Gemeindebehörden sind der Gemeinderath und der Gemeindevorstand, <lb n="30" facs="#f0281-l30"/>jener als beschließende, dieser als ausführende Behörde. Gemeinden von 300 <lb n="31" facs="#f0281-l31"/>und mehr Einwohnern sind unbedingt zur Wahl eines Gemeinderaths verpflichtet, <lb n="32" facs="#f0281-l32"/>nicht aber Gemeinden von weniger als 300 Einwohnern, bei denen die Ge<lb n="33" break="no" facs="#f0281-l33"/>meindeversammlung den Gemeinderath vertreten kann. In Gemeinden von 300 <lb n="34" facs="#f0281-l34"/>bis 500 Einwohnern besteht der Gemeinderath aus 6, von 501 bis 1000 Ein<lb n="35" break="no" facs="#f0281-l35"/>wohnern aus 9, von 1001 bis 1500 Einwohnern aus 12, von 1501 bis 2000 <lb n="36" facs="#f0281-l36"/>Einwohnern aus 15, von 2001 bis 3000 Einwohnern aus 18, von 3001 bis <lb n="37" facs="#f0281-l37"/>4000 Einwohnern aus 21, von 4001 bis 8000 Einwohnern aus 24 Mitglie<lb n="38" break="no" facs="#f0281-l38"/>dern und darüber von je 1000 Seelen aus einem Mitgliede mehr; der Ge<lb n="39" break="no" facs="#f0281-l39"/>meindevorstand dagegen besteht in allen Gemeinden bis zu 3000 Einwohnern <lb n="40" facs="#f0281-l40"/>aus einem Bürgermeister und einem Stellvertreter und in Gemeinden über <lb n="41" facs="#f0281-l41"/>3000 Einwohnern aus einem Bürgermeister und vier Stadträthen, dort und <lb n="42" facs="#f0281-l42"/>hier nebst einem Rechnungsführer und nebst Dienerpersonal, doch können in <lb n="43" facs="#f0281-l43"/>Gemeinden von mehr als 1000 Einwohnern dem Gemeindevorstande ein oder <lb n="44" facs="#f0281-l44"/>mehrere Bezirksvorsteher beigegeben werden. Die Glieder des Gemeindevor<lb n="45" break="no" facs="#f0281-l45"/>standes werden von dem Gemeinderathe und, wo keiner besteht, von der Ge<lb n="46" break="no" facs="#f0281-l46"/>meindeversammlung auf sechs, die des Gemeinderaths, deren Hälfte aus Be<lb n="47" break="no" facs="#f0281-l47"/>sitzern geschlossener Güter (in den Städten, sowie in <placeName ref="#place-hohenleuben">Hohenleuben</placeName>, <placeName ref="#place-ebersdorf">Ebersdorf</placeName>, <lb n="48" facs="#f0281-l48"/><placeName ref="#place-langenberg">Langenberg</placeName>, <placeName ref="#place-koestritz">Köstritz</placeName> und <placeName ref="#place-untermhaus">Untermhaus</placeName> aus Hausbesitzern) bestehen muß, von der <lb n="49" facs="#f0281-l49"/>Gemeindeversammlung auf drei Jahre gewählt.
</p>
<pb n="270" facs="#f0282" xml:id="p270"/>
<fw type="header" place="top">IV. Der Staat.</fw>
<p xml:id="p270-b1"><lb n="1" facs="#f0282-l1"/>Für die Landgemeinden sind die Landrathsämter die nächsten Verwaltungs<lb n="2" break="no" facs="#f0282-l2"/>behörden, dagegen stehen die Gemeindevorstände sämmtlicher Städte, welche <lb n="3" facs="#f0282-l3"/>in <placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-lobenstein">Lobenstein</placeName> und <placeName ref="#place-tanna">Tanna</placeName> „Stadtrath“, in <placeName ref="#place-schleiz">Schleiz</placeName>, <placeName ref="#place-hirschberg">Hirschberg</placeName> und <placeName ref="#place-saalburg">Saal<lb n="4" break="no" facs="#f0282-l4"/>burg</placeName> „Stadtgemeindevorstand“ als amtliche Bezeichnung führen, im Allgemeinen <lb n="5" facs="#f0282-l5"/>unmittelbar unter dem <orgName ref="#organisation-staatsministerium">Staatsministerium</orgName>. Indeß in den oberländischen Städten <lb n="6" facs="#f0282-l6"/>und Stadtbezirken haben die Landräthe als beständige Regierungscommissäre <lb n="7" facs="#f0282-l7"/>die Polizeiverwaltung zu überwachen, in dringenden Fällen unmittelbar einzu<lb n="8" break="no" facs="#f0282-l8"/>schreiten und bei dauernden Missständen laut höchster Verordnung vom 14. <lb n="9" facs="#f0282-l9"/>September 1855 Bericht zu erstatten. Zur Ausstellung von Pässen sind in <lb n="10" facs="#f0282-l10"/>den Städten <placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-schleiz">Schleiz</placeName>, <placeName ref="#place-lobenstein">Lobenstein</placeName> und <placeName ref="#place-tanna">Tanna</placeName> die Gemeindevorstände, in <lb n="11" facs="#f0282-l11"/>der Pflege <placeName ref="#place-hirschberg">Hirschberg</placeName> mit Einschluss der Stadt das Justizamt Hirschberg, in <lb n="12" facs="#f0282-l12"/>der Pflege <placeName ref="#place-hohenleuben">Hohenleuben</placeName> das Justizamt Hohenleuben, in allen übrigen Orten <lb n="13" facs="#f0282-l13"/>mit Einschluss der Stadt <placeName ref="#place-saalburg">Saalburg</placeName> das betreffende Landrathsamt ermächtigt.
</p>
<p xml:id="p270-b2"><lb n="14" facs="#f0282-l14"/>d) Die den Grundbesitz betreffende Gesetzgebung. Die Aufsicht <lb n="15" facs="#f0282-l15"/>über Privatwaldungen lag früher ebensogut als die über Kirchen-, Pfarrei- und <lb n="16" facs="#f0282-l16"/>Schulhölzer in den Händen des Staates und war durch Mandate in den ver<lb n="17" break="no" facs="#f0282-l17"/>schiedenen Herrschaftsgebieten festgestellt; weniger durchgreifendes geschah gegen <lb n="18" facs="#f0282-l18"/>die seit dem 30jährigen Kriege überhandgenommene Zerstückelung der geschlossenen <lb n="19" facs="#f0282-l19"/>Güter, noch weniger für die Entlastung des bäuerlichen Bodens. Erst die neuere <lb n="20" facs="#f0282-l20"/>Zeit brachte für den Grundbesitz wohlthätige Gesetze. Von den drei, noch vor dem <lb n="21" facs="#f0282-l21"/>Jahre 1848 erschienenen Specialgesetzen: „über Ablösung der Frohnen, Hutungs<lb n="22" break="no" facs="#f0282-l22"/>befugnisse und Naturalabgaben im Fürstenthume <placeName ref="#place-bezirk-lobenstein-ebersdorf">Lobenstein-Ebersdorf</placeName> vom <lb n="23" facs="#f0282-l23"/>22. März 1836; über Ablösung und Gemeinheitstheilungen im Gebiete <placeName ref="#place-gera">Gera</placeName> <lb n="24" facs="#f0282-l24"/>vom 23. März 1838 und über Triftablösungen und Gemeinheitstheilungen <lb n="25" facs="#f0282-l25"/>im Fürstenthume <placeName ref="#place-schleiz">Schleiz</placeName> vom 27. December 1842“ wurde das Gesetz für <lb n="26" facs="#f0282-l26"/><placeName ref="#place-gera">Gera</placeName> auf die übrigen Landestheile ausgedehnt und den 15. Januar 1858 nebst <lb n="27" facs="#f0282-l27"/>den Erläuterungen und Zusätzen vom 16. Juli und 10. September 1864 zum <lb n="28" facs="#f0282-l28"/>allgemeinen Landesgesetze erhoben. Im Interesse des Grundbesitzes erfolgte <lb n="29" facs="#f0282-l29"/>ferner: Die Einführung eines neuen Grundsteuersystems vom 20. März 1850; <lb n="30" facs="#f0282-l30"/>die Einschätzung des steuerbaren Grundbesitzes vom 8. Januar 1852; das Gesetz <lb n="31" facs="#f0282-l31"/>zum Schutze der <rs type="concept" ref="#concept-holz">Holz</rs>ungen, Baumpflanzungen, <rs type="concept" ref="#concept-wiese">Wiesen</rs>, <rs type="concept" ref="#concept-feld">Felder</rs> und <rs type="concept" ref="#concept-garten">Gärten</rs> <lb n="32" facs="#f0282-l32"/>vom 14. April 1852; die Verordnung über die Verpachtung der zur Dotation <lb n="33" facs="#f0282-l33"/>geistlicher und Schulstellen gewidmeten Grundstücke vom 1. Mai 1860; das <lb n="34" facs="#f0282-l34"/>Gesetz über Zusammenlegung von Grundstücken vom 8. October 1860 und die <lb n="35" facs="#f0282-l35"/>Grund- und Hypothekenordnung vom 20. November 1858.
</p>
<p xml:id="p270-b3"><lb n="36" facs="#f0282-l36"/>e) Die Gewerbe- und Handelsgesetzgebung beruhte bisher auf der <lb n="37" facs="#f0282-l37"/>Gewerbeordnung vom 11. April 1863, der Ministerialverordnung zur Ausübung <lb n="38" facs="#f0282-l38"/>der Gewerbeordnung vom 8. Juni 1863 und auf dem den 23. Februar 1863 <lb n="39" facs="#f0282-l39"/>eingeführten allgemeinen deutschen Handelsgesetzbuche. An deren Stelle ist die <lb n="40" facs="#f0282-l40"/>neueste Bundesgesetzgebung getreten.
</p>
<p xml:id="p270-b4"><lb n="41" facs="#f0282-l41"/>Ueber den Civilstaatsdienst und die Staatsdiener enthält das Gesetz <lb n="42" facs="#f0282-l42"/>vom 16. Juni 1853 nebst der Zusatzordnung vom 5. Juli 1856 die nöthigen <lb n="43" facs="#f0282-l43"/>Grundlagen. Zu ehrender Auszeichnung für treue Dienste ist durch Statut <lb n="44" facs="#f0282-l44"/>vom 20. October 1857 ein Civilehrenkreuz in zwei Klassen (in Gold und Silber) <lb n="45" facs="#f0282-l45"/>gestiftet. Für die Wittwen und Waisen sämmtlicher Staats-, Hof- und Ka<lb n="46" break="no" facs="#f0282-l46"/>mmerbeamten, Geistlichen<note place="foot" n="*)" xml:id="p270-fn1" facs="#f0282-fn1"><lb n="50" facs="#f0282-l50"/>Ausgeschlossen die ordinirten Geistlichen des Landestheils <placeName ref="#place-gera">Gera</placeName>, s. Kirche.</note>, Lehrer und lebenslänglich angestellter Communal<lb n="47" break="no" facs="#f0282-l47"/>beamten besteht seit 1847 eine gemeinschaftliche <orgName ref="#organisation-pensionsanstalt">Pensionsanstalt</orgName>. Das Statut <lb n="48" facs="#f0282-l48"/>derselben datirt vom 28. Januar 1847. Am Schlusse des Jahres 1867 betrug <lb n="49" facs="#f0282-l49"/>das Vermögen der Anstalt 41,291 Thaler 1⅚ Silbergroschen und die jähr-
<pb n="271" facs="#f0283" xml:id="p271"/>
<fw type="header" place="top">2. Militär.</fw>
<lb n="1" facs="#f0283-l1"/>liche Pensionslast 10,922 Thaler. Für die Finanzperiode 1869 bis 1871 wird <lb n="2" facs="#f0283-l2"/>außer den Beiträgen der Mitglieder ein jährlicher Zuschuss von 5873 Thaler <lb n="3" facs="#f0283-l3"/>aus Staats- und Kammermitteln nöthig. Für die Subalternbeamten des <lb n="4" facs="#f0283-l4"/>Staats (auf Widerruf angestellte Copisten, ferner Gensd'armen, Steueraufseher, <lb n="5" facs="#f0283-l5"/>Diener der Staatsbehörden) ist durch Ministerialverfügung vom 12. April 1866 <lb n="6" facs="#f0283-l6"/>gleichfalls eine Wittwen- und Waisenpensionsanstalt errichtet. Für die Hof<lb n="7" break="no" facs="#f0283-l7"/>dienerschaft besteht schon seit längerer Zeit eine besondere Wittwenkasse.
</p>
</div>
