="42" ulx="79" uly="1995" lrx="1423" lry="2039"/><zone xml:id="f0197-l43" type="line" n="43" ulx="81" uly="2040" lrx="1422" lry="2083"/><zone xml:id="f0197-l44" type="line" n="44" ulx="81" uly="2081" lrx="1422" lry="2125"/><zone xml:id="f0197-l45" type="line" n="45" ulx="82" uly="2123" lrx="1422" lry="2167"/><zone xml:id="f0197-l46" type="line" n="46" ulx="81" uly="2167" lrx="1423" lry="2211"/><zone xml:id="f0197-l47" type="line" n="47" ulx="82" uly="2211" lrx="1420" lry="2251"/><zone xml:id="f0197-l48" type="line" n="48" ulx="82" uly="2256" lrx="1425" lry="2296"/><zone xml:id="f0197-l49" type="line" n="49" ulx="84" uly="2296" lrx="1420" lry="2337"/><zone xml:id="f0197-l50" type="line" n="50" ulx="84" uly="2335" lrx="1422" lry="2379"/><zone xml:id="f0197-l51" type="line" n="51" ulx="84" uly="2382" lrx="1422" lry="2422"/></surface></facsimile>
<text><body><div type="page" n="185"><pb n="185" facs="#f0197"/>
<fw type="header" place="top">7. Sitte und Brauch.</fw>
<p xml:id="p185-b1"><lb n="1" facs="#f0197-l1"/>einen großen Reichthum von Nachklängen an das Culturleben der altheidnischen <lb n="2" facs="#f0197-l2"/>und der mittelalterlichen Zeit. Der Unverstand schleudert gern diese Nachklänge <lb n="3" facs="#f0197-l3"/>in das Kapitel des Aberglaubens, statt in ihnen die Bautrümmer der Cult- und <lb n="4" facs="#f0197-l4"/>Culturgeschichte früherer Perioden zu finden. Am Stärksten treten uns dieselben <lb n="5" facs="#f0197-l5"/>bei den Wahr- und kirchlichen Festtagen und mit diesen bei den Hauptacten <lb n="6" facs="#f0197-l6"/>der ländlichen Arbeit in Haus und Feld entgegen. Wir gedenken nun zuerst <lb n="7" facs="#f0197-l7"/>der vorzüglichsten Gebräuche bei den Arbeiten im Hause und Felde und dann <lb n="8" facs="#f0197-l8"/>des Volkskalenders in seiner Beziehung zur Arbeit und Festzeit.</p>
<p xml:id="p185-b2"><lb n="9" facs="#f0197-l9"/>Im bäuerlichen Hause des <placeName ref="#place-voigtland">Voigtlandes</placeName> treten neben der Koch- und Wasch<lb n="10" break="no" facs="#f0197-l10"/>kunst <rs type="concept" ref="#concept-brod">Brod</rs>backen, Buttern und Spinnen in den Vordergrund, Kehren und <lb n="11" facs="#f0197-l11"/>Scheuern in den Hintergrund. Beim <rs type="concept" ref="#concept-brod">Brod</rs>backen macht man über den <lb n="12" facs="#f0197-l12"/>Teig drei Kreuze und bis das Brod gebacken ist, bleibt der <rs type="concept" ref="#concept-brodtrog">Brodtrog</rs> in der <lb n="13" facs="#f0197-l13"/>Stube und diese umgekehrt. Auch macht man über jedes <rs type="concept" ref="#concept-brod">Brod</rs> beim Anschneiden <lb n="14" facs="#f0197-l14"/>drei Kreuze. Beim Buttern legt man an das <rs type="concept" ref="#concept-butterfass">Butterfaß</rs> ein <rs type="concept" ref="#concept-messer">Messer</rs> mit <lb n="15" facs="#f0197-l15"/>einem Kreuzzeichen und unter dasselbe einen <rs type="concept" ref="#concept-kamm">Kamm</rs> oder <rs type="concept" ref="#concept-feuerstahl">Feuerstahl</rs>. Ein an<lb n="16" break="no" facs="#f0197-l16"/>gelegter <rs type="concept" ref="#concept-rocken">Rocken</rs> muß sofort angesponnen und jeder <rs type="concept" ref="#concept-rocken">Rocken</rs> vor Beginn der zwölf <lb n="17" facs="#f0197-l17"/>Nächte abgesponnen werden, weil sonst die wilde Berchtha oder Werre die <lb n="18" facs="#f0197-l18"/>Faulen züchtigt.</p>
<p xml:id="p185-b3"><lb n="19" facs="#f0197-l19"/>Im Stalle ist die Macht der symbolischen Handlungen nicht minder nöthig, <lb n="20" facs="#f0197-l20"/>als in der Wohnstube, denn Geburt und Tod eines Stück <name type="organism" ref="#organism-vieh">Viehes</name> ist ein Familien<lb n="21" break="no" facs="#f0197-l21"/>ereigniß, wie das Leben und Sterben eines Kindes. Eben deshalb wird beim <lb n="22" facs="#f0197-l22"/><name type="organism" ref="#organism-vieh">Viehe</name> wie beim Menschen zu jedem Lobe, das man über dasselbe ausspricht, „Gott <lb n="23" facs="#f0197-l23"/>behüts“ oder „unbeschrieen“ hinzugefügt und gegen alle ihm angethanen Uebel <lb n="24" facs="#f0197-l24"/>ein und das andere Mittel und, wenn dies nicht wirkt, die kluge Frau zu Hilfe <lb n="25" facs="#f0197-l25"/>genommen. Am Christabende erhält das Vieh „Leckig“ (ein Gemeng aus <rs type="concept" ref="#concept-salz">Salz</rs> <lb n="26" facs="#f0197-l26"/>und <name type="organism" ref="#organism-getreide">Körnern</name>) und am Neujahre und am Abende der h. drei Könige Härings<lb n="27" break="no" facs="#f0197-l27"/>milch oder drei Häringsköpfe. Gegen Verhexung schützt man Stall und Vieh <lb n="28" facs="#f0197-l28"/>durch drei Kreuze in der Walpurgisnacht, durch Räuchern mit <name type="organism" ref="#organism-wacholder">Wachholdern</name> <lb n="29" facs="#f0197-l29"/>am Pfingstfeste und mit Teufelsdreck an jedem Montag und Freitag, durch <lb n="30" facs="#f0197-l30"/>Aufhängen einer <name type="organism" ref="#organism-allermannsharnisch">Allermannsharnischwurzel</name>, durch ein aus einem Baume bei <lb n="31" facs="#f0197-l31"/><placeName ref="#place-kayla">Kaila</placeName> geschnitztes, in das <rs type="concept" ref="#concept-melkgefaess">Melkgefäß</rs> gebohrtes <rs type="concept" ref="#concept-pfloeckchen">Pflöckchen</rs> oder dadurch, daß man <lb n="32" facs="#f0197-l32"/>eine im Hofe oder Keller getroffene <name type="organism" ref="#organism-kroete">Kröte</name> an eine <rs type="concept" ref="#concept-mistgabel">Mistgabel</rs> spießt. Die Milch <lb n="33" facs="#f0197-l33"/>einer kranken <name type="organism" ref="#organism-kuh">Kuh</name> kommt in eine <rs type="concept" ref="#concept-hecke">Dornhecke</rs> und blutige Milch in’s Feuer, <lb n="34" facs="#f0197-l34"/>denn dort und hier ist die <name type="organism" ref="#organism-kuh">Kuh</name> verhext; dies auch, wenn sie beim Melken gießt, <lb n="35" facs="#f0197-l35"/>in welchem Falle man sie dreimal in die Milchgrube schlägt. Sind die <name type="organism" ref="#organism-kuh">Kühe</name> <lb n="36" facs="#f0197-l36"/>verhext, so melken sich die Hexen am Milch- oder <rs type="concept" ref="#concept-handtuch">Handtuche</rs> die halbe Milch. Eine <lb n="37" facs="#f0197-l37"/>dem <name type="organism" ref="#organism-stier">Reitstiere</name> zugeführte <name type="organism" ref="#organism-kuh">Kuh</name> darf auf dem Rückwege nicht saufen und muß <lb n="38" facs="#f0197-l38"/>Klebrig bekommen. Der zum Zuführen gebrauchte <rs type="concept" ref="#concept-strick">Strick</rs> und <rs type="concept" ref="#concept-stock">Stock</rs> (letzterer <lb n="39" facs="#f0197-l39"/>muß gerade sein) kommen eine Zeitlang in den <rs type="concept" ref="#concept-backofen">Backofen</rs>, dagegen bindet man <lb n="40" facs="#f0197-l40"/>den <rs type="concept" ref="#concept-strick">Strick</rs>, mit dem eingekauftes <name type="organism" ref="#organism-vieh">Vieh</name> in den Stall gebracht ist, einen Monat <lb n="41" facs="#f0197-l41"/>hindurch um das <rs type="concept" ref="#concept-tischbein">Tischbein</rs>. Kalbt eine <name type="organism" ref="#organism-kuh">Kuh</name>, erhält sie drei von Weihnachten <lb n="42" facs="#f0197-l42"/>oder Neujahr aufbewahrte Häringsköpfe, fünf Zweige von <name type="organism" ref="#organism-wintergruen">Wintergrün</name>, drei <lb n="43" facs="#f0197-l43"/><rs type="concept" ref="#concept-butterfladen">Butterfladen</rs> mit <rs type="concept" ref="#concept-salz">Salz</rs>, <name type="organism" ref="#organism-kuemmel">Kümmel</name>, Ofenruß und anderen Dingen. Am Tage <lb n="44" facs="#f0197-l44"/>des Kalbens (hie und da die drei ersten Tage nach dem Kalben) darf nichts <lb n="45" facs="#f0197-l45"/>aus dem Hause verborgt werden. Verkrüppelt geborenes <name type="organism" ref="#organism-vieh">Vieh</name> hat sein Grab <lb n="46" facs="#f0197-l46"/>unter der Stallthüre. Dahin kommt auch zum Gedeihen des <name type="organism" ref="#organism-vieh">Kleinviehes</name> ein <lb n="47" facs="#f0197-l47"/>weißer <rs type="concept" ref="#concept-kieselstein">Kieselstein</rs>, schwerer als ein Stück <name type="organism" ref="#organism-vieh">Vieh</name> im Stalle. Beim ersten Aus<lb n="48" break="no" facs="#f0197-l48"/>triebe des <name type="organism" ref="#organism-vieh">Viehes</name> im Frühjahre geschieht das Melken mit einem Kranze von <lb n="49" facs="#f0197-l49"/><name type="organism" ref="#organism-gundermann">Gundermann</name>, kommt ein <rs type="concept" ref="#concept-beil">Beil</rs>, <rs type="concept" ref="#concept-pfahleisen">Pfahleisen</rs>, <rs type="concept" ref="#concept-rechen">Rechen</rs> oder <rs type="concept" ref="#concept-besen">Besen</rs> über, ein <rs type="concept" ref="#concept-feuerstahl">Feuers<lb n="50" break="no" facs="#f0197-l50"/>tahl</rs> unter die Stallthürschwelle, erhält der beschuhte Hirt zum Essen gekochte <lb n="51" facs="#f0197-l51"/>Eier, deren Schalen er zur Verhütung des Bieselns in die Fährten des <name type="organism" ref="#organism-vieh">Viehes</name></p>
</div></body></text>
