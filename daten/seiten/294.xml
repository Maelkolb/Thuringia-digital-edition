7" ulx="169" uly="2208" lrx="1524" lry="2251"/><zone xml:id="f0306-l38" type="line" n="38" ulx="170" uly="2251" lrx="1524" lry="2294"/><zone xml:id="f0306-l39" type="line" n="39" ulx="170" uly="2297" lrx="1519" lry="2336"/><zone xml:id="f0306-l40" type="line" n="40" ulx="170" uly="2336" lrx="1524" lry="2379"/><zone xml:id="f0306-l41" type="line" n="41" ulx="173" uly="2377" lrx="1519" lry="2420"/></surface></facsimile>
<text><body><div type="page" n="294"><pb n="294" facs="#f0306"/>
<fw type="header" place="top">IV. Der Staat.</fw>
<p xml:id="p294-b1"><lb n="1" facs="#f0306-l1"/>Abgaben, durch Verlust an Grund und Boden, durch Ablösung der Gefälle und <lb n="2" facs="#f0306-l2"/>Frohnden und durch Fixirung mit Geld geringer geworden. Gegenwärtig haben <lb n="3" facs="#f0306-l3"/>an Einkünften:</p>
<table xml:id="p294-b2" facs="#f0306-b2" rows="7" cols="6"><row role="label"><cell role="label">Zahl der Pfarreien:</cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label">mit einem Gehalte von</cell><cell role="label"></cell></row><row><cell>8 Pfarreien, darunter</cell><cell>2</cell><cell>Diaconen</cell><cell></cell><cell>400 bis 500 Thlr.,</cell><cell></cell></row><row><cell>12</cell><cell>"</cell><cell>2</cell><cell>"</cell><cell></cell><cell>500 " 600 "</cell></row><row><cell>11</cell><cell>"</cell><cell>3</cell><cell>"</cell><cell></cell><cell>600 " 700 "</cell></row><row><cell>6</cell><cell>"</cell><cell>1</cell><cell>"</cell><cell></cell><cell>700 " 800 "</cell></row><row><cell>12</cell><cell>"</cell><cell>2</cell><cell>"</cell><cell>und 1 Ephorus</cell><cell>800 " 1000 "</cell></row><row><cell>10</cell><cell>"</cell><cell>2</cell><cell>Ephoren</cell><cell></cell><cell>über 1000 "</cell></row></table>
<p xml:id="p294-b3"><lb n="13" facs="#f0306-l13"/>Ferner sind bezüglich der Kirchen</p>
<table xml:id="p294-b4" facs="#f0306-b4" rows="9" cols="2"><row><cell>im Landestheile</cell><cell>die reichsten</cell></row><row><cell><placeName ref="#place-gera">Gera</placeName></cell><cell><placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-koestritz">Köstritz</placeName>, <placeName ref="#place-roben">Roben</placeName>, <placeName ref="#place-pohlitz">Pohlitz</placeName>, <placeName ref="#place-hartmannsdorf">Hartmannsdorf</placeName>;</cell></row><row><cell><placeName ref="#place-schleiz">Schleiz</placeName></cell><cell><placeName ref="#place-pahren">Pahren</placeName> (die reichste), dann <placeName ref="#place-kulm">Kulm</placeName>, <placeName ref="#place-goeschitz">Göschitz</placeName>, <placeName ref="#place-stelzen">Stelzen</placeName>, <placeName ref="#place-unterkoskau">Unterkoskau</placeName>;</cell></row><row><cell>Lobenstein-<placeName ref="#place-ebersdorf">Ebersdorf</placeName></cell><cell>Ebersdorf, <placeName ref="#place-altengesees">Altengesees</placeName>, <placeName ref="#place-lothra">Lothra</placeName>;</cell></row><row><cell></cell><cell></cell></row><row><cell></cell><cell>die ärmsten</cell></row><row><cell><placeName ref="#place-gera">Gera</placeName></cell><cell><placeName ref="#place-naundorf">Naundorf</placeName>, <placeName ref="#place-grossaga">Großaga</placeName>, <placeName ref="#place-weissig">Weißig</placeName>, <placeName ref="#place-wernsdorf">Wernsdorf</placeName>, <placeName ref="#place-muehlsdorf">Mühlsdorf</placeName>, <placeName ref="#place-tinz">Tinz</placeName>;</cell></row><row><cell><placeName ref="#place-schleiz">Schleiz</placeName></cell><cell><placeName ref="#place-seubtendorf">Seubtendorf</placeName>, <placeName ref="#place-dittersdorf">Dettersdorf</placeName>, <placeName ref="#place-langenwolschendorf">Langenwolschendorf</placeName>;</cell></row><row><cell><placeName ref="#place-lobenstein">Lobenstein</placeName>-Ebersdorf</cell><cell>Lobenstein, <placeName ref="#place-hirschberg">Hirschberg</placeName>, <placeName ref="#place-harra">Harra</placeName>, <placeName ref="#place-heinersdorf">Heinersdorf</placeName>, <placeName ref="#place-ossla">Oßla</placeName>, <placeName ref="#place-wurzbach">Wurzbach</placeName>.</cell></row></table>
<p xml:id="p294-b5">Das Fürstenthum hat drei Superintendanturen oder Ephorien, nämlich <placeName ref="#place-gera">Gera</placeName>,<lb n="23" facs="#f0306-l23"/> <lb n="26" facs="#f0306-l26"/><placeName ref="#place-schleiz">Schleiz</placeName> und <placeName ref="#place-lobenstein">Lobenstein</placeName> und in denselben</p>
<table xml:id="p294-b6" facs="#f0306-b6" rows="5" cols="5"><row role="label"><cell role="label">Ephorien.</cell><cell role="label">Parochien.</cell><cell role="label">Kirchen.</cell><cell role="label">Geistliche.</cell><cell role="label">Katecheten.</cell></row><row><cell><placeName ref="#place-gera">Gera</placeName> . . .</cell><cell>14</cell><cell>44</cell><cell>25</cell><cell>2</cell></row><row><cell><placeName ref="#place-schleiz">Schleiz</placeName> . . .</cell><cell>20</cell><cell>36</cell><cell>27</cell><cell>—</cell></row><row><cell><placeName ref="#place-lobenstein">Lobenstein</placeName> .</cell><cell>11</cell><cell>22</cell><cell>16</cell><cell>—</cell></row><row><cell>Summe</cell><cell>45</cell><cell>102</cell><cell>68</cell><cell>2</cell></row></table>
<p xml:id="p294-b7"><lb n="28" facs="#f0306-l28"/>Es kommen mithin auf eine Parochie 1955, auf eine Kirche 862,4 und <lb n="29" facs="#f0306-l29"/>auf einen Geistlichen 1293,8 Seelen.</p>
<p xml:id="p294-b8"><lb n="30" facs="#f0306-l30"/>Zur katholischen Zeit hatte das Land eine größere Zahl von Kultgebäuden als gegenwärtig, denn nicht <lb n="31" facs="#f0306-l31"/>allein besaßen die vier Städte <placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-schleiz">Schleiz</placeName>, <placeName ref="#place-saalburg">Saal<lb n="32" break="no" facs="#f0306-l32"/>burg</placeName> und <placeName ref="#place-lobenstein">Lobenstein</placeName> 16 Kirchen und Kapellen, sondern auch manche Landorte <lb n="33" facs="#f0306-l33"/>waren mit Kapellen versehen, die heute nicht mehr vorhanden sind, wie <placeName ref="#place-pottendorf">Pottendorf</placeName>, <lb n="34" facs="#f0306-l34"/><placeName ref="#place-weissendorf">Weißendorf</placeName>, <placeName ref="#place-poeritzsch">Pöritsch</placeName>, <placeName ref="#place-arlas">Arlas</placeName>, die Kapelle im <name type="nature" ref="#nature-schleizer-wald">schleizer Walde</name>, die Höhenkapellen <lb n="35" facs="#f0306-l35"/>bei <placeName ref="#place-schilbach">Schilbach</placeName>, <placeName ref="#place-stelzen">Stelzen</placeName> und auf dem <name type="nature" ref="#nature-frankenwald">Frankenwald</name>. Die nach den katholischen Tagen <lb n="36" facs="#f0306-l36"/>neu entstandenen Kirchen haben die Zahl der eingegangenen Kapellen nicht ersetzt. <lb n="37" facs="#f0306-l37"/>Wenn auch die Kapellen meist klein und im Jahre größtentheils nur mit einigen <lb n="38" facs="#f0306-l38"/>Messen bedacht waren, so besaßen doch die katholischen Kirchen in der Regel <lb n="39" facs="#f0306-l39"/>mehrere <rs type="concept" ref="#concept-altar">Altäre</rs>, dazu außer ihren Hauptheiligen noch mehr oder minder <rs type="concept" ref="#concept-kultfigur">Kult<lb n="40" break="no" facs="#f0306-l40"/>figuren</rs>, <rs type="concept" ref="#concept-reliquie">Reliquien</rs>, gefeierte <rs type="concept" ref="#concept-geraethschaft">Geräthschaften</rs> und andern die Sinne bestechenden <lb n="41" facs="#f0306-l41"/>Schmuck. Im ganzen Fürstenthume gab es übrigens nur ein einziges <rs type="concept" ref="#concept-kloster">Kloster</rs>,</p>
</div></body></text>
