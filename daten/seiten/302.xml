-l39" type="line" n="39" ulx="171" uly="1836" lrx="1527" lry="1879"/><zone xml:id="f0314-l40" type="line" n="40" ulx="175" uly="1878" lrx="1522" lry="1921"/><zone xml:id="f0314-l41" type="line" n="41" ulx="171" uly="1920" lrx="1525" lry="1963"/><zone xml:id="f0314-l42" type="line" n="42" ulx="172" uly="1967" lrx="1527" lry="2007"/><zone xml:id="f0314-l43" type="line" n="43" ulx="174" uly="2007" lrx="1522" lry="2050"/><zone xml:id="f0314-l44" type="line" n="44" ulx="174" uly="2049" lrx="1524" lry="2092"/><zone xml:id="f0314-l45" type="line" n="45" ulx="171" uly="2093" lrx="1525" lry="2135"/><zone xml:id="f0314-l46" type="line" n="46" ulx="171" uly="2134" lrx="1524" lry="2177"/><zone xml:id="f0314-l47" type="line" n="47" ulx="171" uly="2180" lrx="1524" lry="2220"/><zone xml:id="f0314-l48" type="line" n="48" ulx="172" uly="2218" lrx="1524" lry="2261"/><zone xml:id="f0314-l49" type="line" n="49" ulx="171" uly="2261" lrx="1258" lry="2304"/><zone xml:id="f0314-l50" type="line" n="50" ulx="256" uly="2306" lrx="1528" lry="2349"/><zone xml:id="f0314-l51" type="line" n="51" ulx="171" uly="2346" lrx="1522" lry="2389"/></surface></facsimile>
<text><body><div type="page" n="302"><pb n="302" facs="#f0314"/>
<fw type="header" place="top">IV. Der Staat.</fw>
<p xml:id="p302-b1"><lb n="1" facs="#f0314-l1"/>gegangen sind und unterhalten werden, von den Eltern der Kinder aber blos <lb n="2" facs="#f0314-l2"/>einen geringfügigen Beitrag zu den Erhaltungskosten fordern. Im Beginn des <lb n="3" facs="#f0314-l3"/>Novembers 1869 ist von dem regierenden Fürstenhause eine solche Anstalt zu <lb n="4" facs="#f0314-l4"/><placeName ref="#place-untermhaus">Untermhaus</placeName> errichtet und mit einer Lehranstalt für weibliche Dienstboten unter <lb n="5" facs="#f0314-l5"/>dem Namen <orgName ref="#organisation-agnesschule-untermhaus">Agnesschule</orgName> verbunden worden.</p>
<p xml:id="p302-b2"><lb n="6" facs="#f0314-l6"/>In Betreff des Bettelwesens und der Vagabunden bestehen (abgesehen von <lb n="7" facs="#f0314-l7"/>früheren Verordnungen) Ministerialverordnung vom 26. März 1853, Verord<lb n="8" break="no" facs="#f0314-l8"/>nung vom 27. Juni 1853 und vom 28. Juni 1857. Die grundbesitzlose Klasse <lb n="9" facs="#f0314-l9"/>ist zwar im Lande stark vertreten, indess das Bettelwesen, das vordem reichlich <lb n="10" facs="#f0314-l10"/>geblüht hat, keinen Boden und Halt weder im Regiment des Staates, noch <lb n="11" facs="#f0314-l11"/>in dem Gemeindewesen. Es herrscht ein zu reger Sinn im Ganzen und im <lb n="12" facs="#f0314-l12"/>Einzelnen, als dass die Lüderlichkeit hinter <rs type="concept" ref="#concept-zaun">Zäunen</rs> und <name type="organism" ref="#organism-staude">Stauden</name> aufwachsen <lb n="13" facs="#f0314-l13"/>könnte. Der Pauperismus kann, wenn auch da und dort ein dichtbevölkerter <lb n="14" facs="#f0314-l14"/>Ort oder ein einzelner Gewerbsstand durch allgemeine und locale Calamitäten <lb n="15" facs="#f0314-l15"/>ein Contingent dafür liefert, doch nicht krebsartig um sich greifen, weil ihm <lb n="16" facs="#f0314-l16"/>hier im Ganzen die Wurzeln fehlen, durch die er emporgetrieben und genährt <lb n="17" facs="#f0314-l17"/>wird. Dass man die Güterzerstückelung bis in's Kleinste fern hält, die Oeconomie <lb n="18" facs="#f0314-l18"/>möglichst mit Verstand und Fleiss treibt, ihren mangelnden Ertrag durch In<lb n="19" break="no" facs="#f0314-l19"/>dustrie ergänzt, Trägheit und Uncultur durch die Schulen, Nährquellen durch <lb n="20" facs="#f0314-l20"/>Herbeiziehung von neuen Verkehrsmitteln (<rs type="concept" ref="#concept-eisenbahn">Eisenbahnen</rs>) zu verschaffen sucht <lb n="21" facs="#f0314-l21"/>und durch reichliche Unterstützung der Bemittelten dem Elende zu Hilfe kommt, <lb n="22" facs="#f0314-l22"/>nimmt dem Pauperismus die nachhaltige Triebkraft. Die früheren Ver<lb n="23" break="no" facs="#f0314-l23"/>hungerungsperioden des Proletariats sind jetzt kaum möglich.</p>
<p xml:id="p302-b3"><lb n="24" facs="#f0314-l24"/>Das gegenseitige Unterstützungswesen der arbeitenden Volksklasse <lb n="25" facs="#f0314-l25"/>hat in jüngster Zeit durch den Associationstrieb der Selbsthilfe bedeutende Fort<lb n="26" break="no" facs="#f0314-l26"/>schritte gemacht, doch mehr im <placeName ref="#place-bezirk-gera">geraer</placeName> und <placeName ref="#place-reichenfels">reichenfelser</placeName> Gebiete, als in den <lb n="27" facs="#f0314-l27"/>übrigen Districten des Landes. Auch haben die auf gegenseitiger Versicherung <lb n="28" facs="#f0314-l28"/>beruhenden Krankenhilfsvereine mit oder ohne Begräbnisskassen eine ersprie<lb n="29" break="no" facs="#f0314-l29"/>sliche Wirksamkeit als die älteren Leichencommunen mit festen Beiträgen und <lb n="30" facs="#f0314-l30"/>sog. Freisteuerung, die sich zum Theil in misslicher Vermögenslage befinden.</p>
<p xml:id="p302-b4"><lb n="31" facs="#f0314-l31"/>Leichencommunen und Begräbnisskassen bestehen zwei in <placeName ref="#place-schleiz">Schleiz</placeName> (<lb n="32" facs="#f0314-l32"/>seit 1777 und 1782), zwei in <placeName ref="#place-hirschberg">Hirschberg</placeName> (1804 und 1806), eine in <placeName ref="#place-wurzbach">Wurzbach</placeName> (<lb n="33" facs="#f0314-l33"/>1853), <placeName ref="#place-harra">Harra</placeName> (1859) und <placeName ref="#place-tanna">Tanna</placeName> (1864), ein Sterbefiscus der Beutler-, <lb n="34" facs="#f0314-l34"/>Drechsler-, Kürschner-, Nadler-, Riemer- und Sattlerinnungen in <placeName ref="#place-gera">Gera</placeName> (1860) <lb n="35" facs="#f0314-l35"/>und ein gleicher der Zeugmacherinnung daselbst seit 1867.</p>
<p xml:id="p302-b5"><lb n="36" facs="#f0314-l36"/>Begräbnisskassen in Verbindung mit Krankenunterstützungs<lb n="37" break="no" facs="#f0314-l37"/>kassen sind: 1) die der Hand- und Fabrikarbeiter in <placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-untermhaus">Untermhaus</placeName>, <placeName ref="#place-cuba">Cuba</placeName>, <lb n="38" facs="#f0314-l38"/><placeName ref="#place-debschwitz">Debschwitz</placeName>, <placeName ref="#place-pforten">Pforten</placeName>, <placeName ref="#place-bieblach">Bieblach</placeName> und <placeName ref="#place-poeppeln">Pöppeln</placeName> (seit 1849); 2) der Krankenhilfs<lb n="39" break="no" facs="#f0314-l39"/>verein der in <placeName ref="#place-gera">Gera</placeName> Heimathsberechtigten (1852) nebst damit verbundenem <lb n="40" facs="#f0314-l40"/>Sterbefiscus (1864); 3) die der Gewerbsgehilfen in <placeName ref="#place-triebes">Triebes</placeName>, <placeName ref="#place-niederboehmsdorf">Niederböhmsdorf</placeName> <lb n="41" facs="#f0314-l41"/>und <placeName ref="#place-weissendorf">Weissendorf</placeName>, seit 1858 zunächst blos für Webergesellen, seit 1866 auch auf <lb n="42" facs="#f0314-l42"/>andere Gewerbsgehilfen ausgedehnt; 4) die Begräbnisskasse der Einwohner in <lb n="43" facs="#f0314-l43"/><placeName ref="#place-langenberg">Langenberg</placeName>, seit 1861 mit einer Krankenunterstützungskasse; 5) die der Ein<lb n="44" break="no" facs="#f0314-l44"/>wohner in <placeName ref="#place-roschitz">Roschitz</placeName> (1863); 6) Frauensterbefiscus in <placeName ref="#place-gera">Gera</placeName> (1865) nebst Frauen<lb n="45" break="no" facs="#f0314-l45"/>krankenhilfsverein (1868); 7) die der Einwohner in <placeName ref="#place-frankenthal">Frankenthal</placeName> (1865); 8) der <lb n="46" facs="#f0314-l46"/>arbeitenden Klassen in <placeName ref="#place-naundorf">Naundorf</placeName> und Umgegend (1866); 9) der Hand- und <lb n="47" facs="#f0314-l47"/>Fabrikarbeiter in <placeName ref="#place-leumnitz">Leumnitz</placeName>, <placeName ref="#place-laasen">Laasen</placeName>, <placeName ref="#place-trebnitz">Trebnitz</placeName>, <placeName ref="#place-zwoetzen">Zwötzen</placeName>, <placeName ref="#place-zschippern">Zschippern</placeName> und <placeName ref="#place-kaimberg">Kaimberg</placeName> (<lb n="48" facs="#f0314-l48"/>1866); 10) der Gesellen und Arbeitsgehilfen in <placeName ref="#place-hohenleuben">Hohenleuben</placeName> (1867); 11) der <lb n="49" facs="#f0314-l49"/>Einwohner in <placeName ref="#place-duerrenebersdorf">Dürrenebersdorf</placeName>, <placeName ref="#place-weissig">Weissig</placeName> und <placeName ref="#place-zeulsdorf">Zeulsdorf</placeName> (1869).</p>
<p xml:id="p302-b6"><lb n="50" facs="#f0314-l50"/>Blosse Krankenunterstützungsvereine: 1) der Maurer, Steinmetzen <lb n="51" facs="#f0314-l51"/>und Zimmerleute in <placeName ref="#place-gruena">Grüna</placeName>, <placeName ref="#place-stuebnitz">Stübnitz</placeName>, <placeName ref="#place-ruedersdorf">Rüdersdorf</placeName> und <placeName ref="#place-hartmannsdorf">Hartmannsdorf</placeName> (1864);</p>
</div></body></text>
