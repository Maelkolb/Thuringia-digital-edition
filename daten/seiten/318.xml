 type="line" n="18" ulx="152" uly="952" lrx="1502" lry="995"/><zone xml:id="f0330-l19" type="line" n="19" ulx="152" uly="996" lrx="1502" lry="1037"/><zone xml:id="f0330-l20" type="line" n="20" ulx="154" uly="1037" lrx="1504" lry="1080"/><zone xml:id="f0330-l21" type="line" n="21" ulx="152" uly="1079" lrx="1505" lry="1122"/><zone xml:id="f0330-l22" type="line" n="22" ulx="158" uly="1122" lrx="1505" lry="1165"/><zone xml:id="f0330-l23" type="line" n="23" ulx="157" uly="1165" lrx="1505" lry="1208"/><zone xml:id="f0330-l24" type="line" n="24" ulx="157" uly="1206" lrx="1505" lry="1249"/><zone xml:id="f0330-l25" type="line" n="25" ulx="157" uly="1251" lrx="1507" lry="1294"/><zone xml:id="f0330-l26" type="line" n="26" ulx="157" uly="1293" lrx="1507" lry="1336"/><zone xml:id="f0330-l27" type="line" n="27" ulx="157" uly="1336" lrx="1507" lry="1379"/><zone xml:id="f0330-l28" type="line" n="28" ulx="157" uly="1377" lrx="1505" lry="1420"/><zone xml:id="f0330-l29" type="line" n="29" ulx="158" uly="1421" lrx="1508" lry="1464"/><zone xml:id="f0330-l30" type="line" n="30" ulx="160" uly="1468" lrx="1510" lry="1506"/><zone xml:id="f0330-l31" type="line" n="31" ulx="160" uly="1505" lrx="1510" lry="1548"/><zone xml:id="f0330-l32" type="line" n="32" ulx="161" uly="1550" lrx="1510" lry="1592"/><zone xml:id="f0330-l33" type="line" n="33" ulx="160" uly="1590" lrx="1508" lry="1633"/><zone xml:id="f0330-l34" type="line" n="34" ulx="161" uly="1632" lrx="1511" lry="1675"/><zone xml:id="f0330-l35" type="line" n="35" ulx="164" uly="1676" lrx="1513" lry="1719"/><zone xml:id="f0330-l36" type="line" n="36" ulx="161" uly="1720" lrx="1511" lry="1762"/><zone xml:id="f0330-l37" type="line" n="37" ulx="164" uly="1761" lrx="1510" lry="1804"/><zone xml:id="f0330-l38" type="line" n="38" ulx="167" uly="1805" lrx="1130" lry="1848"/><zone xml:id="f0330-l39" type="line" n="39" ulx="233" uly="1887" lrx="931" lry="1930"/><zone xml:id="f0330-l40" type="line" n="40" ulx="221" uly="1929" lrx="1462" lry="1972"/></su