 xml:id="f0723-l34" type="line" n="34" ulx="59" uly="1691" lrx="1413" lry="1735"/><zone xml:id="f0723-l35" type="line" n="35" ulx="59" uly="1734" lrx="1414" lry="1778"/><zone xml:id="f0723-l36" type="line" n="36" ulx="59" uly="1777" lrx="1154" lry="1821"/><zone xml:id="f0723-l37" type="line" n="37" ulx="151" uly="1820" lrx="1414" lry="1864"/><zone xml:id="f0723-l38" type="line" n="38" ulx="59" uly="1862" lrx="1413" lry="1905"/><zone xml:id="f0723-l39" type="line" n="39" ulx="59" uly="1903" lrx="1416" lry="1946"/><zone xml:id="f0723-l40" type="line" n="40" ulx="62" uly="1952" lrx="1416" lry="1990"/><zone xml:id="f0723-l41" type="line" n="41" ulx="61" uly="1992" lrx="1416" lry="2034"/><zone xml:id="f0723-l42" type="line" n="42" ulx="145" uly="2067" lrx="1416" lry="2111"/><zone xml:id="f0723-l43" type="line" n="43" ulx="64" uly="2106" lrx="1417" lry="2146"/><zone xml:id="f0723-l44" type="line" n="44" ulx="65" uly="2139" lrx="342" lry="2181"/><zone xml:id="f0723-l45" type="line" n="45" ulx="118" uly="2176" lrx="402" lry="2220"/><zone xml:id="f0723-l46" type="line" n="46" ulx="104" uly="2222" lrx="1417" lry="2266"/><zone xml:id="f0723-l47" type="line" n="47" ulx="64" uly="2260" lrx="1178" lry="2301"/><zone xml:id="f0723-l48" type="line" n="48" ulx="137" uly="2299" lrx="1416" lry="2342"/><zone xml:id="f0723-l49" type="line" n="49" ulx="64" uly="2336" lrx="1414" lry="2377"/><zone xml:id="f0723-l50" type="line" n="50" ulx="68" uly="2377" lrx="573" lry="2413"/></surface></facsimile>
<text><body><div type="page" n="711"><pb n="711" facs="#f0723"/>
<fw type="header" place="top">III. Der Landestheil Lobenstein = Ebersdorf.</fw>
<p xml:id="p711-b1"><lb n="1" facs="#f0723-l1"/>Vizthum die Pfandsumme von 60,000 Gülden auszahlte, wozu von Seiten <lb n="2" facs="#f0723-l2"/>des Kaisers zur Sühne für die von ihm verletzten Gerechtsame der Herrn <lb n="3" facs="#f0723-l3"/>Reuß 15,000 Gülden beigesteuert wurden. Von den 1564 entstandenen drei <lb n="4" facs="#f0723-l4"/>Stammlinien Reuß erhielt nun jede ein Dritttheil der alten Herrschaft <placeName ref="#place-lobenstein">Loben<lb n="5" break="no" facs="#f0723-l5"/>stein</placeName>, die jüngere Linie jedoch gewann durch Kauf 1585 den Antheil der älteren<note place="foot" n="*)" xml:id="p711-fn1" facs="#f0723-fn1"><lb n="42" facs="#f0723-l42"/>Dieser dritte Theil war 1580 an den Freiherrn <persName ref="#person-milchling-v-burg">Milchling v. Burg</persName> verpfändet. <lb n="43" facs="#f0723-l43"/>Glücklicher Weise gab der Kaiser seine Genehmigung nicht zur Umwandlung des Pfandes <lb n="44" facs="#f0723-l44"/>in einen Verkauf.</note> <lb n="6" facs="#f0723-l6"/>um 41,712 Gülden und 1588 auch den der mittleren Linie, so daß sie nun im <lb n="7" facs="#f0723-l7"/>Besitze des Ganzen war und geblieben ist. <persName ref="#person-heinrich-posthumus">Heinrich Posthumus</persName>, das ruhmvolle <lb n="8" facs="#f0723-l8"/>Haupt der jüngeren Linie, verlegte 1611 auf einige Zeit seine Residenz wegen <lb n="9" facs="#f0723-l9"/>der in <placeName ref="#place-gera">Gera</placeName> wüthenden <rs type="concept" ref="#concept-pest">Pest</rs> nach <placeName ref="#place-lobenstein">Lobenstein</placeName> und errichtete 1620 auf dem dasigen <lb n="10" facs="#f0723-l10"/>Bergschlosse eine Münze. Von seinen Söhnen bekam 1647 <persName ref="#person-heinrich-x">Heinrich X.</persName> als <lb n="11" facs="#f0723-l11"/>seine Erbportion das Gebiet <placeName ref="#place-lobenstein">Lobenstein</placeName> mit Abzug von 11 Orten<note place="foot" n="**)" xml:id="p711-fn2" facs="#f0723-fn2"><lb n="45" facs="#f0723-l45"/>S. <placeName ref="#place-saalburg">Saalburg</placeName>.</note>, 3 Saal<lb n="12" break="no" facs="#f0723-l12"/>hämmern und einigen Mühlen, dagegen mit 12 Rittermannslehen<note place="foot" n="***)" xml:id="p711-fn3" facs="#f0723-fn3"><lb n="46" facs="#f0723-l46"/><placeName ref="#place-toepen">Töpen</placeName>, Berg, <placeName ref="#place-feilitzsch">Feilitzsch</placeName>, <placeName ref="#place-zedtwitz">Zedtwitz</placeName>, <placeName ref="#place-muenchenreuth">Münchenreuth</placeName>, <placeName ref="#place-brandstein">Brandstein</placeName>, <placeName ref="#place-tiefendorf">Tiefendorf</placeName>, die Vor<lb n="47" break="no" facs="#f0723-l47"/>werke <placeName ref="#place-obersachsen">Obersachsen</placeName> und <placeName ref="#place-untersachsen">Untersachsen</placeName>, <placeName ref="#place-issiga">Issiga</placeName>, <placeName ref="#place-trogen">Trogen</placeName> und <placeName ref="#place-hadermannsgruen">Hadermannsgrün</placeName>.</note> und 18 <lb n="13" facs="#f0723-l13"/>einzelnen Lehenstücken†) im <placeName ref="#place-hofer-land">Hoferland</placeName> und begründete dadurch das Specialhaus <lb n="14" facs="#f0723-l14"/><placeName ref="#place-lobenstein">Lobenstein</placeName>, welches 201 Jahre hindurch, vorübergehend in drei und zwei Linien <lb n="15" facs="#f0723-l15"/>getheilt, bestand und endlich 1848 im Sturme der Zeit zu Gunsten des <lb n="16" facs="#f0723-l16"/>Herrscherhauses <placeName ref="#place-schleiz">Schleiz</placeName> entsagte. Die Reihenfolge der Regenten von <placeName ref="#place-lobenstein">Loben<lb n="17" break="no" facs="#f0723-l17"/>stein</placeName> und ihrer Linien, unter denen die von <placeName ref="#place-ebersdorf">Ebersdorf</placeName> sich durch geistreiche und <lb n="18" facs="#f0723-l18"/>originelle Glieder hervorthat, ist folgende:</p>
<ab type="heading" xml:id="p711-b2" facs="#f0723-b2"><lb n="19" facs="#f0723-l19"/>Specialhaus Lobenstein.</ab>
<ab type="heading" xml:id="p711-b3" facs="#f0723-b3"><lb n="20" facs="#f0723-l20"/><persName ref="#person-heinrich-x">Heinrich X.</persName>, 1646—1671.</ab>
<p xml:id="p711-b4"><lb n="21" facs="#f0723-l21"/><persName ref="#person-heinrich-iii">Heinrich III.</persName>, <persName ref="#person-heinrich-viii">Heinrich VIII.</persName> und <persName ref="#person-heinrich-x">Heinrich X.</persName>, 1671—1678, theilen 1678.</p>
<p xml:id="p711-b5"><lb n="22" facs="#f0723-l22"/>Die weniger nach geographischer Abrundung und bequemer Verwaltung, <lb n="23" facs="#f0723-l23"/>als vielmehr nach Gleichheit der Revenuen gemachten Portionen waren:</p>
<p xml:id="p711-b6"><lb n="24" facs="#f0723-l24"/><placeName ref="#place-lobenstein">Lobenstein</placeName>, Schloß und Stadt, die Vorwerke Galgenberg und <placeName ref="#place-thierbach">Thierbach</placeName>, <lb n="25" facs="#f0723-l25"/>die Schäfereien zu <placeName ref="#place-schoenbrunn">Schönbrunn</placeName> und <placeName ref="#place-thierbach">Thierbach</placeName>, die Dorfschaften <placeName ref="#place-schoenbrunn">Schönbrunn</placeName>, <lb n="26" facs="#f0723-l26"/><placeName ref="#place-oberlemnitz">Oberlemnitz</placeName>, <placeName ref="#place-ruppersdorf">Ruppersdorf</placeName>, Thierbach, <placeName ref="#place-heinersdorf">Heinersdorf</placeName>, <placeName ref="#place-neundorf">Neundorf</placeName> zur Hälfte, <placeName ref="#place-schlegel">Schlegel</placeName>, <lb n="27" facs="#f0723-l27"/><placeName ref="#place-froessen">Frössen</placeName>, <placeName ref="#place-blankenstein">Blankenstein</placeName>, Greinershammer, die Rittergüter zu <placeName ref="#place-heinersdorf">Heinersdorf</placeName>, <placeName ref="#place-harra">Harra</placeName> <lb n="28" facs="#f0723-l28"/>oberen Theils, <placeName ref="#place-blankenstein">Blankenstein</placeName>, <placeName ref="#place-eichenstein">Eichenstein</placeName>, <placeName ref="#place-sachsbuehl">Sachsbühl</placeName>, <placeName ref="#place-weissbach">Weißbach</placeName> und <placeName ref="#place-roedern">Rödern</placeName>, <placeName ref="#place-altengesees">Alten<lb n="29" break="no" facs="#f0723-l29"/>gesees</placeName>, <placeName ref="#place-lothra">Lothra</placeName>, <placeName ref="#place-wurzbach">Wurzbach</placeName>, <placeName ref="#place-froessen">Frössen</placeName> und <placeName ref="#place-hohenpreis">Stöcketen</placeName> und die Jagden in dem Theile <lb n="30" facs="#f0723-l30"/>des <name type="nature" ref="#nature-frankenwald">Frankenwalds</name>, der vordem zu <placeName ref="#place-saalburg">Saalburg</placeName> geschlagen war.</p>
<p xml:id="p711-b7"><lb n="31" facs="#f0723-l31"/><placeName ref="#place-hirschberg">Hirschberg</placeName>, Schloß und Stadt, die Dörfer <placeName ref="#place-blintendorf">Blintendorf</placeName>, <placeName ref="#place-dobareuth">Dobareuth</placeName>, <lb n="32" facs="#f0723-l32"/><placeName ref="#place-gebersreuth">Gebersreuth</placeName>, Glashütte, <placeName ref="#place-goettengruen">Göttengrün</placeName>, <placeName ref="#place-goeritz">Göritz</placeName>, <placeName ref="#place-harra">Harra</placeName>, <placeName ref="#place-kiessling">Kießling</placeName>, Gehege und <lb n="33" facs="#f0723-l33"/>Abgang, <placeName ref="#place-langgruen">Langengrün</placeName>, <placeName ref="#place-moedlareuth">Mödlareuth</placeName>, <placeName ref="#place-ossla">Oßla</placeName>, <placeName ref="#place-pirk">Pirk</placeName>, <placeName ref="#place-pottiga">Pottiga</placeName>, <placeName ref="#place-rothenacker">Rothenacker</placeName>, <placeName ref="#place-roettersdorf">Rötters<lb n="34" break="no" facs="#f0723-l34"/>dorf</placeName>, <placeName ref="#place-spielmes">Spielmes</placeName>, <placeName ref="#place-thimmendorf">Thimmendorf</placeName>, <placeName ref="#place-ullersreuth">Ullersreuth</placeName>, <placeName ref="#place-venzka">Benzka</placeName>, die Hämmer an der <name type="nature" ref="#nature-saale">Saale</name>, <lb n="35" facs="#f0723-l35"/>die Rittermannlehngüter <placeName ref="#place-dobareuth">Dobareuth</placeName>, <placeName ref="#place-goeritz">Göritz</placeName>, <placeName ref="#place-ossla">Oßla</placeName>, <placeName ref="#place-moedlareuth">Mödlareuth</placeName>, <placeName ref="#place-pirk">Pirk</placeName>, <placeName ref="#place-pottiga">Pottiga</placeName> <lb n="36" facs="#f0723-l36"/>und <placeName ref="#place-venzka">Benzka</placeName>, der Saalwald von <placeName ref="#place-niedergruen">Niederngrün</placeName> bis an die <name type="nature" ref="#nature-saale">Saale</name>.</p>
<p xml:id="p711-b8"><lb n="37" facs="#f0723-l37"/>Die Dörfer <placeName ref="#place-ebersdorf">Ebersdorf</placeName>, <placeName ref="#place-eliasbrunn">Eliasbrunn</placeName>, <placeName ref="#place-gahma">Gahma</placeName>, <placeName ref="#place-helmsgruen">Helmsgrün</placeName>, <placeName ref="#place-lichtenbrunn">Lichtenbrunn</placeName>, <lb n="38" facs="#f0723-l38"/><placeName ref="#place-lothra">Lothra</placeName>, <placeName ref="#place-neundorf">Neundorf</placeName> zur Hälfte, <placeName ref="#place-lueckenmuehle">Lückenmühle</placeName>, <placeName ref="#place-titschendorf">Titschendorf</placeName>, <placeName ref="#place-unterlemnitz">Unterlemnitz</placeName>, <placeName ref="#place-weissbach">Weißbach</placeName>, <lb n="39" facs="#f0723-l39"/>die Mannschaft zu <placeName ref="#place-wurzbach">Wurzbach</placeName>, ein Theil der Mannschaft zu <placeName ref="#place-altengesees">Altengesees</placeName>, <placeName ref="#place-seibis">Seibis</placeName> <lb n="40" facs="#f0723-l40"/>und <placeName ref="#place-weitisberga">Weitisberga</placeName>, die Rittergüter <placeName ref="#place-ebersdorf">Ebersdorf</placeName>, <placeName ref="#place-harra">Harra</placeName> unteren Theils, <placeName ref="#place-haueisen">Haueisen</placeName>, <lb n="41" facs="#f0723-l41"/><placeName ref="#place-kiessling">Kießling</placeName> und <placeName ref="#place-weitisberga">Weitisberga</placeName>, verschiedene Mühlen und ein Theil des <name type="nature" ref="#nature-frankenwald">Frankenwalds</name>.</p>
<p><note place="foot" n="†)" xml:id="p711-fn4" facs="#f0723-fn4"><lb n="48" facs="#f0723-l48"/><placeName ref="#place-bruck">Bruck</placeName>, <placeName ref="#place-buch">Buch</placeName>, <placeName ref="#place-eisenbuehl">Eisenbühl</placeName>, <placeName ref="#place-fletterreuth">Fletterreuth</placeName>, <placeName ref="#place-joditz">Goditz</placeName> (<placeName ref="#place-joditz">Joditz</placeName>), <placeName ref="#place-hohendorf">Hohendorf</placeName>, <placeName ref="#place-klingensporn">Klingensporn</placeName>, <placeName ref="#place-koeditz">Köditz</placeName>, <lb n="49" facs="#f0723-l49"/><placeName ref="#place-kohlbuehl">Kohlbühl</placeName>, <placeName ref="#place-unterkozau">Unterkozau</placeName>, <placeName ref="#place-lamitz">Lamitz</placeName>, <placeName ref="#place-marksgruen">Marksgrün</placeName>, <placeName ref="#place-moos">Moos</placeName>, <placeName ref="#place-rudolphstein">Rudolphsstein</placeName>, <placeName ref="#place-salenstein">Salenstein</placeName>, <placeName ref="#place-schollenreuth">Schollenreuth</placeName>, <lb n="50" facs="#f0723-l50"/><placeName ref="#place-schnarchenreuth">Schnarchenreuth</placeName> und <placeName ref="#place-tiefengruen">Tiefengrün</placeName>.</note></p>
</div></body></text>
