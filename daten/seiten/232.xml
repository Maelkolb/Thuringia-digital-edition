-l39" type="line" n="39" ulx="244" uly="1859" lrx="1593" lry="1903"/><zone xml:id="f0244-l40" type="line" n="40" ulx="242" uly="1903" lrx="1591" lry="1947"/><zone xml:id="f0244-l41" type="line" n="41" ulx="245" uly="1946" lrx="1588" lry="1990"/><zone xml:id="f0244-l42" type="line" n="42" ulx="244" uly="1989" lrx="1590" lry="2032"/><zone xml:id="f0244-l43" type="line" n="43" ulx="245" uly="2030" lrx="1593" lry="2074"/><zone xml:id="f0244-l44" type="line" n="44" ulx="245" uly="2073" lrx="452" lry="2117"/><zone xml:id="f0244-l45" type="line" n="45" ulx="335" uly="2116" lrx="1593" lry="2160"/><zone xml:id="f0244-l46" type="line" n="46" ulx="247" uly="2160" lrx="1594" lry="2204"/><zone xml:id="f0244-l47" type="line" n="47" ulx="320" uly="2271" lrx="1596" lry="2315"/><zone xml:id="f0244-l48" type="line" n="48" ulx="250" uly="2314" lrx="1593" lry="2351"/><zone xml:id="f0244-l49" type="line" n="49" ulx="253" uly="2384" lrx="615" lry="2418"/></surface></facsimile>
<text><body><div type="page" n="232"><pb n="232" facs="#f0244"/>
<fw type="header" place="top">III. Die Volksbetriebsamkeit.</fw>
<p xml:id="p232-b1"><lb n="1" facs="#f0244-l1"/>kann von einer <rs type="concept" ref="#concept-viehzucht">Pferdezucht</rs> nicht die Rede sein, sondern nur von einer Pferde<lb n="2" break="no" facs="#f0244-l2"/>halterei. Untergeordnet sind die <name type="organism" ref="#organism-pferd">Luxuspferde</name>, vorherrschend die <name type="organism" ref="#organism-pferd">Arbeitspferde</name>, <lb n="3" facs="#f0244-l3"/>die wegen des harten, steinigen Bodens aus kräftigen Gespannen bestehen <lb n="4" facs="#f0244-l4"/>müssen.</p>
<p xml:id="p232-b2"><lb n="5" facs="#f0244-l5"/><name type="organism" ref="#organism-maultier">Maulthiere</name> und <name type="organism" ref="#organism-esel">Esel</name>, früher in Diensten der <rs type="concept" ref="#concept-burg">Burgen</rs> und Müller häufig, <lb n="6" facs="#f0244-l6"/>sind gegenwärtig nur einzelne Vorkommnisse. 1864 gab es deren sechs, 1867 <lb n="7" facs="#f0244-l7"/>blos vier im Lande.</p>
<p xml:id="p232-b3"><lb n="8" facs="#f0244-l8"/><rs type="concept" ref="#concept-viehzucht">Rindviehzucht</rs>. Das Rind nährt, wie das Volk weiß, den Tisch, Beutel <lb n="9" facs="#f0244-l9"/>und Acker, daher wendet man ihm alle Sorgfalt zu und vermehrt es nach <lb n="10" facs="#f0244-l10"/>Kräften, wie denn schon der Kleingütler auf zehn Morgen eine <name type="organism" ref="#organism-kuh">Kuh</name> hält, die <lb n="11" facs="#f0244-l11"/>seine Armuth zudeckt. Früher hielt der Bauer mehr auf die Zahl und den <lb n="12" facs="#f0244-l12"/>gleichen Schlag der <name type="organism" ref="#organism-rind">Rinder</name>, als auf Pflege, Stallung und gute Race; dazu war <lb n="13" facs="#f0244-l13"/>das <name type="organism" ref="#organism-vieh">Vieh</name> entweder an den Gemeindehirten und dieser an beschränkte <rs type="concept" ref="#concept-weide">Weiden</rs> <lb n="14" facs="#f0244-l14"/>gebunden oder jeder Besitzer ließ durch seine Kinder, wie da und dort noch heute, <lb n="15" facs="#f0244-l15"/>sein <name type="organism" ref="#organism-rind">Rind</name> auf die Hut treiben. Dies galt übrigens nicht blos von den Dörfern, <lb n="16" facs="#f0244-l16"/>sondern auch von den Städten, die gleichfalls Heerden und Hirten hatten. Auch <lb n="17" facs="#f0244-l17"/>stand es mit der Nachzucht übel, wo nicht die Bullenerhaltung eine Reallast <lb n="18" facs="#f0244-l18"/>der Güter war. Ein entschiedener Fortschritt zur blühenden Viehzucht, von <lb n="19" facs="#f0244-l19"/>welcher der bessere Ertrag des Feldbodens abhängt, geschah mit der Einführung <lb n="20" facs="#f0244-l20"/>der <name type="organism" ref="#organism-kartoffel">Kartoffeln</name> und des <rs type="concept" ref="#concept-kleebau">Kleebaues</rs>, der Besömmerung der Brache, der ausge<lb n="21" break="no" facs="#f0244-l21"/>dehnteren Betreibung der <rs type="concept" ref="#concept-brennerei">Brennereien</rs> und der Beschaffung edler <name type="organism" ref="#organism-stier">Bullen</name>, besonders <lb n="22" facs="#f0244-l22"/>aber mit der Ablösung der Feudallasten und mit der Stallfütterung. Wird <lb n="23" facs="#f0244-l23"/>auch ein Theil des Jungviehes aus dem <placeName ref="#place-oberfranken">Oberfränkischen</placeName> bezogen, so züchtet <lb n="24" facs="#f0244-l24"/>man doch den größeren Theil im Lande selbst, nährt zudem das Vieh kräftiger <lb n="25" facs="#f0244-l25"/>als sonst und bringt viel <name type="organism" ref="#organism-vieh">Mastvieh</name>, das beste aus dem schleizer Gebiete, auf die <lb n="26" facs="#f0244-l26"/>oberländischen Märkte, unter denen die zu <placeName ref="#place-schleiz">Schleiz</placeName> und <placeName ref="#place-tanna">Tanna</placeName> die besuchtesten <lb n="27" facs="#f0244-l27"/>sind. Für das Unterland ist <placeName ref="#place-gera">Gera</placeName> als <rs type="concept" ref="#concept-milch">Milch</rs>-, <rs type="concept" ref="#concept-butter">Butter</rs>- und Fleischverzehrer <lb n="28" facs="#f0244-l28"/>auf die Viehwirthschaft umher von großem Einflusse.</p>
<p xml:id="p232-b4"><lb n="29" facs="#f0244-l29"/><rs type="concept" ref="#concept-viehzucht">Schafzucht</rs>. Zur Zeit des unfreien Bodens hatten in der Zahl der <lb n="30" facs="#f0244-l30"/><rs type="concept" ref="#concept-viehzucht">Schafhaltung</rs>, in der Triftnutzung von bald mehr, bald weniger Fluren und im <lb n="31" facs="#f0244-l31"/>Antheil an <rs type="concept" ref="#concept-weide">Koppelweiden</rs> die herrschaftlichen Vorwerke und Güter die größte<note place="foot" n="*)" xml:id="p232-fn1" facs="#f0244-fn1"><lb n="47" facs="#f0244-l47"/>Beispielsweise mag hier nur die Berechtigung der Schäferei vom <placeName ref="#place-duerrhof">Dürrenhof</placeName> genannt <lb n="48" facs="#f0244-l48"/>werden. Die Schäferei dieses Gutes hatte die Fluren von <placeName ref="#place-moenchgruen">Mönchgrün</placeName>, <placeName ref="#place-goerkwitz">Görkwitz</placeName>, <placeName ref="#place-schleiz">Schleiz</placeName>, <placeName ref="#place-oberboehmsdorf">Oberböhmsdorf</placeName>, <placeName ref="#place-zollgruen">Zollgrün</placeName>, <placeName ref="#place-mielesdorf">Mielesdorf</placeName>, <placeName ref="#place-tanna">Tanna</placeName>, <placeName ref="#place-koskau">Koskau</placeName>, <placeName ref="#place-stelzen">Stelzen</placeName>, <placeName ref="#place-spielmes">Spilmes</placeName>, <placeName ref="#place-raila">Raila</placeName> und <lb n="49" facs="#f0244-l49"/><placeName ref="#place-wernsdorf">Wernsdorf</placeName> zu betreiben.</note>, <lb n="32" facs="#f0244-l32"/>die Rittergüter eine verhältnißmäßig geringere und die meisten Gemeinden gar <lb n="33" facs="#f0244-l33"/>keine oder nur eine beschränkte Berechtigung, so daß selbst deren <name type="organism" ref="#organism-hund">Hunde</name> Knüttel <lb n="34" facs="#f0244-l34"/>tragen mußten. Seit der Ablösung des Triftbannes hat zwar die Schafzucht <lb n="35" facs="#f0244-l35"/>der bäuerlichen Wirthschaften zugenommen, doch ist sie im Ganzen gegen die <lb n="36" facs="#f0244-l36"/>Rindviehzucht im Rückzuge begriffen, weil diese lohnender ist und kleine Schaf<lb n="37" break="no" facs="#f0244-l37"/>haltungen keinen entsprechenden Nutzen schaffen. Nur Triften mit ausgedehntem <lb n="38" facs="#f0244-l38"/>Rasen und mit guten Stoppelfeldern bilden den Boden, wo das <name type="organism" ref="#organism-schaf">Schaf</name> gedeiht, <lb n="39" facs="#f0244-l39"/>weshalb jetzt allein noch größere Gutscomplexe mit Vortheil Schafzucht treiben <lb n="40" facs="#f0244-l40"/>können. Das Streben nach Veredelung der Schäfereien begann Mitte des <lb n="41" facs="#f0244-l41"/>vorigen Jahrhunderts. Ganz veredelte <name type="organism" ref="#organism-schaf">Schafe</name> finden sich gegenwärtig nur auf <lb n="42" facs="#f0244-l42"/>einigen Kammergütern, halb veredelte dagegen auf allen größeren, selbst auf <lb n="43" facs="#f0244-l43"/>mehreren bäuerlichen Gütern und das unveredelte alte <name type="organism" ref="#organism-schaf">Landschaf</name> in allen Orten <lb n="44" facs="#f0244-l44"/>des Landes.</p>
<p xml:id="p232-b5"><lb n="45" facs="#f0244-l45"/><rs type="concept" ref="#concept-viehzucht">Schweinezucht</rs>. Seit alter Zeit ist das Schwein ein Lieblings-Zucht<lb n="46" break="no" facs="#f0244-l46"/>thier der voigtländischen Familien, weil bei keinem Zuchtthiere sich das Futter</p>
</div></body></text>
