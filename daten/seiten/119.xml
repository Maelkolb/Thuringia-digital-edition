="68" uly="2006" lrx="1417" lry="2050"/><zone xml:id="f0131-l41" type="line" n="41" ulx="70" uly="2050" lrx="1416" lry="2094"/><zone xml:id="f0131-l42" type="line" n="42" ulx="73" uly="2092" lrx="1417" lry="2136"/><zone xml:id="f0131-l43" type="line" n="43" ulx="70" uly="2134" lrx="1416" lry="2178"/><zone xml:id="f0131-l44" type="line" n="44" ulx="71" uly="2178" lrx="1416" lry="2222"/><zone xml:id="f0131-l45" type="line" n="45" ulx="148" uly="2255" lrx="1414" lry="2299"/><zone xml:id="f0131-l46" type="line" n="46" ulx="74" uly="2295" lrx="1411" lry="2335"/><zone xml:id="f0131-l47" type="line" n="47" ulx="76" uly="2331" lrx="1269" lry="2368"/><zone xml:id="f0131-l48" type="line" n="48" ulx="130" uly="2370" lrx="1065" lry="2413"/></surface></facsimile>
<text><body><div type="page" n="119"><pb n="119" facs="#f0131"/>
<ab type="heading" xml:id="p119-b1" facs="#f0131-b1"><lb n="1" facs="#f0131-l1"/>2. Wohnliche Einrichtung.</ab>
<p xml:id="p119-b2"><lb n="2" facs="#f0131-l2"/>a) Die Orte. In den Ortsnamen des Landes mit Einschluss der Flur-, <lb n="3" facs="#f0131-l3"/>Berg- und Flussnamen liegt ein Stück Geschichte derjenigen Völker, welche das<lb n="4" break="no" facs="#f0131-l4"/>selbe bewohnt haben. Steinmonumenten gleich zeigen diese Namen eine Dauer <lb n="5" facs="#f0131-l5"/>durch Jahrtausende und geben Zeugnis von ferneren und näheren Zeiten. In <lb n="6" facs="#f0131-l6"/>Hinsicht ihrer Ableitung und Deutung hat man sich indess nicht immer von <lb n="7" facs="#f0131-l7"/>phantastischer Spielerei fern gehalten. Wenn das sagenwebende Volk sich viele <lb n="8" facs="#f0131-l8"/>Orts- und Flurnamen <note place="foot" n="*)" xml:id="p119-fn1" facs="#f0131-fn1"><lb n="45" facs="#f0131-l45"/>Ernsee = Irren sie; Langenberg = lang am Berg; Dragensdorf = zertragenes <lb n="46" facs="#f0131-l46"/>Dorf; Lobenstein = zu lobender Stein; Bramenthal = Brombeerthal. Ueber Gräfenwarth, <lb n="47" facs="#f0131-l47"/><placeName ref="#place-schleiz">Schleiz</placeName>, Neuärgerniß, Widerwillen, Trotz, <placeName ref="#place-naundorf">Naundorf</placeName> u. a. siehe die Topographie.</note> zu deuten sucht, so darf doch nimmermehr dessen naive <lb n="9" facs="#f0131-l9"/>Weise, die sich auf Gleichklänge stützt, in das wissenschaftliche Gebiet herüber<lb n="10" break="no" facs="#f0131-l10"/>gezogen werden. Denn werden, wie dies geschehen, die Kattenberge, Katten<lb n="11" break="no" facs="#f0131-l11"/>felsen, Katzensteine und Käsesteine von den Katten, die Orte auf Grün von den <lb n="12" facs="#f0131-l12"/>Nariskern, Gama, Gäma, Gämisch von den Chämen, die Teuer und Tauern <lb n="13" facs="#f0131-l13"/>von den Teuriochämen abgeleitet, so verliert man sich in das Haltlose und <lb n="14" facs="#f0131-l14"/>Abenteuerliche.</p>
<p xml:id="p119-b3"><lb n="15" facs="#f0131-l15"/>Ueberblickt man die Orts- und Flurnamen des Landes, so hat von jenen <lb n="16" facs="#f0131-l16"/>die Hälfte, von diesen ein Sechzigtheil sorbischen, die übrigen rein deutschen <lb n="17" facs="#f0131-l17"/>Laut, weshalb durch sie wie durch die Geschichte eine Colonisation des Landes <lb n="18" facs="#f0131-l18"/>von Sorben und Deutschen bezeugt wird. Am dichtesten kommen die sorbischen <lb n="19" facs="#f0131-l19"/>Localnamen im Unterlande, etwas dünner, doch allüberall im Oberlande vor, <lb n="20" facs="#f0131-l20"/>woraus im Allgemeinen hervorgeht, dass beide Gebiete zu gleicher Zeit von den <lb n="21" facs="#f0131-l21"/>Sorben bewohnt waren. Auch finden sich Gruppen unterländischer Orte zugleich <lb n="22" facs="#f0131-l22"/>im Oberlande und auf benachbarten Gebieten. So <placeName ref="#place-kulm">Kulm</placeName>, <placeName ref="#place-wernsdorf">Wernsdorf</placeName>, <placeName ref="#place-neundorf">Neundorf</placeName> (<lb n="23" facs="#f0131-l23"/><placeName ref="#place-naundorf">Naundorf</placeName>) und <placeName ref="#place-roeppisch">Röppisch</placeName> im Unterlande und Oberlande; <placeName ref="#place-poeppeln">Pöppeln</placeName>, <placeName ref="#place-grobsdorf">Grobsdorf</placeName> und <lb n="24" facs="#f0131-l24"/><placeName ref="#place-geissen">Geißen</placeName> auf beiden Seiten der <name type="nature" ref="#nature-weisse-elster">Elster</name>; <placeName ref="#place-gleina">Gleina</placeName>, <placeName ref="#place-caaschwitz">Caaschwitz</placeName> und <placeName ref="#place-koestritz">Köstritz</placeName> entsprechen <lb n="25" facs="#f0131-l25"/>dem <placeName ref="#place-kleina">Kleina</placeName>, <placeName ref="#place-quaschwitz">Quaschwitz</placeName> und <placeName ref="#place-koestitz">Köstiz</placeName> im neustädter Kreise. Nicht minder merk<lb n="26" break="no" facs="#f0131-l26"/>würdig ist, dass eine Reihe von slavischen Ortsnamen in den Fluren nicht allein <lb n="27" facs="#f0131-l27"/>sorbischer, sondern auch deutscher Dörfer als Flurnamen getroffen werden. Dahin <lb n="28" facs="#f0131-l28"/>gehören <placeName ref="#place-lehesten">Lehesten</placeName> in <placeName ref="#place-dittersdorf">Dettersdorf</placeName> und <placeName ref="#place-seubtendorf">Seubtendorf</placeName>, Lemnitz in <placeName ref="#place-ruedersdorf">Rüdersdorf</placeName>, Lesse <lb n="29" facs="#f0131-l29"/>in <placeName ref="#place-rubitz">Rubitz</placeName>, <placeName ref="#place-loehma">Löhma</placeName> in <placeName ref="#place-rothenacker">Rothenacker</placeName>, Lohmen in <placeName ref="#place-oschitz">Oschitz</placeName> und <placeName ref="#place-ullersreuth">Ullersreuth</placeName>, <placeName ref="#place-schlegel">Schlegel</placeName> <lb n="30" facs="#f0131-l30"/>in <placeName ref="#place-hohenleuben">Hohenleuben</placeName>, <placeName ref="#place-schleiz">Schleiz</placeName> in <placeName ref="#place-loehma">Löhma</placeName>, <placeName ref="#place-desse">Desse</placeName> in <placeName ref="#place-dittersdorf">Dettersdorf</placeName>, <placeName ref="#place-kulm">Kulm</placeName> in <placeName ref="#place-schlegel">Schlegel</placeName>, <lb n="31" facs="#f0131-l31"/><placeName ref="#place-eger">Eger</placeName> in <placeName ref="#place-hermsdorf">Hermsdorf</placeName> und <placeName ref="#place-kretschwitz">Kretzschwitz</placeName>, <placeName ref="#place-ciba">Ciba</placeName> in <placeName ref="#place-goeritz">Göritz</placeName>, <placeName ref="#place-horla">Horla</placeName> in <placeName ref="#place-ullersreuth">Ullersreuth</placeName>, <lb n="32" facs="#f0131-l32"/>Linz in <placeName ref="#place-ruedersdorf">Rüdersdorf</placeName>, <name type="nature" ref="#nature-goerlitz-huehnerbach">Görlitz</name> in <placeName ref="#place-loehma">Löhma</placeName>, <placeName ref="#place-gruschitz">Gruschitz</placeName> in <placeName ref="#place-burkersdorf">Burkersdorf</placeName>, <placeName ref="#place-dels">Dels</placeName> in <lb n="33" facs="#f0131-l33"/><placeName ref="#place-dittersdorf">Dettersdorf</placeName>, Zoppoter in <placeName ref="#place-ullersreuth">Ullersreuth</placeName>, <placeName ref="#place-groeben">Gröben</placeName> in <placeName ref="#place-poeritzsch">Pöritzsch</placeName>, Mohla in <placeName ref="#place-lothra">Lothra</placeName>. <lb n="34" facs="#f0131-l34"/>Daneben sind viele Flurnamen ausgeprägt sorbisch, wie Krauschitzwitz, Ge<lb n="35" break="no" facs="#f0131-l35"/>rmutsch, Krunitzsch, Modelitzsch, Gultschit, Elschnitz, Mudschlett, Speutewitz, <lb n="36" facs="#f0131-l36"/>Kremel, Lömtsch, Gumlichse, Delsch, Delschig, Gronitz, Sormbach, Zoche, Kolke, <lb n="37" facs="#f0131-l37"/>Laasig, Jupe, Türpis, Tesche, Zomsen, Zschäschig, Silke und Salpe. Indess <lb n="38" facs="#f0131-l38"/>trotz der Ausbreitung der sorbischen Namen über das ganze Land zeigt sich doch <lb n="39" facs="#f0131-l39"/>aus der Art ihres Vorkommens auf das Deutlichste, dass der Sorbe die Thäler <lb n="40" facs="#f0131-l40"/>und Mulden, somit die offenen, ergiebigen und leicht bearbeitbaren Landstriche <lb n="41" facs="#f0131-l41"/>liebte und bebaute, dagegen den härteren Boden und die Waldgegenden mied. <lb n="42" facs="#f0131-l42"/>Dies hatte seinen Grund in der Indolenz des Slaven und in der leichten <lb n="43" facs="#f0131-l43"/>Hacke, womit er das Feld bearbeitete, während der deutsche Colonist mit seinem <lb n="44" facs="#f0131-l44"/>zähen Fleiße, seinem schweren eisernen <rs type="concept" ref="#concept-pflug">Pflug</rs> <note place="foot" n="**)" xml:id="p119-fn2" facs="#f0131-fn2"><lb n="48" facs="#f0131-l48"/>In den Urkunden ferramenta aratri, quae vocantur scar.</note> und der wuchtigen <rs type="concept" ref="#concept-axt">Axt</rs> den</p>
</div></body></text>
