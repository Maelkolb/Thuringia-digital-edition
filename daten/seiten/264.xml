39" type="line" n="39" ulx="186" uly="1858" lrx="1535" lry="1902"/><zone xml:id="f0276-l40" type="line" n="40" ulx="189" uly="1900" lrx="1536" lry="1944"/><zone xml:id="f0276-l41" type="line" n="41" ulx="189" uly="1942" lrx="1541" lry="1986"/><zone xml:id="f0276-l42" type="line" n="42" ulx="190" uly="1984" lrx="1539" lry="2028"/><zone xml:id="f0276-l43" type="line" n="43" ulx="189" uly="2026" lrx="1539" lry="2070"/><zone xml:id="f0276-l44" type="line" n="44" ulx="186" uly="2070" lrx="1541" lry="2114"/><zone xml:id="f0276-l45" type="line" n="45" ulx="190" uly="2113" lrx="1542" lry="2157"/><zone xml:id="f0276-l46" type="line" n="46" ulx="190" uly="2155" lrx="1538" lry="2199"/><zone xml:id="f0276-l47" type="line" n="47" ulx="189" uly="2198" lrx="1538" lry="2242"/><zone xml:id="f0276-l48" type="line" n="48" ulx="187" uly="2241" lrx="1539" lry="2285"/><zone xml:id="f0276-l49" type="line" n="49" ulx="192" uly="2283" lrx="1538" lry="2327"/><zone xml:id="f0276-l50" type="line" n="50" ulx="276" uly="2325" lrx="1542" lry="2369"/><zone xml:id="f0276-l51" type="line" n="51" ulx="190" uly="2368" lrx="1539" lry="2412"/></surface></facsimile>
<text><body><div type="page" n="264"><pb n="264" facs="#f0276"/>
<fw type="header" place="top">IV. Der Staat.</fw>
<p xml:id="p264-b1"><lb n="1" facs="#f0276-l1"/>volljährig; während seiner Minderjährigkeit führt die Mutter oder der nächste <lb n="2" facs="#f0276-l2"/>Agnat die Vormundschaft.</p>
<p xml:id="p264-b2"><lb n="3" facs="#f0276-l3"/>Bei dem ehemaligen <orgName ref="#organisation-bundestag-des-deutschen-bundes">Bundestage</orgName> hatte das Haus Reuß j. L. im engeren <lb n="4" facs="#f0276-l4"/>Rathe mit Reuß ä. L., <placeName ref="#place-hohenzollern">Hohenzollern</placeName>, <placeName ref="#place-liechtenstein">Lichtenstein</placeName>, <placeName ref="#place-fuerstenthum-schaumburg-lippe">Schaumburg-Lippe</placeName>, <placeName ref="#place-fuerstenthum-lippe-detmold">Lippe-<lb n="5" facs="#f0276-l5"/>Detmold</placeName> und <placeName ref="#place-fuerstenthum-waldeck">Waldeck</placeName> die 16. Curiatstimme, im weiteren Rathe aber eine be<lb n="6" break="no" facs="#f0276-l6"/>sondere Stimme. In dem <orgName ref="#organisation-norddeutscher-bund">norddeutschen Bunde</orgName>, zu dem das Fürstenthum seit <lb n="7" facs="#f0276-l7"/>1866 durch einen freiwilligen Abschluß des Fürsten mit <placeName ref="#place-preussen">Preußen</placeName> vom 26. Juni <lb n="8" facs="#f0276-l8"/>d. J. gehört, hat es eine Stimme im <orgName ref="#organisation-bundesrath-des-norddeutschen-bundes">Bundesrathe</orgName> und einen Vertreter im <lb n="9" facs="#f0276-l9"/><orgName ref="#organisation-reichstag-des-norddeutschen-bundes">Reichstage</orgName>.</p>
<p xml:id="p264-b3"><lb n="10" facs="#f0276-l10"/>Das Staatswappen des Fürstenthums führt in dem ersten und vierten <lb n="11" facs="#f0276-l11"/>Felde des gevierten Schildes einen aufrecht stehenden, rechts gewaffneten, gold<lb n="12" break="no" facs="#f0276-l12"/>farbenen <name type="organism" ref="#organism-loewe">Löwen</name> (Stammwappen) in Schwarz wegen Reuß und in dem zweiten <lb n="13" facs="#f0276-l13"/>und dritten Felde einen goldenen <name type="organism" ref="#organism-kranich">Kranich</name> in Silber wegen der Herrschaft <lb n="14" facs="#f0276-l14"/><placeName ref="#place-kranichfeld">Kranichfeld</placeName>, ist mit drei Helmen und zwar mit einem gold und schwarz ge<lb n="15" break="no" facs="#f0276-l15"/>spaltenen Brackenkopfe, einem oben mit drei Pfauenspiegeln besteckten Fürsten<lb n="16" break="no" facs="#f0276-l16"/>hute und einem von gelb, schwarz und roth siebenmal schräg getheilten <name type="organism" ref="#organism-kranich">Kranich</name> <lb n="17" facs="#f0276-l17"/>gedeckt, hat zu Schildhaltern zwei gold und schwarz getheilte <name type="organism" ref="#organism-loewe">Löwen</name> und wird <lb n="18" facs="#f0276-l18"/>von einem mit dem Fürstenhute bedeckten, hermelingefütterten Purpurmantel <lb n="19" facs="#f0276-l19"/>umgeben.</p>
<p xml:id="p264-b4"><lb n="20" facs="#f0276-l20"/>Das fürstlich reußische Wappen hat sich allmälig ausgebildet. Von Anfang <lb n="21" facs="#f0276-l21"/>an bis 1294 führten die einzelnen Glieder des Stammhauses verschiedene Siegel <lb n="22" facs="#f0276-l22"/>und Wappen. Als erstes und ursprüngliches Siegel des Hauses <placeName ref="#place-weida">Weida</placeName> findet <lb n="23" facs="#f0276-l23"/>sich eine römische Gemme, welche ein von einem <name type="organism" ref="#organism-loewe">Löwen</name> angefallenes <name type="organism" ref="#organism-pferd">Pferd</name> dar<lb n="24" break="no" facs="#f0276-l24"/>stellt. Als sich um 1240 die drei Linien <placeName ref="#place-weida">Weida</placeName>, <placeName ref="#place-plauen">Plauen</placeName> und <placeName ref="#place-gera">Gera</placeName> bildeten, <lb n="25" facs="#f0276-l25"/>behielt die Linie <placeName ref="#place-weida">Weida</placeName> noch längere Zeit diese Gemme bei, daneben siegelten <lb n="26" facs="#f0276-l26"/>aber einzelne Glieder derselben mit dem von acht Sternen umgebenen Brust<lb n="27" break="no" facs="#f0276-l27"/>bilde eines orientalischen Kriegers oder mit einem rechts gewandten <name type="organism" ref="#organism-loewe">Löwen</name> oder <lb n="28" facs="#f0276-l28"/>mit einer links gerichteten <name type="organism" ref="#organism-loewe">Löwin</name>. <persName ref="#person-heinrich-der-ruthene-ruzze-reuss">Heinrich der Ruthene</persName>, der Begründer der <lb n="29" facs="#f0276-l29"/>Linie <placeName ref="#place-plauen">Plauen</placeName>, führte mit dem Erwerbe der gräflich ebersteinschen Lehnsherrschaft <lb n="30" facs="#f0276-l30"/><placeName ref="#place-plauen">Plauen</placeName> zuerst den von diesem Besitzthume und von den Grafen von Eberstein <lb n="31" facs="#f0276-l31"/>herübergenommenen, rechts aufgerichteten, gekrönten <name type="organism" ref="#organism-loewe">Löwen</name> als Wappenschild. <lb n="32" facs="#f0276-l32"/>Nach ihm gebrauchten dasselbe Wappen <persName ref="#person-heinrich-der-boehme-voigt-von-plauen">Heinrich der Böhme</persName> und dessen Sohn <lb n="33" facs="#f0276-l33"/><persName ref="#person-heinrich-der-lange">Heinrich der Lange</persName>, von denen letzterer 1306 eine Gemme mit einem im Schilfe <lb n="34" facs="#f0276-l34"/>watenden <name type="organism" ref="#organism-nilpferd">Nilpferde</name> als Rücksiegel anwendet; dagegen griff die jüngere plauische <lb n="35" facs="#f0276-l35"/>Linie, Reuß genannt, wieder zu den Gemmensiegeln mit den <name type="organism" ref="#organism-loewe">Löwenköpfen</name>. Die <lb n="36" facs="#f0276-l36"/>Linie <placeName ref="#place-gera">Gera</placeName> führte anfangs die Gemme mit der Amazone auf dem <name type="organism" ref="#organism-seepferd">Seepferde</name>.</p>
<p xml:id="p264-b5"><lb n="37" facs="#f0276-l37"/>Am 14. December 1293 belehnte Pfalzgraf <persName ref="#person-rudolf-von-bayern">Rudolf von Bayern</persName> die Voigte <lb n="38" facs="#f0276-l38"/>von <placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-plauen">Plauen</placeName> und <placeName ref="#place-weida">Weida</placeName> gemeinschaftlich mit seinem Schilde und Banner <lb n="39" facs="#f0276-l39"/>und nun hörten allmälig die Gemmensiegel auf und der plauische <name type="organism" ref="#organism-loewe">Löwe</name>, den, <lb n="40" facs="#f0276-l40"/>wie es scheint, stets nur das älteste Glied des plauischen Hauses führte, ver<lb n="41" break="no" facs="#f0276-l41"/>wandelte sich in den allen Linien gemeinschaftlichen pfälzischen <name type="organism" ref="#organism-loewe">Löwen</name> (Gold in <lb n="42" facs="#f0276-l42"/>Schwarz), der einschwänzig, nicht zweischwänzig ist. Diesem Wappen fügte im <lb n="43" facs="#f0276-l43"/>Anfange des 15. Jahrhunderts die Linie <placeName ref="#place-gera">Gera</placeName> und darauf auch die Linie <placeName ref="#place-weida">Weida</placeName> <lb n="44" facs="#f0276-l44"/>auf <placeName ref="#place-wildenfels">Wildenfels</placeName> das Brackenkleinod hinzu. Ob dasselbe von den Herrn von <lb n="45" facs="#f0276-l45"/>Tannroda, die eine Zeit lang <placeName ref="#place-reichenfels">Reichenfels</placeName> besaßen, oder von den Burggrafen von <lb n="46" facs="#f0276-l46"/><placeName ref="#place-nuernberg">Nürnberg</placeName>, die wie jene den Brackenkopf im Wappen führten, wegen des <placeName ref="#place-regnitzland">Regnitz<lb n="47" break="no" facs="#f0276-l47"/>landes</placeName> angenommen oder woher es sonst gekommen ist, läßt sich schwer ermitteln. <lb n="48" facs="#f0276-l48"/>Mit dem Erwerb der Herrschaft <placeName ref="#place-kranichfeld">Kranichfeld</placeName>, welche die Herrn Reuß von <lb n="49" facs="#f0276-l49"/>1451—1615 besaßen, kam der <name type="organism" ref="#organism-kranich">Kranich</name> als Schlußstein in das reußische Wappen.</p>
<p xml:id="p264-b6"><lb n="50" facs="#f0276-l50"/>Das Wappen, welches Kaiser <persName ref="#person-ferdinand-i">Ferdinand</persName> den 6. December 1561 <persName ref="#person-heinrich-d-ae-reuss-herr-zu-untergreiz-der-botschafter">Heinrich <lb n="51" facs="#f0276-l51"/>dem älteren</persName>, <persName ref="#person-heinrich-d-m-reuss-herr-zu-obergreiz">Heinrich dem mittleren</persName> und <persName ref="#person-heinrich-d-j-reuss-herr-von-gera-1530-1572">Heinrich dem jüngeren</persName> Reuß-Plauen</p>
</div></body></text>
