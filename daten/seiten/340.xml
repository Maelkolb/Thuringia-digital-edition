52-l19" type="line" n="19" ulx="148" uly="984" lrx="1492" lry="1024"/><zone xml:id="f0352-l20" type="line" n="20" ulx="146" uly="1024" lrx="1493" lry="1068"/><zone xml:id="f0352-l21" type="line" n="21" ulx="145" uly="1065" lrx="1490" lry="1109"/><zone xml:id="f0352-l22" type="line" n="22" ulx="145" uly="1109" lrx="1490" lry="1153"/><zone xml:id="f0352-l23" type="line" n="23" ulx="146" uly="1150" lrx="1493" lry="1194"/><zone xml:id="f0352-l24" type="line" n="24" ulx="143" uly="1193" lrx="1490" lry="1237"/><zone xml:id="f0352-l25" type="line" n="25" ulx="143" uly="1237" lrx="1492" lry="1279"/><zone xml:id="f0352-l26" type="line" n="26" ulx="146" uly="1278" lrx="1493" lry="1322"/><zone xml:id="f0352-l27" type="line" n="27" ulx="146" uly="1324" lrx="1492" lry="1365"/><zone xml:id="f0352-l28" type="line" n="28" ulx="143" uly="1366" lrx="1405" lry="1408"/><zone xml:id="f0352-l29" type="line" n="29" ulx="229" uly="1408" lrx="1492" lry="1451"/><zone xml:id="f0352-l30" type="line" n="30" ulx="145" uly="1449" lrx="998" lry="1493"/><zone xml:id="f0352-l31" type="line" n="31" ulx="215" uly="1554" lrx="1492" lry="1598"/><zone xml:id="f0352-l32" type="line" n="32" ulx="145" uly="1589" lrx="1076" lry="1632"/></surface></facsimile>
<text><body><div type="page" n="340"><pb n="340" facs="#f0352"/>
<fw type="header" place="top">V. Geschichte des Landes und seines Fürstenhauses.</fw>
<p xml:id="p340-b1"><lb n="1" facs="#f0352-l1"/>ältere das <rs type="concept" ref="#concept-schloss-hauenstein">Schloss Hauenstein</rs>, verkaufte jedoch 1454 dasselbe, wie dies schon <lb n="2" facs="#f0352-l2"/>früher mit <placeName ref="#place-schmoelln">Schmölln</placeName> und wahrscheinlich auch mit Drisels geschehen war, so <lb n="3" facs="#f0352-l3"/>dass nur <placeName ref="#place-wildenfels">Wildenfels</placeName> als einziger Besitz des Hauses Weida übrig blieb. <persName ref="#person-heinrich-d-ae">Heinrich <lb n="4" facs="#f0352-l4"/>d. ä.</persName> starb, nachdem er noch den 28. Februar 1476 mit der Herrschaft <placeName ref="#place-greiz">Greiz</placeName> <lb n="5" facs="#f0352-l5"/>mitbelehnt worden war, zwischen 1476 und 1485, sicher hochbejahrt, aber mehr <lb n="6" facs="#f0352-l6"/>als ein stilllebiger, denn als ein öffentlich wirksamer Character. Von seinen <lb n="7" facs="#f0352-l7"/>drei Söhnen, <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName>, <persName ref="#person-heinrich-d-m">Heinrich d. m.</persName> und <persName ref="#person-heinrich-d-j">Heinrich d. j.</persName>, den Erben von <lb n="8" facs="#f0352-l8"/><placeName ref="#place-wildenfels">Wildenfels</placeName>, wandten der ältere und der mittlere ihre Tätigkeit dem Auslande, <lb n="9" facs="#f0352-l9"/>namentlich dem energischen hohenzollernschen Hause <placeName ref="#place-brandenburg">Brandenburg</placeName> zu, wo sie <lb n="10" facs="#f0352-l10"/>öfters in Urkunden getroffen werden. Vor Allen war es aber <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName>, <lb n="11" facs="#f0352-l11"/>welcher als Rath des brandenburgischen Kurfürsten bedeutenden Einfluss und <lb n="12" facs="#f0352-l12"/>neue Besitzungen gewann, wie er denn im December 1512 dem <orgName ref="#organisation-johannesstift-tangermuende">Johannesstifte <lb n="13" facs="#f0352-l13"/>zu Tangermünde</orgName> Zinsen im Amte <placeName ref="#place-altenplotho">Altenplotho</placeName>, namentlich zu <placeName ref="#place-genthin">Genthin</placeName>, ver<lb n="14" break="no" facs="#f0352-l14"/>pfändete und am 6. December 1519 mit Andern im Namen des Kurfürsten <lb n="15" facs="#f0352-l15"/><persName ref="#person-joachim">Joachim</persName> und des Erzbischofs <persName ref="#person-albrecht-von-mainz-und-magdeburg">Albrecht von Mainz und Magdeburg</persName> Irrungen <lb n="16" facs="#f0352-l16"/>zwischen dem <orgName ref="#organisation-domkapitel-brandenburg">Domkapitel zu Brandenburg</orgName> und einem <persName ref="#person-hermann-grabow">Hermann Grabow</persName> schlich<lb n="17" break="no" facs="#f0352-l17"/>tete. <persName ref="#person-heinrich-d-m">Heinrich d. m.</persName> starb kurz vor 1510, <persName ref="#person-heinrich-d-j">Heinrich d. j.</persName> im Jahre 1510, <lb n="18" facs="#f0352-l18"/>beide ohne Nachkommen; dagegen <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName>, mit <persName ref="#person-margarethe-von-mansfeld">Margarethe von Mans<lb n="19" break="no" facs="#f0352-l19"/>feld</persName> vermählt, erst nach 1519, einen Sohn und zwei Töchter hinterlassend. <lb n="20" facs="#f0352-l20"/>Beide Töchter, <persName ref="#person-elisabeth">Elisabeth</persName> und <persName ref="#person-brigitte">Brigitte</persName>, wurden Nonnen, jene zuerst im <orgName ref="#organisation-stift-quedlinburg">Stifte <lb n="21" facs="#f0352-l21"/>zu Quedlinburg</orgName>, dann 1504 Aebtissin zu <placeName ref="#place-gernrode">Gernrode</placeName>, wo sie 1521 die Refor<lb n="22" break="no" facs="#f0352-l22"/>mation einführt und am 11. April 1532 stirbt, diese in <placeName ref="#place-gernrode">Gernrode</placeName>. Ihr Bruder, <lb n="23" facs="#f0352-l23"/><persName ref="#person-heinrich-von-weida-zu-wildenfels-um-1535">Heinrich von Weida zu Wildenfels</persName>, im Jahre 1527 unter den Mitbelehnten <lb n="24" facs="#f0352-l24"/>der Herrschaft <placeName ref="#place-greiz">Greiz</placeName> genannt, beschloss, weil aus seiner Ehe nur eine Tochter, <lb n="25" facs="#f0352-l25"/>keine Söhne hervorgingen, als letzter männlicher Erbe um 1535<note place="foot" n="*)" xml:id="p340-fn1" facs="#f0352-fn1"><lb n="31" facs="#f0352-l31"/>Sicher vor dem 4. Juli 1537, wo bei der Beleihung mit <placeName ref="#place-greiz">Greiz</placeName> und den geraischen <lb n="32" facs="#f0352-l32"/>Lehen nur die Linien <placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-plauen">Plauen</placeName> und Reuss vorhanden sind.</note> das Haus <lb n="26" facs="#f0352-l26"/>Weida. Seine Tochter <persName ref="#person-margaretha">Margaretha</persName>, die an den Grafen <persName ref="#person-johann-heinrich-von-schwarzburg-leutenberg-graf">Johann Heinrich von <lb n="27" facs="#f0352-l27"/>Schwarzburg-Leutenberg</persName> vermählt war und nach 1562 starb, wurde die Erbin <lb n="28" facs="#f0352-l28"/>von <placeName ref="#place-wildenfels">Wildenfels</placeName>, das ihr Gemahl an die Herrn von <placeName ref="#place-wildenfels">Wildenfels</placeName> verkaufte.</p>
<p xml:id="p340-b2"><lb n="29" facs="#f0352-l29"/>Von dem ursprünglich reichen Besitze der Linie Weida sind nur die Güter <lb n="30" facs="#f0352-l30"/><placeName ref="#place-tinz">Tinz</placeName> und <placeName ref="#place-caaschwitz">Caaschwitz</placeName> dem Hause Reuss verblieben.</p>
</div></body></text>
