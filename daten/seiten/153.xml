" lrx="586" lry="2125"/><zone xml:id="f0165-l45" type="line" n="45" ulx="82" uly="2136" lrx="489" lry="2170"/><zone xml:id="f0165-l46" type="line" n="46" ulx="84" uly="2178" lrx="342" lry="2212"/><zone xml:id="f0165-l47" type="line" n="47" ulx="85" uly="2220" lrx="735" lry="2254"/><zone xml:id="f0165-l48" type="line" n="48" ulx="775" uly="2220" lrx="1026" lry="2254"/><zone xml:id="f0165-l49" type="line" n="49" ulx="772" uly="2262" lrx="1420" lry="2296"/><zone xml:id="f0165-l50" type="line" n="50" ulx="810" uly="2306" lrx="1119" lry="2340"/><zone xml:id="f0165-l51" type="line" n="51" ulx="775" uly="2347" lrx="1186" lry="2381"/><zone xml:id="f0165-l52" type="line" n="52" ulx="774" uly="2389" lrx="1345" lry="2423"/></surface></facsimile>
<text><body><div type="page" n="153"><pb n="153" facs="#f0165"/>
<fw type="header" place="top">3. Die Mundart.</fw>
<p xml:id="p153-b1"><lb n="1" facs="#f0165-l1"/>Hingerärschlich = rückwärts.<lb/><lb n="2" facs="#f0165-l2"/>Hisch = wohl, behaglich.<lb/><lb n="3" facs="#f0165-l3"/>Höhler = Felsenkeller.<lb/><lb n="4" facs="#f0165-l4"/>Höhlerbier = <rs type="concept" ref="#concept-bier">Lagerbier</rs>.<lb/><lb n="5" facs="#f0165-l5"/>Husten = nicht zu Willen sein.<lb/><lb n="6" facs="#f0165-l6"/>Huzen gehn = Besuche machen ohne <lb n="7" facs="#f0165-l7"/>Arbeit.<lb/><lb n="8" facs="#f0165-l8"/>Käsehitsche = <rs type="concept" ref="#concept-kinderschlitten">Kinderschlitten</rs>.<lb/><lb n="9" facs="#f0165-l9"/>Kämpte = Kemenade.<lb/><lb n="10" facs="#f0165-l10"/>Kannelholz = <rs type="concept" ref="#concept-topfbrett">Topfbrett</rs>.<lb/><lb n="11" facs="#f0165-l11"/>Kinnel = Mündel.<lb/><lb n="12" facs="#f0165-l12"/>Kischen = wegjagen.<lb/><lb n="13" facs="#f0165-l13"/>Klecken = ausreichen.<lb/><lb n="14" facs="#f0165-l14"/>Klett = eine mit Leimruthen besetzte <lb n="15" facs="#f0165-l15"/><rs type="concept" ref="#concept-stange">Stange</rs> zum Vogelfang.<lb/><lb n="16" facs="#f0165-l16"/>Knacken = stöhnen.<lb/><lb n="17" facs="#f0165-l17"/>Köhlen = wiederkauen.<lb/><lb n="18" facs="#f0165-l18"/>Koller = <rs type="concept" ref="#concept-jacke">Jacke</rs>.<lb/><lb n="19" facs="#f0165-l19"/>Kopfsättel = <rs type="concept" ref="#concept-kopftuch">Kopftuch</rs> der Weiber.<lb/><lb n="20" facs="#f0165-l20"/>Kräppisch = ärgerlich.<lb/><lb n="21" facs="#f0165-l21"/>Krautern = hantiren.<lb/><lb n="22" facs="#f0165-l22"/>Kressen, kresten = vor Schmerz stöhnen.<lb/><lb n="23" facs="#f0165-l23"/>Krummbein = wilder <name type="organism" ref="#organism-thymian">Thymian</name> und <lb n="24" facs="#f0165-l24"/>Schlachtfest.<lb/><lb n="25" facs="#f0165-l25"/>Kuckschen = Hülsen.<lb/><lb n="26" facs="#f0165-l26"/>Kuhhase = <name type="organism" ref="#organism-kaninchen">Kaninchen</name>.<lb/><lb n="27" facs="#f0165-l27"/>Kutter = Rinde.<lb/><lb n="28" facs="#f0165-l28"/>Laschen = prügeln.<lb/><lb n="29" facs="#f0165-l29"/>Latschen = schleppend gehen.<lb/><lb n="30" facs="#f0165-l30"/>Laune = Krankheit.<lb/><lb n="31" facs="#f0165-l31"/>Leichenessen = Mahlzeit bei Beerdi<lb n="32" facs="#f0165-l32"/>gungen.<lb/><lb n="33" facs="#f0165-l33"/>Lehnen = bummeln.<lb/><lb n="34" facs="#f0165-l34"/>Liederlich, lierderlich = elend.<lb/><lb n="35" facs="#f0165-l35"/>Lih = <rs type="concept" ref="#concept-kienlichtpfanne">Kienlichtpfanne</rs>.<lb/><lb n="36" facs="#f0165-l36"/>Lotarr = <rs type="concept" ref="#concept-laterne">Laterne</rs>.<lb/><lb n="37" facs="#f0165-l37"/>Mären = breit sprechen.<lb/><lb n="38" facs="#f0165-l38"/>Mahrla = Mädchen.<lb/><lb n="39" facs="#f0165-l39"/>Mechen = links, falsch.<lb/><lb n="40" facs="#f0165-l40"/>Meiern = zum Besten haben.<lb/><lb n="41" facs="#f0165-l41"/>Mörschel = Kern, z. B. der <name type="organism" ref="#organism-haselnuss">Haselnuß</name>.<lb/><lb n="42" facs="#f0165-l42"/>Molscht = Mahlzeit.<lb/><lb n="43" facs="#f0165-l43"/>Molx = plumper Mensch.<lb/><lb n="44" facs="#f0165-l44"/>Mullwurm = <name type="organism" ref="#organism-feuersalamander">Salamander</name>.<lb/><lb n="45" facs="#f0165-l45"/>Mutz = <rs type="concept" ref="#concept-quark">Quark</rs>, <rs type="concept" ref="#concept-kaese">Käse</rs>.<lb/><lb n="46" facs="#f0165-l46"/>Na = hinab.<lb/><lb n="47" facs="#f0165-l47"/>Nächterle = eine halbe Viertelkanne.<lb/>Naimed = Niemand.<lb/>Nauthem = Athem.<lb/>Nieseln = fein regnen.<lb/>Nischel = Kopf.<lb/>Nisseln = näseln.<lb/>No = hinunter.<lb/>Nog, nogert = nachher.<lb/>Nuckeln = saugen.<lb/>Nuckerle, Nickerle = Schläfchen.<lb/>Nunger = hinunter.<lb/>Nutschen = saugen.<lb/>Obber = aber.<lb/>Odder = aber.<lb/>Olzig = sofort, nun.<lb/>Pampus = Pfannenpolse aus grün geriebenen <name type="organism" ref="#organism-kartoffel">Kartoffeln</name>.<lb/>Papperei = das einem Kinde bei seinem ersten Besuche in einem Nachbarhause geschenkte <rs type="concept" ref="#concept-ei">Ei</rs>, kraft dessen es gut sprechen lernt.<lb/>Peinlich = viel.<lb/>Pelzen = prügeln.<lb/>Perrücke = in der Röhre gebackenes Kartoffelgericht.<lb/>Pfannenpolse = grün geriebene, in der Pfanne gebackene Klöße.<lb/>Pimpelmutter = Hebamme.<lb/>Pinks = Glocke.<lb/>Pist, sist = sonst.<lb/>Polse = Pfannengebäck aus gekochten oder grün geriebenen Kartoffeln.<lb/>Pröpeln = murmeln, Sympathie treiben.<lb/>Präßläber = <rs type="concept" ref="#concept-wurst">Wurst</rs>.<lb/>Quästern = quälen.<lb/>Quitschen, auch questen = oft ein- und ausgehen.<lb/>Ra = hinab.<lb/>Rackerig = ärgerlich.<lb/>Rappeln = sich beeilen.<lb/>Recks = gestreckt.<lb/>Rentsch = Unruhe.<lb/>Ro = hinunter.<lb/>ze Rocken gehn = Besuche mit Arbeit machen.<lb/>Runks = grober Mensch.<lb/>Ruppig = filzig.<lb/>Ruppigel = Geizhals.<lb/>Ruschel = eine Eiszüsche.<lb/>Saller = jener.<lb/><lb n="48" facs="#f0165-l48"/>Salt = dort.<lb/><lb n="49" facs="#f0165-l49"/>Sauber = 1) männliches <name type="organism" ref="#organism-schwein">Schwein</name>, <lb n="50" facs="#f0165-l50"/>2) Schimpfname.<lb/><lb n="51" facs="#f0165-l51"/>Schabhut = <rs type="concept" ref="#concept-strohhut">Strohhut</rs>.<lb/><lb n="52" facs="#f0165-l52"/>Schälle = <rs type="concept" ref="#concept-tasse">Tasse</rs>, kleine <rs type="concept" ref="#concept-schale">Schaale</rs>.</p>
</div></body></text>
