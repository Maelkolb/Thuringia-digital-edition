="f0666-l40" type="line" n="40" ulx="152" uly="2004" lrx="1508" lry="2048"/><zone xml:id="f0666-l41" type="line" n="41" ulx="150" uly="2048" lrx="1508" lry="2089"/><zone xml:id="f0666-l42" type="line" n="42" ulx="150" uly="2088" lrx="1506" lry="2132"/><zone xml:id="f0666-l43" type="line" n="43" ulx="149" uly="2133" lrx="1506" lry="2177"/><zone xml:id="f0666-l44" type="line" n="44" ulx="150" uly="2175" lrx="1508" lry="2219"/><zone xml:id="f0666-l45" type="line" n="45" ulx="152" uly="2218" lrx="1506" lry="2262"/><zone xml:id="f0666-l46" type="line" n="46" ulx="152" uly="2261" lrx="1506" lry="2305"/><zone xml:id="f0666-l47" type="line" n="47" ulx="152" uly="2305" lrx="1506" lry="2346"/><zone xml:id="f0666-l48" type="line" n="48" ulx="149" uly="2346" lrx="1503" lry="2390"/></surface></facsimile>
<text><body><div type="page" n="654"><pb n="654" facs="#f0666"/>
<fw type="header" place="top">Ortskunde des Fürstenthums Reuß j. L.</fw>
<p xml:id="p654-b1"><lb n="1" facs="#f0666-l1"/>Personen zumeist an der Ruhr gestorben sind und daß 1859 ein <rs type="concept" ref="#concept-hagelwetter">Hagelwetter</rs> <lb n="2" facs="#f0666-l2"/>die Flur schädigte. Oberhalb des Dorfes am Fahrwege nach <placeName ref="#place-zeulenroda">Zeulenroda</placeName> zu wird <lb n="3" facs="#f0666-l3"/>ein <name type="organism" ref="#organism-baum">Baum</name> gezeigt, wo ein Bauer vom <rs type="concept" ref="#concept-blitz">Blitze</rs> erschlagen wurde und unterhalb des <lb n="4" facs="#f0666-l4"/>Dorfes am Sandberg steht ein <rs type="concept" ref="#concept-stein">Stein</rs> als Denkmal eines 1855 daselbst Ermor<lb n="5" break="no" facs="#f0666-l5"/>deten. Vor Kurzem hat man eine neue <rs type="concept" ref="#concept-bruecke">steinerne Brücke</rs> über die <name type="nature" ref="#nature-triebes">Triebes</name> erbaut, <lb n="6" facs="#f0666-l6"/>wodurch die Passage bei <rs type="concept" ref="#concept-hochwasser">Hochwasser</rs> nicht mehr wie früher unterbrochen wird.</p>
<p xml:id="p654-b2"><lb n="7" facs="#f0666-l7"/>Zur Gemeinde, <rs type="concept" ref="#concept-kirche">Kirche</rs> und <rs type="concept" ref="#concept-schule">Schule</rs> von <placeName ref="#place-triebes">Triebes</placeName> gehören zwei oberhalb <lb n="8" facs="#f0666-l8"/>desselben liegende isolirte Häusergruppen, der <placeName ref="#place-kranich">Kranich</placeName> und der <placeName ref="#place-zscherlich">Zscherlich</placeName>.</p>
<p xml:id="p654-b3"><lb n="9" facs="#f0666-l9"/>Der Kranich (im Volke „Krannich“), im Westen von <placeName ref="#place-triebes">Triebes</placeName>, auf der <lb n="10" facs="#f0666-l10"/>fernsichtigen Hochwelle zwischen der <name type="nature" ref="#nature-triebes">Triebes</name> und <name type="nature" ref="#nature-weida">Weida</name> in einem sanften matten<lb n="11" break="no" facs="#f0666-l11"/>reichen Sattel, an der Straße von <placeName ref="#place-zeulenroda">Zeulenroda</placeName> nach <placeName ref="#place-weida">Weida</placeName> gelegen, war ur<lb n="12" break="no" facs="#f0666-l12"/>sprünglich ein durch den Straßenverkehr hervorgerufenes Wirthshaus mit dem <lb n="13" facs="#f0666-l13"/><name type="organism" ref="#organism-kranich">Kranich</name> im Schilde, daher der Ortsname. Das Wirthshaus ist noch im Gange. <lb n="14" facs="#f0666-l14"/>Der Ort bestand 1717 aus 3, jetzt aus 8 Häusern mit 74 Einwohnern, die <lb n="15" facs="#f0666-l15"/>meist Weber sind.</p>
<p xml:id="p654-b4"><lb n="16" facs="#f0666-l16"/>Zscherlich (Schertlich, Zschertlich, Zschörtling, im Volke „Zscherlich“), im <lb n="17" facs="#f0666-l17"/>Süden von <placeName ref="#place-triebes">Triebes</placeName> und in der Mitte zwischen <placeName ref="#place-weissendorf">Weißendorf</placeName> und <placeName ref="#place-niederboehmsdorf">Niederböhms<lb n="18" break="no" facs="#f0666-l18"/>dorf</placeName> gelegen, begreift 2 Bauernhöfe mit 10 Einwohnern. Seine Flur greift <lb n="19" facs="#f0666-l19"/>von der <name type="nature" ref="#nature-triebes">Triebes</name> aus über die zeulenrodaer Straße herüber.</p>
<p xml:id="p654-b5"><lb n="20" facs="#f0666-l20"/><placeName ref="#place-weissendorf">Weißendorf</placeName> (ebenso urkundlich, im Volke „Wassendorf“), Schul- und <lb n="21" facs="#f0666-l21"/>Marktort, 1/4 Stunde SO. von <placeName ref="#place-triebes">Triebes</placeName>, auf dem die <name type="nature" ref="#nature-weida">Weida</name> und <name type="nature" ref="#nature-triebes">Triebes</name> <lb n="22" facs="#f0666-l22"/>scheidenden hohen Landrücken, in einer sanften, grasreichen Einsattelung, nahe an <lb n="23" facs="#f0666-l23"/>der weida-zeulenrodaer Straße gelegen, ist zweizeilig gebaut und von SO. nach <lb n="24" facs="#f0666-l24"/>NW. gerichtet. Der isolirte Häusertrupp nach <placeName ref="#place-triebes">Triebes</placeName> zu heißt der Schafberg. <lb n="25" facs="#f0666-l25"/>Vom Orte aus senkt sich ein Gründchen am Kirchsteig zur <name type="nature" ref="#nature-triebes">Triebes</name> und eins (<lb n="26" facs="#f0666-l26"/>der Weidigsgrund) zur <name type="nature" ref="#nature-weida">Weida</name>. <placeName ref="#place-weissendorf">Weißendorf</placeName> umfaßt 1 <rs type="concept" ref="#concept-schule">Schule</rs>, 1 Gemeinde- <lb n="27" facs="#f0666-l27"/>und 1 <rs type="concept" ref="#concept-spritzenhaus">Spritzenhaus</rs>, 68 Privathäuser mit 29 Scheunen, 105 Familien, 442 (<lb n="28" facs="#f0666-l28"/>1861: 418) Einw. und an Vieh 9 <name type="organism" ref="#organism-pferd">Pf.</name>, 138 <name type="organism" ref="#organism-rind">R.</name>, 15 <name type="organism" ref="#organism-schaf">Schf.</name>, 99 <name type="organism" ref="#organism-schwein">Schw.</name>, 61 <name type="organism" ref="#organism-ziege">Z.</name>, <lb n="29" facs="#f0666-l29"/>über 200 <name type="organism" ref="#organism-gans">G.</name>, 35 Bnst. Von den Häusern sind 43 zwei- und 28 einstöckig, <lb n="30" facs="#f0666-l30"/>16 mit <rs type="concept" ref="#concept-schiefer">Schiefer</rs>, 43 mit <rs type="concept" ref="#concept-ziegel">Ziegeln</rs>, 9 mit <rs type="concept" ref="#concept-schindel">Schindeln</rs> und 2 mit <rs type="concept" ref="#concept-stroh">Stroh</rs> gedeckt. <lb n="31" facs="#f0666-l31"/>Der hiesige Rittergutscomplex hat bezüglich seiner Besitzer viel Wechsel ge<lb n="32" break="no" facs="#f0666-l32"/>habt. Bereits vor 1407 war das ansehnliche Rittergut im Besitze der Familie <lb n="33" facs="#f0666-l33"/>Röder, kam dann 1491 um 1000 Gulden rh. an <persName ref="#person-oswald-von-gruena">Oswald von Grüna</persName>, 1493 <lb n="34" facs="#f0666-l34"/>an zwei Brüder v. Rabenstein, 1495 um 1800 Gulden an die v. Dobeneck, <lb n="35" facs="#f0666-l35"/>1599 an die v. Kaufungen, 1643 an <persName ref="#person-marie-salome-v-zehmen">Marie Salome v. Zehmen</persName> und endlich <lb n="36" facs="#f0666-l36"/>um 1750 von deren Nachkommen an den Landesherrn Reuß-Greiz, worauf es <lb n="37" facs="#f0666-l37"/>bald nach 1780 von den Ortsbauern käuflich erworben wurde, von denen 16 <lb n="38" facs="#f0666-l38"/>dasselbe noch inne haben. Zwei zum Gute gehörige Bauerngüter und jüngst <lb n="39" facs="#f0666-l39"/>auch die Ueberreste des Rittergutes sind in den Besitz eines Herrn <persName ref="#person-v-brandenstein-familie">v. Bran<lb n="40" break="no" facs="#f0666-l40"/>denstein</persName> übergegangen. Das am unteren Ende des Dorfes angenehm gelegene <lb n="41" facs="#f0666-l41"/><rs type="concept" ref="#concept-herrnhaus">Herrnhaus</rs> ist nicht mehr bewohnbar. Dem Rittergute, das 1647 mit 4000 <lb n="42" facs="#f0666-l42"/>Mk. angeschlagen war, waren übrigens nur die Erbgerichte über den Ort, da<lb n="43" break="no" facs="#f0666-l43"/>gegen den Besitzern von <placeName ref="#place-reichenfels">Reichenfels</placeName> die Obergerichte zuständig, die von <placeName ref="#place-hohenleuben">Hohen<lb n="44" break="no" facs="#f0666-l44"/>leuben</placeName> aus verwaltet wurden. Die Hoheit hatte stets die Landesherrschaft. Der <lb n="45" facs="#f0666-l45"/>Ort pfarrt und begräbt nach <placeName ref="#place-triebes">Triebes</placeName>. Er hatte übrigens früher einmal, und <lb n="46" facs="#f0666-l46"/>zwar bereits in katholischer Zeit, eine von einem hohenleubner Caplan besorgte <lb n="47" facs="#f0666-l47"/>Kapelle, wie die Kirchenvisitationsacten im Jahre 1533 darthun. Der damalige <lb n="48" facs="#f0666-l48"/>Caplan hieß <persName ref="#person-christoph-kittelmann">Christoph Kittelmann</persName>, der 1534 die Vicarie zu <placeName ref="#place-triebes">Triebes</placeName> überkam.</p>
</div></body></text>
