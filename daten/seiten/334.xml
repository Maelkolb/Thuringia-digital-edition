-l38" type="line" n="38" ulx="160" uly="1963" lrx="1506" lry="2007"/><zone xml:id="f0346-l39" type="line" n="39" ulx="164" uly="2004" lrx="723" lry="2040"/><zone xml:id="f0346-l40" type="line" n="40" ulx="224" uly="2046" lrx="1292" lry="2090"/><zone xml:id="f0346-l41" type="line" n="41" ulx="600" uly="2098" lrx="1066" lry="2135"/><zone xml:id="f0346-l42" type="line" n="42" ulx="585" uly="2250" lrx="1342" lry="2286"/><zone xml:id="f0346-l43" type="line" n="43" ulx="586" uly="2303" lrx="1380" lry="2337"/><zone xml:id="f0346-l44" type="line" n="44" ulx="233" uly="2342" lrx="1507" lry="2386"/><zone xml:id="f0346-l45" type="line" n="45" ulx="161" uly="2378" lrx="741" lry="2421"/></surface></facsimile>
<text><body><div type="page" n="334"><pb n="334" facs="#f0346"/>
<fw type="header" place="top">V. Geschichte des Landes und seines Fürstenhauses.</fw>
<p xml:id="p334-b1"><lb n="1" facs="#f0346-l1"/>welche ihr Vater, der Deutschherr, 1246 nach <placeName ref="#place-preussen">Preußen</placeName> zog, ist ungewiß, doch <lb n="2" facs="#f0346-l2"/>spricht Vieles mehr für den letzteren, der damals auswärts gleichfalls noch den <lb n="3" facs="#f0346-l3"/>Namen v. Weida führte.<note place="foot" n="*)" xml:id="p334-fn1" facs="#f0346-fn1"><lb n="36" facs="#f0346-l36"/>Im Anfange oder in der Mitte 1246 waren die sämmtlichen Brüder noch daheim. <lb n="37" facs="#f0346-l37"/>Die Fahrt des einen von ihnen nach <placeName ref="#place-preussen">Preußen</placeName> kann also nur Ende des Jahres erfolgt <lb n="38" facs="#f0346-l38"/>sein, was weniger auf den damals jung verheiratheten ältesten Bruder, mehr auf den <lb n="39" facs="#f0346-l39"/>mittleren noch unverheiratheten paßt.</note> Durch seine Vermählung mit der Gräfin <persName ref="#person-sophie-von-orlamuenda">Sophie <lb n="4" facs="#f0346-l4"/>von Orlamünda</persName>, Tochter des orlamünder Grafen <persName ref="#person-hermann">Hermann</persName> und der aus dem <lb n="5" facs="#f0346-l5"/>Hause Meran abstammenden <persName ref="#person-beatrix-von-meran">Beatrix</persName> trat <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName> nicht allein mit den <lb n="6" facs="#f0346-l6"/>edelsten Geschlechtern <placeName ref="#place-deutschland">Deutschland</placeName>s in nächste Verwandtschaft**), sondern ward <lb n="7" facs="#f0346-l7"/>auch nach dem Aussterben des meranischen Hauses (1248) dessen Miterbe.<note place="foot" n="***)" xml:id="p334-fn2" facs="#f0346-fn2"><lb n="44" facs="#f0346-l44"/>Dies geschah gleich im Anfange seiner Ehe, die übrigens nicht erst 1247, sondern <lb n="45" facs="#f0346-l45"/>sicher schon um 1244 erfolgt sein muß.</note> <lb n="8" facs="#f0346-l8"/>Das dadurch seinem Hause erblich zugebrachte <placeName ref="#place-regnitzland">Regnitzland</placeName> (größtentheils Lehn, <lb n="9" facs="#f0346-l9"/>kleinerentheils Allod) bildete eine ansehnliche Erweiterung der weidaischen <lb n="10" facs="#f0346-l10"/>Stammgüter und veranlaßte die Nachkommen <persName ref="#person-heinrich-d-ae">Heinrichs d. ä.</persName>, so lange sie im <lb n="11" facs="#f0346-l11"/>Besitze dieses fränkischen Gebietes blieben, ihre Hauptwirksamkeit dahin zu verlegen.</p>
<p xml:id="p334-b2"><lb n="12" facs="#f0346-l12"/>Für fromme Stiftungen hatte <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName> eine reich spendende Hand. <lb n="13" facs="#f0346-l13"/>Im Jahre 1246 begabte er mit seinen Brüdern die Kirche zu <placeName ref="#place-gefell">Gesell</placeName> mit <lb n="14" facs="#f0346-l14"/>Zinsen zu <placeName ref="#place-venzka">Benzka</placeName>, darauf 1258 das <orgName ref="#organisation-kloster-lausnitz">Kloster zu Laußnitz</orgName> mit <placeName ref="#place-schliffstein">Schlißstein</placeName>, 1259 <lb n="15" facs="#f0346-l15"/>mit <placeName ref="#place-reichardtsdorf">Reichardsdorf</placeName> und 1265 das <orgName ref="#organisation-marienkloster-altenburg">Marienkloster zu Altenburg</orgName> mit Gütern zu <lb n="16" facs="#f0346-l16"/><placeName ref="#place-poderschau">Poderschau</placeName> und <placeName ref="#place-remse">Remse</placeName>, mit seiner Gattin 1258 das <orgName ref="#organisation-kloster-pforte">Kloster Pforte</orgName>, 1269 das <lb n="17" facs="#f0346-l17"/><orgName ref="#organisation-marienkloster-altenburg">altenburger Kloster</orgName> mit Gütern zu <placeName ref="#place-buscha">Bussowe</placeName>, 1275 das <orgName ref="#organisation-kloster-gruenhain">Kloster Grünhain</orgName> und <lb n="18" facs="#f0346-l18"/>stiftete 1264 ein Hospital zu <placeName ref="#place-hof">Hof</placeName> und 1267 ein Kloster zu <placeName ref="#place-weida">Weida</placeName>. Seine <lb n="19" facs="#f0346-l19"/>ideale Stimmung, in der er solche Opfer brachte, mag ebenso wie die seines <lb n="20" facs="#f0346-l20"/>Vaters und seiner Stiefmutter, welche ihre Kinder verlassen und sich dem <lb n="21" facs="#f0346-l21"/>Dienste der Kirche gewidmet hatten, unseren Tagen befremdlich erscheinen, in <lb n="22" facs="#f0346-l22"/>jenen Zeiten entsprach sie dem Herzenstriebe der Nation. Neben dieser Wirk<lb n="23" break="no" facs="#f0346-l23"/>samkeit für das kirchliche Leben hatte <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName> zugleich die bürgerliche <lb n="24" facs="#f0346-l24"/>Sicherheit seines Landes im Auge, was um so wohlthätiger war, als seine <lb n="25" facs="#f0346-l25"/>Regierung in die Zeit des Interregnums fiel, in jene unselige Periode (1254 <lb n="26" facs="#f0346-l26"/>bis 1273), wo in <placeName ref="#place-deutschland">Deutschland</placeName> nach dem Untergange der Hohenstaufen aus<lb n="27" break="no" facs="#f0346-l27"/>wärtige, für das deutsche Reich und Wohl ohnmächtige Könige regierten, unter <lb n="28" facs="#f0346-l28"/>denen die Faust des Stärkeren Gesetz und Ordnung zertrümmerte und vom <lb n="29" facs="#f0346-l29"/>Raub lebte. Da die Hilfe der Könige fehlte, schlossen Städte und ebenso <lb n="30" facs="#f0346-l30"/>Fürsten und Herrn unter sich Bündnisse zur Bändigung und Abwehr der <lb n="31" facs="#f0346-l31"/>wilden Unordnung. In <placeName ref="#place-thueringen">Thüringen</placeName> vereinigte sich Markgraf <persName ref="#person-heinrich-der-erlauchte-markgraf-von-meissen">Heinrich der <lb n="32" facs="#f0346-l32"/>Erlauchte</persName> mit den Großen des Landes und unter diesen mit den Voigten von <lb n="33" facs="#f0346-l33"/><placeName ref="#place-weida">Weida</placeName>, <placeName ref="#place-plauen">Plauen</placeName> und <placeName ref="#place-gera">Gera</placeName> zu gegenseitigem Schutze in dem sog. grimmaischen <lb n="34" facs="#f0346-l34"/>Vertrage des Jahres 1254. Wie im Inneren seines Landes, so hatte sich <lb n="35" facs="#f0346-l35"/><persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName> auch nach Außen Geltung verschafft, wie er denn 1256 und 1257</p>
<p xml:id="p334-b3">**) <lb n="40" facs="#f0346-l40"/>Seine Verwandtschaft mit den Hohenstaufen zeigt folgende Tabelle:</p>
<ab type="heading" xml:id="p334-b4" facs="#f0346-b4"><lb n="41" facs="#f0346-l41"/>Kaiser <persName ref="#person-friedrich-i">Friedrich I.</persName>, † 1190.</ab>
<table xml:id="p334-b5" facs="#f0346-b5" rows="4" cols="3"><row><cell>K. <persName ref="#person-heinrich-vi">Heinrich VI.</persName>, † 1197.</cell><cell><persName ref="#person-otto">Otto</persName>, Pfalzgraf v. <placeName ref="#place-burgund">Burgund</placeName>, † 1200.</cell><cell>K. <persName ref="#person-philipp-von-schwaben">Philipp</persName>. † 1208.</cell></row><row><cell>K. <persName ref="#person-friedrich-ii">Friedrich II.</persName>, † 1250.</cell><cell><persName ref="#person-beatrix-von-meran">Beatrix</persName>, Gem. 1208 <persName ref="#person-otto-i-von-meran">Otto I. von Meran</persName>.</cell><cell></cell></row><row role="label"><cell cols="3"><persName ref="#person-beatrix-von-meran">Beatrix</persName>, Gem. Graf <persName ref="#person-hermann-v-orlamuende">Hermann v. Orlamünda</persName>.</cell></row><row role="label"><cell cols="3"><persName ref="#person-sophie">Sophie</persName>, Gem. <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName>, Voigt von <placeName ref="#place-weida">Weida</placeName>.</cell></row></table>
</div></body></text>
