"86" uly="2019" lrx="1432" lry="2063"/><zone xml:id="f0273-l41" type="line" n="41" ulx="85" uly="2061" lrx="1429" lry="2104"/><zone xml:id="f0273-l42" type="line" n="42" ulx="85" uly="2102" lrx="1432" lry="2146"/><zone xml:id="f0273-l43" type="line" n="43" ulx="83" uly="2145" lrx="1430" lry="2189"/><zone xml:id="f0273-l44" type="line" n="44" ulx="85" uly="2189" lrx="1430" lry="2233"/><zone xml:id="f0273-l45" type="line" n="45" ulx="83" uly="2232" lrx="1432" lry="2276"/><zone xml:id="f0273-l46" type="line" n="46" ulx="85" uly="2275" lrx="1430" lry="2319"/><zone xml:id="f0273-l47" type="line" n="47" ulx="159" uly="2363" lrx="1429" lry="2407"/></surface></facsimile>
<text><body><div type="page" n="261"><pb n="261" facs="#f0273"/>
<fw type="header" place="top">7. Handel und Verkehr.</fw>
<p xml:id="p261-b1"><lb n="1" facs="#f0273-l1"/><placeName ref="#place-gera">Gera</placeName> fast ausschließlich allein. Ueber die Grenze des Landes gehen <rs type="concept" ref="#concept-milch">Milch</rs>, <lb n="2" facs="#f0273-l2"/><rs type="concept" ref="#concept-ei">Eier</rs> und <rs type="concept" ref="#concept-butter">Butter</rs>, Ziegenfellchen<note place="foot" n="*)" xml:id="p261-fn1" facs="#f0273-fn1"><lb n="47" facs="#f0273-l47"/>Von <placeName ref="#place-wurzbach">Wurzbach</placeName> und <placeName ref="#place-ebersdorf">Ebersdorf</placeName> gehen jährlich mehrere tausend Fellchen nach <placeName ref="#place-leipzig">Leipzig</placeName>.</note>, <rs type="concept" ref="#concept-bier">Bier</rs>, <rs type="concept" ref="#concept-baeckerwaare">Bäckerwaaren</rs> und <rs type="concept" ref="#concept-wurst">Wurst</rs>, <rs type="concept" ref="#concept-zwirn">Zwirn</rs> und <lb n="3" facs="#f0273-l3"/><rs type="concept" ref="#concept-strumpf">Strümpfe</rs>, <rs type="concept" ref="#concept-holzschuh">Holzschuhe</rs> und <rs type="concept" ref="#concept-spinnrad">Spinnräder</rs>, <name type="organism" ref="#organism-kraut">Waldkräuter</name> und <name type="organism" ref="#organism-zierpflanze">Zierpflanzen</name>, ebensogut <lb n="4" facs="#f0273-l4"/>als <rs type="concept" ref="#concept-eisen">Eisen</rs>, <rs type="concept" ref="#concept-schiefer">Schiefer</rs>, <rs type="concept" ref="#concept-sandstein">Sandstein</rs>, <rs type="concept" ref="#concept-farbenerde">Farberden</rs>, chemische Fabrikate, <rs type="concept" ref="#concept-holz">Holz</rs>, <name type="organism" ref="#organism-tabak">Tabak</name>, <lb n="5" facs="#f0273-l5"/><rs type="concept" ref="#concept-leder">Leder</rs>, <rs type="concept" ref="#concept-leinwand">Leinwand</rs>, <name type="organism" ref="#organism-vieh">Mastvieh</name>, wollene und baumwollene Waaren, <rs type="concept" ref="#concept-harmonika">Harmonicas</rs> und <lb n="6" facs="#f0273-l6"/><rs type="concept" ref="#concept-maschine">Maschinen</rs>, wie umgekehrt Metallwaaren, <rs type="concept" ref="#concept-steinkohle">Steinkohlen</rs>, <rs type="concept" ref="#concept-glas">Glas</rs>, rohe Häute, <lb n="7" facs="#f0273-l7"/>Colonialwaaren, <name type="organism" ref="#organism-fisch">Seefische</name>, Tabak, <rs type="concept" ref="#concept-wein">Wein</rs>, Branntwein, Bier, <rs type="concept" ref="#concept-wolle">Wolle</rs>, <rs type="concept" ref="#concept-baumwolle">Baumwolle</rs> <lb n="8" facs="#f0273-l8"/>und <name type="organism" ref="#organism-getreide">Getreide</name> eingeführt werden. Der binnenländische Handel liefert seine <lb n="9" facs="#f0273-l9"/>Waaren einerseits nach <placeName ref="#place-leipzig">Leipzig</placeName> und <placeName ref="#place-plauen">Plauen</placeName> und über diese Punkte nach <placeName ref="#place-norddeutschland">Nord<lb n="10" break="no" facs="#f0273-l10"/>deutschland</placeName>, andererseits nach <placeName ref="#place-sueddeutschland">Süddeutschland</placeName> bis zur <placeName ref="#place-schweiz">Schweiz</placeName> und nach <placeName ref="#place-frankreich">Frank<lb n="11" break="no" facs="#f0273-l11"/>reich</placeName>. Die Absatzwege des überseeischen Handels führten früher über <placeName ref="#place-bremen">Bremen</placeName> <lb n="12" facs="#f0273-l12"/>und <placeName ref="#place-hamburg">Hamburg</placeName> nach <placeName ref="#place-amerika">Amerika</placeName> und <placeName ref="#place-asien">Asien</placeName>, jetzt haben sich dieselben verändert und <lb n="13" facs="#f0273-l13"/>vermehrt. Von den 1867 zu <placeName ref="#place-gera">Gera</placeName> erfolgten 266 Declarationen lauteten 225 <lb n="14" facs="#f0273-l14"/>auf <placeName ref="#place-windisch-warnow">Windisch-Warnow</placeName>, 10 auf <placeName ref="#place-bremen">Bremen</placeName>, 1 auf <placeName ref="#place-geestemuende">Geestemünde</placeName>, 7 auf <placeName ref="#place-bremerhaven">Bremer<lb n="15" break="no" facs="#f0273-l15"/>haven</placeName>, 6 auf <placeName ref="#place-schaidt">Schaidt</placeName>, 1 auf <placeName ref="#place-passau">Passau</placeName>, 1 auf <placeName ref="#place-boitersreuth">Boitersreuth</placeName>, 13 auf <placeName ref="#place-herbesthal">Herbesthal</placeName> <lb n="16" facs="#f0273-l16"/>und 2 auf <placeName ref="#place-harburg">Harburg</placeName>.</p>
<p xml:id="p261-b2"><lb n="17" facs="#f0273-l17"/>Ueber die Bewegung, welche der binnenländische und überseeische Handel <lb n="18" facs="#f0273-l18"/>des Landes innerhalb der letzten zehn Jahre genommen hat, geben die bei den <lb n="19" facs="#f0273-l19"/>Erledigungsämtern erledigten Begleitscheine, wenn sie auch nur einen Theil der <lb n="20" facs="#f0273-l20"/>Aus- und Einfuhr umfassen, doch ein Resultat, welches auch den Gang des <lb n="21" facs="#f0273-l21"/>übrigen Verkehrs mit characterisirt. Das Ergebniß der erledigten Begleitscheine <lb n="22" facs="#f0273-l22"/>ist nämlich:</p>
<table xml:id="p261-b3" facs="#f0273-b3" rows="6" cols="11"><row role="label"><cell role="label">Erledigungsämter.</cell><cell role="label">Zahl der erledigten Begleitscheine im Jahre</cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell><cell role="label"></cell></row><row><cell></cell><cell>1858.</cell><cell>1859.</cell><cell>1860.</cell><cell>1861.</cell><cell>1862.</cell><cell>1863.</cell><cell>1864.</cell><cell>1865.</cell><cell>1866.</cell><cell>1867.</cell></row><row><cell><placeName ref="#place-gera">Gera</placeName> . .</cell><cell>316</cell><cell>354</cell><cell>342</cell><cell>356</cell><cell>385</cell><cell>440</cell><cell>569</cell><cell>520</cell><cell>559</cell><cell>680</cell></row><row><cell><placeName ref="#place-schleiz">Schleiz</placeName> .</cell><cell>35</cell><cell>30</cell><cell>32</cell><cell>34</cell><cell>15</cell><cell>9</cell><cell>11</cell><cell>11</cell><cell>8</cell><cell>3</cell></row><row><cell><placeName ref="#place-lobenstein">Lobenstein</placeName></cell><cell>18</cell><cell>23</cell><cell>29</cell><cell>27</cell><cell>18</cell><cell>15</cell><cell>13</cell><cell>17</cell><cell>23</cell><cell>9</cell></row><row><cell><placeName ref="#place-hirschberg">Hirschberg</placeName></cell><cell>—</cell><cell>—</cell><cell>—</cell><cell>—</cell><cell>—</cell><cell>—</cell><cell>1</cell><cell>1</cell><cell>1</cell><cell>—</cell></row></table>
<p xml:id="p261-b4"><lb n="29" facs="#f0273-l29"/>Es geht daraus hervor, daß die merkantile Geschäftsthätigkeit des Ober<lb n="30" break="no" facs="#f0273-l30"/>landes in dem letzten Jahrzehnt rückwärts, die des Unterlandes vorwärts <lb n="31" facs="#f0273-l31"/>geschritten ist. Die Ursachen dieser Erscheinung liegen, wie bereits angedeutet, <lb n="32" facs="#f0273-l32"/>hauptsächlich in der verschiedenen Stellung beider Gebiete zu den großen Ver<lb n="33" break="no" facs="#f0273-l33"/>kehrsströmungen. Uebrigens concentrirt sich im Unterlande fast aller Handel <lb n="34" facs="#f0273-l34"/>im Großen und Kleinen auf die Stadt <placeName ref="#place-gera">Gera</placeName>, deren Gesammtverkehr, ohne die <lb n="35" facs="#f0273-l35"/>Geldinstitute, auf zehn und mit denselben auf 100 Millionen Thaler geschätzt <lb n="36" facs="#f0273-l36"/>und von einer lebhaften Industrie, einer starkgliederigen <orgName ref="#organisation-handelskammer">Handelskammer</orgName>, drei <lb n="37" facs="#f0273-l37"/>Geldinstituten und einem <rs type="concept" ref="#concept-eisenbahnnetz">Eisenbahnnetz</rs> getragen, sich nicht allein über das <lb n="38" facs="#f0273-l38"/>Fürstenthum, über die deutschen und europäischen Länder, sondern auch über <lb n="39" facs="#f0273-l39"/>die anderen Erdtheile, namentlich über <placeName ref="#place-asien">Asien</placeName> und <placeName ref="#place-amerika">Amerika</placeName> erstreckt. Das früher <lb n="40" facs="#f0273-l40"/>in <placeName ref="#place-gera">Gera</placeName> bestandene reußische Steueramt ist 1867 in ein Hauptsteueramt des <lb n="41" facs="#f0273-l41"/><orgName ref="#organisation-thueringischer-zollverein">thüringischen Zollvereins</orgName> umgewandelt und damit zugleich ein Packhof mit un<lb n="42" break="no" facs="#f0273-l42"/>bedingten Niederlagerechten eröffnet worden. Außer dem Obercontrolbezirke <lb n="43" facs="#f0273-l43"/><placeName ref="#place-gera">Gera</placeName> besteht für das Land noch ein zweiter zu <placeName ref="#place-schleiz">Schleiz</placeName>. Die dem Geldver<lb n="44" break="no" facs="#f0273-l44"/>kehre dienenden Institute sind die Sparkassen in <placeName ref="#place-gera">Gera</placeName> (seit 1843), in <placeName ref="#place-schleiz">Schleiz</placeName> (<lb n="45" facs="#f0273-l45"/>seit 1842) mit der Filiale in <placeName ref="#place-hohenleuben">Hohenleuben</placeName> (seit 1843) und in <placeName ref="#place-lobenstein">Lobenstein</placeName> (<lb n="46" facs="#f0273-l46"/>seit 1853) mit der Filiale in <placeName ref="#place-hirschberg">Hirschberg</placeName> (seit 1866); die 1855 errichtete</p>
</div></body></text>
