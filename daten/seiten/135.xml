="1394" lry="1810"/><zone xml:id="f0147-l38" type="line" n="38" ulx="43" uly="1807" lrx="1393" lry="1851"/><zone xml:id="f0147-l39" type="line" n="39" ulx="43" uly="1850" lrx="1393" lry="1894"/><zone xml:id="f0147-l40" type="line" n="40" ulx="43" uly="1893" lrx="1397" lry="1937"/><zone xml:id="f0147-l41" type="line" n="41" ulx="44" uly="1936" lrx="1396" lry="1979"/><zone xml:id="f0147-l42" type="line" n="42" ulx="43" uly="1978" lrx="1394" lry="2022"/><zone xml:id="f0147-l43" type="line" n="43" ulx="145" uly="2076" lrx="1396" lry="2120"/><zone xml:id="f0147-l44" type="line" n="44" ulx="43" uly="2114" lrx="205" lry="2158"/><zone xml:id="f0147-l45" type="line" n="45" ulx="122" uly="2154" lrx="469" lry="2198"/><zone xml:id="f0147-l46" type="line" n="46" ulx="103" uly="2191" lrx="1321" lry="2235"/><zone xml:id="f0147-l47" type="line" n="47" ulx="110" uly="2280" lrx="1394" lry="2324"/><zone xml:id="f0147-l48" type="line" n="48" ulx="47" uly="2317" lrx="196" lry="2361"/><zone xml:id="f0147-l49" type="line" n="49" ulx="95" uly="2360" lrx="1091" lry="2404"/></surface></facsimile>
<text><body><div type="page" n="135"><pb n="135" facs="#f0147"/>
<fw type="header" place="top">2. Wohnliche Einrichtung.</fw>
<p xml:id="p135-b1">O <lb n="1" facs="#f0147-l1"/>heiliger Erzengel <persName ref="#person-michael-erzengel">S. Michael</persName> bitt vor mein Volk; und desgleichen führte <lb n="2" facs="#f0147-l2"/>eine geraische (1555 umgegossen) die bekannten Worte: Vox mea vox vite. <lb n="3" facs="#f0147-l3"/>Vos voco, ad sacra venite. Defunctos plango, vivos voco, fulmina frango. <lb n="4" facs="#f0147-l4"/>Von biblischen Sprüchen überlieferte die katholische Zeit nur einen zu <placeName ref="#place-loehma">Löhma</placeName> <lb n="5" facs="#f0147-l5"/>und zwar: Das Blut <persName ref="#person-christus">Jesu Christi</persName> macht uns rein von aller Sünde. Begann <lb n="6" facs="#f0147-l6"/>man am Ausgange des Mittelalters den Glockengießer (1451 <placeName ref="#place-osterstein">Osterstein</placeName><note place="foot" n="*)" xml:id="p135-fn1" facs="#f0147-fn1"><lb n="43" facs="#f0147-l43"/>Der Herr <persName ref="#person-heinrich">Heinrich</persName> ließ setzen mich, das jetzo ich klinge lieblich; <persName ref="#person-hans-brucktberg">Hans Brucktberg</persName> goß mich.</note> und <lb n="7" facs="#f0147-l7"/>den Gutsherrn (1502 <placeName ref="#place-grossaga">Großaga</placeName><note place="foot" n="**)" xml:id="p135-fn2" facs="#f0147-fn2"><lb n="45" facs="#f0147-l45"/><persName ref="#person-hans-von-ezdorf">Hans von Ezdorf</persName>.</note> auf die Glocken zu bringen, so that die <lb n="8" facs="#f0147-l8"/>protestantische Zeit noch mehr. Was die Namen betrifft, so setzte sie an die <lb n="9" facs="#f0147-l9"/>Stelle der Heiligen den Ortspfarrer, Lehrer, Kirchen- oder Ortsvorstand, den <lb n="10" facs="#f0147-l10"/>Gutsherrn, den Gießer, den Gußort (<placeName ref="#place-gera">Gera</placeName>, <placeName ref="#place-zeitz">Zeitz</placeName>, <placeName ref="#place-erfurt">Erfurt</placeName>, <placeName ref="#place-apolda">Apolda</placeName>, <placeName ref="#place-hof">Hof</placeName>, <lb n="11" facs="#f0147-l11"/><placeName ref="#place-schleusingen">Schleusingen</placeName> und <placeName ref="#place-meiningen">Meiningen</placeName>) und das Gußjahr, öfters auch den Ephoren der <lb n="12" facs="#f0147-l12"/>Diöcese und den Landesherrn. Bezüglich der alten Bittformen gab das 16. Jahr<lb n="13" break="no" facs="#f0147-l13"/>hundert meist kurze lateinische Bibelstellen, wie V. D. M. J. E.<note place="foot" n="***)" xml:id="p135-fn3" facs="#f0147-fn3"><lb n="46" facs="#f0147-l46"/>Diese Buchstaben erfuhren von Seiten der Katholiken gehässige Bedeutungen.</note> (<placeName ref="#place-frankenthal">Franken<lb n="14" break="no" facs="#f0147-l14"/>thal</placeName>) oder vollständig Verbum dei manet in aeternum (<placeName ref="#place-koestritz">Köstritz</placeName>) oder Spes <lb n="15" facs="#f0147-l15"/>mea in Christo (<placeName ref="#place-tegau">Tegau</placeName> 1571) oder Gloria in excelsis deo. Von 1650 an <lb n="16" facs="#f0147-l16"/>erweiterte man aber die In- und Aufschriften der Glocken durch kirchliche und <lb n="17" facs="#f0147-l17"/>locale Nachrichten, durch die Geschichte der Glocke, durch mancherlei biblische <lb n="18" facs="#f0147-l18"/>Sprüche, durch gelehrte und grobe Reimereien†), durch Stellen aus neueren <lb n="19" facs="#f0147-l19"/>Dichtern††) und selbst durch französische Phrasen†††), so daß manche neue <lb n="20" facs="#f0147-l20"/>Glocke mit Schriftwerk überschüttet ist. Und nicht genug, man füllte hie und <lb n="21" facs="#f0147-l21"/>da die noch leeren Räume der Glocke mit biblischen Bilddarstellungen aus, <lb n="22" facs="#f0147-l22"/>wie zu <placeName ref="#place-dorna">Dorna</placeName> mit der Kreuzigung und Himmelfahrt Christi und zu <placeName ref="#place-loehma">Löhma</placeName> <lb n="23" facs="#f0147-l23"/>mit <persName ref="#person-christus">Christus</persName> am Kreuze. In der neueren Zeit haben einzelne Glocken in <lb n="24" facs="#f0147-l24"/>Rücksicht auf ihre Inschriften sich wieder dem früheren, durch Einfachheit und <lb n="25" facs="#f0147-l25"/>Ernst ausgezeichneten Character zugewendet.</p>
<p xml:id="p135-b2"><lb n="26" facs="#f0147-l26"/>Wie von Glasmalereien, so hat sich von Wandmalereien aus den Tagen <lb n="27" facs="#f0147-l27"/>der Gothik, mit Ausschlusse der Altarschreinmalereien, sehr wenig erhalten und <lb n="28" facs="#f0147-l28"/>das Wenige ist hie und da vielfach übertüncht. Die Altarschreine, fast ohne <lb n="29" facs="#f0147-l29"/>Ausnahme Marienaltarschreine, haben ihre Verbreitung von <placeName ref="#place-caaschwitz">Caaschwitz</placeName> bis <placeName ref="#place-harra">Harra</placeName> <lb n="30" facs="#f0147-l30"/>und <placeName ref="#place-stelzen">Stelzen</placeName> gehabt und sind bezüglich ihrer Schnitzereien und Malertechnik <lb n="31" facs="#f0147-l31"/>unter einander und mit den im anstoßenden Orlagau in starker Zahl vorkom<lb n="32" break="no" facs="#f0147-l32"/>menden Schreinen übereinstimmend und stammen sicherlich aus ein und der<lb n="33" break="no" facs="#f0147-l33"/>selben Künstlerwerkschule, die ihren Sitz in <placeName ref="#place-saalfeld">Saalfeld</placeName> hatte und wahrscheinlich <lb n="34" facs="#f0147-l34"/>von <placeName ref="#place-nuernberg">Nürnberg</placeName> aus hieher verpflanzt war. Mehrere der Altarschreine geben <lb n="35" facs="#f0147-l35"/>ganz bestimmt <placeName ref="#place-saalfeld">Saalfeld</placeName> als Wohnort der Künstler an. Die Zeit, in welcher <lb n="36" facs="#f0147-l36"/>diese Schule in <placeName ref="#place-saalfeld">Saalfeld</placeName> thätig war, reicht von ca. 1445 bis 1505. Das <lb n="37" facs="#f0147-l37"/>Marienaltargehäus zu <placeName ref="#place-friesau">Friesau</placeName> im greizer Oberlande hat die Jahreszahl 1447, <lb n="38" facs="#f0147-l38"/>das zu <placeName ref="#place-langenberg">Langenberg</placeName> im Unterlande 1486 und das zu <placeName ref="#place-pflanzwirrbach">Pflanzwirrbach</placeName> im Schwarz<lb n="39" facs="#f0147-l39"/>burgischen 1505. Wie auf den Schreinen im Orlagebiete, so gehen auch <lb n="40" facs="#f0147-l40"/>auf denen des <placeName ref="#place-voigtland">Vogtlandes</placeName> die über den Häuptern der Bildsäulen angebrachten <lb n="41" facs="#f0147-l41"/>Baldachine von den Spitzbögen mit Nase und Maßwerk zu den Eselsbrücken<lb n="42" break="no" facs="#f0147-l42"/>bogen und darauf zu den blumigen Ranken und die Bilder von idealer Fassung</p>
<p><note place="foot" n="†)" xml:id="p135-fn4" facs="#f0147-fn4">Durch <rs type="concept" ref="#concept-brand">Feuer</rs> floß ich, <persName ref="#person-sam-pertsch">Sam. Pertsch</persName> in <placeName ref="#place-gera">Gera</placeName> <lb n="44" facs="#f0147-l44"/>goß mich (<placeName ref="#place-duerrenebersdorf">Dürrenebersdorf</placeName>).</note><note place="foot" n="††)" xml:id="p135-fn5" facs="#f0147-fn5"><lb n="47" facs="#f0147-l47"/>Zur Eintracht, zum herzinnigen Vereine, Versammle sie die liebende Gemeine <lb n="48" facs="#f0147-l48"/>(<placeName ref="#place-dorna">Dorna</placeName>).</note><note place="foot" n="†††)" xml:id="p135-fn6" facs="#f0147-fn6"><lb n="49" facs="#f0147-l49"/>Toutes Soneres (sic) Soit Louer Le Bon Dieu A Jamais.</note></p>
</div></body></text>
