8-l38" type="line" n="38" ulx="142" uly="1809" lrx="1487" lry="1852"/><zone xml:id="f0358-l39" type="line" n="39" ulx="142" uly="1851" lrx="1487" lry="1894"/><zone xml:id="f0358-l40" type="line" n="40" ulx="140" uly="1894" lrx="1490" lry="1937"/><zone xml:id="f0358-l41" type="line" n="41" ulx="142" uly="1936" lrx="1490" lry="1979"/><zone xml:id="f0358-l42" type="line" n="42" ulx="142" uly="1980" lrx="1487" lry="2023"/><zone xml:id="f0358-l43" type="line" n="43" ulx="229" uly="2091" lrx="1490" lry="2134"/><zone xml:id="f0358-l44" type="line" n="44" ulx="142" uly="2125" lrx="1000" lry="2168"/><zone xml:id="f0358-l45" type="line" n="45" ulx="212" uly="2166" lrx="752" lry="2209"/><zone xml:id="f0358-l46" type="line" n="46" ulx="196" uly="2208" lrx="1490" lry="2251"/><zone xml:id="f0358-l47" type="line" n="47" ulx="145" uly="2253" lrx="1486" lry="2287"/><zone xml:id="f0358-l48" type="line" n="48" ulx="143" uly="2286" lrx="395" lry="2322"/><zone xml:id="f0358-l49" type="line" n="49" ulx="229" uly="2322" lrx="1318" lry="2365"/><zone xml:id="f0358-l50" type="line" n="50" ulx="215" uly="2364" lrx="1286" lry="2407"/></surface></facsimile>
<text><body><div type="page" n="346"><pb n="346" facs="#f0358"/>
<fw type="header" place="top">V. Geschichte des Landes und seines Fürstenhauses.</fw>
<p xml:id="p346-b1"><lb n="1" facs="#f0358-l1"/><persName ref="#person-wenzel">Wenzel</persName>, verständigt sich 1404 wegen <placeName ref="#place-nordhalben">Nordhalben</placeName> mit dem <orgName ref="#organisation-hochstift-bamberg">Hochstifte Bamberg</orgName> und <lb n="2" facs="#f0358-l2"/>hat 1405 Irrung mit <persName ref="#person-hans-mengersreuther">Hans Mengersreuther</persName>, auf dessen Klage König <persName ref="#person-ruprecht-von-der-pfalz">Ruprecht</persName> <lb n="3" facs="#f0358-l3"/>über ihn die Reichsacht ausspricht. Im Jahre 1411 setzt er seinen Kindern <lb n="4" facs="#f0358-l4"/>Vormünder und begnadigt das <orgName ref="#organisation-kloster-cronswitz">Kloster Cronswitz</orgName> mit einer Stiftung, in Folge <lb n="5" facs="#f0358-l5"/>dessen stellt ihm <persName ref="#person-jutta-von-weida">Jutta von Weida</persName>, Priorin zu <placeName ref="#place-cronswitz">Cronswitz</placeName> und der dasige Con<lb n="6" break="no" facs="#f0358-l6"/>vent einen dreifachen Revers<note place="foot" n="*)" xml:id="p346-fn1" facs="#f0358-fn1"><lb n="43" facs="#f0358-l43"/>In diesem Revers wird erwähnt, daß der Vater <persName ref="#person-heinrich">Heinrichs</persName> des Dispensirten den <lb n="44" facs="#f0358-l44"/>8. December und dessen Mutter den 5. Mai gestorben ist.</note> aus, erstens über die 1376 gemachte Stiftung <lb n="7" facs="#f0358-l7"/>seines Vaters auf Zinsen zu <placeName ref="#place-trebnitz">Trebnitz</placeName> und <placeName ref="#place-schwaara">Schwaara</placeName>, dann über das von <lb n="8" facs="#f0358-l8"/>seiner verstorbenen Schwester <persName ref="#person-dorothea">Dorothea</persName> gestiftete Benefiz und endlich über die <lb n="9" facs="#f0358-l9"/>Stiftung, die er selbst für sich, für seine Gattin <persName ref="#person-lutrada-luitgard-von-hohnstein">Lutrada</persName> und für den Grafen <lb n="10" facs="#f0358-l10"/><persName ref="#person-heinrich">Heinrich</persName>, den Sohn seiner Schwester <persName ref="#person-sophie">Sophie</persName>, mit 250 Goldgülden gemacht hat. <lb n="11" facs="#f0358-l11"/>Sein Tod erfolgte Ende 1419 oder zu Anfang 1420. Er war zweimal ver<lb n="12" break="no" facs="#f0358-l12"/>mählt, zuerst mit der Gräfin <persName ref="#person-elisabeth-von-schwarzburg-blankenburg">Elisabeth von Schwarzburg-Blankenburg</persName>, welche <lb n="13" facs="#f0358-l13"/>1399, kurz vor ihrem Tode, eine <rs type="concept" ref="#concept-kapelle">Kapelle</rs> im <name type="nature" ref="#nature-schleizer-wald">schleizer Walde</name> gründete und <lb n="14" facs="#f0358-l14"/>darauf (seit 1401 oder 1402) mit der hochherzigen Gräfin <persName ref="#person-lutrada-luitgard-von-hohnstein">Lutrada (Luitgard) <lb n="15" facs="#f0358-l15"/>von Hohnstein</persName>. Da er 1397 von seiner ersten Gattin nur einen unmündigen <lb n="16" facs="#f0358-l16"/>Erben hatte, so übertrug König <persName ref="#person-wenzel">Wenzel</persName> für den Fall, daß der geraer Regent <lb n="17" facs="#f0358-l17"/>ohne Leibeserben verstürbe, <placeName ref="#place-lobenstein">Lobenstein</placeName> und die höfer Lehen erst an die Land<lb n="18" break="no" facs="#f0358-l18"/>grafen von <placeName ref="#place-thueringen">Thüringen</placeName>, 1398 aber an die Grafen von <placeName ref="#place-schwarzburg">Schwarzburg</placeName>. Zur Ver<lb n="19" break="no" facs="#f0358-l19"/>mählung mit seiner zweiten Gattin ertheilte ihm der Erzbischof von <placeName ref="#place-mainz">Mainz</placeName> <lb n="20" facs="#f0358-l20"/>die wegen der nahen Verwandtschaft nachgesuchte Dispensation<note place="foot" n="**)" xml:id="p346-fn2" facs="#f0358-fn2"><lb n="45" facs="#f0358-l45"/>Daher der Dispensirte genannt.</note>. Ihn über<lb n="21" break="no" facs="#f0358-l21"/>lebten aus beiden Ehen acht Kinder und zwei Enkel, nämlich aus der ersten <lb n="22" facs="#f0358-l22"/>Ehe zwei Töchter, <persName ref="#person-anna">Anna</persName> und <persName ref="#person-mechtild">Mechtild</persName>, beide Nonnen zu <placeName ref="#place-cronswitz">Cronswitz</placeName>, und zwei <lb n="23" facs="#f0358-l23"/>Enkel, die Kinder seines Ende 1414 verstorbenen ältesten Sohnes, der 1412 <lb n="24" facs="#f0358-l24"/>mit <persName ref="#person-margaretha">Margaretha</persName>, der Tochter des Grafen <persName ref="#person-johann-von-wertheim">Johann von Wertheim</persName>, vermählt<note place="foot" n="***)" xml:id="p346-fn3" facs="#f0358-fn3"><lb n="46" facs="#f0358-l46"/>Bischof <persName ref="#person-albrecht-von-bamberg">Albrecht von Bamberg</persName> hatte 1412 den Ehecontract zwischen der Tochter <lb n="47" facs="#f0358-l47"/>Johanns von Wertheim (seines Vetters) und dem ältesten Sohne <persName ref="#person-heinrich">Heinrichs</persName> des Dispen<lb n="48" break="no" facs="#f0358-l48"/>sirten festgestellt.</note> <lb n="25" facs="#f0358-l25"/>und Vater von zwei Knaben geworden war, deren noch 1422 gedacht wird, <lb n="26" facs="#f0358-l26"/>aber dann nicht mehr, namentlich bei keiner Landestheilung, zu der sie berech<lb n="27" break="no" facs="#f0358-l27"/>tigt waren, wenn sie nach 1422, wo sie und ihr Oheim mit <placeName ref="#place-nordhalben">Nordhalben</placeName> be<lb n="28" break="no" facs="#f0358-l28"/>lehnt werden, als weltliche Herrn†) gelebt hätten; aus der zweiten Ehe außer <lb n="29" facs="#f0358-l29"/>drei Söhnen noch drei Töchter, <persName ref="#person-else">Else</persName>, <persName ref="#person-jutta">Jutta</persName> und <persName ref="#person-anna">Anna</persName>, die beiden ersten ver<lb n="30" break="no" facs="#f0358-l30"/>mählt, aber bald nach Mitte 1426 verstorben, die dritte seit 1417 Nonne im <lb n="31" facs="#f0358-l31"/><orgName ref="#organisation-kloster-cronswitz">Stifte Cronswitz</orgName>.</p>
<p xml:id="p346-b2"><lb n="32" facs="#f0358-l32"/>Von den drei aus zweiter Ehe stammenden Erbsöhnen werden die <lb n="33" facs="#f0358-l33"/>zwei älteren††) 1415 vom thüringer Landgraf <persName ref="#person-friedrich">Friedrich</persName> mit <placeName ref="#place-gera">Gera</placeName>, Sleidicz (<placeName ref="#place-schleiz">Schleiz</placeName>), <lb n="34" facs="#f0358-l34"/><placeName ref="#place-reichenfels">Reichenfels</placeName>, <placeName ref="#place-langenberg">Langenberg</placeName> und einem Theile von <placeName ref="#place-heringen">Heringen</placeName> und alle drei 1420 <lb n="35" facs="#f0358-l35"/>vom König <persName ref="#person-sigismund">Sigismund</persName> mit <placeName ref="#place-lobenstein">Lobenstein</placeName> und den höfer Lehen beliehen. Nachdem <lb n="36" facs="#f0358-l36"/>sich 1424 dieselben mit ihrer Mutter <persName ref="#person-lutrada-luitgard-von-hohnstein">Lutrada</persName> wegen <placeName ref="#place-heringen">Heringen</placeName> unter Ver<lb n="37" break="no" facs="#f0358-l37"/>mittlung des thüringer Landgrafen <persName ref="#person-wilhelm">Wilhelm</persName> verglichen hatten, wird 1425 eine <lb n="38" facs="#f0358-l38"/>Theilung ihrer Lande entworfen und 1426 vollzogen, der zufolge <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName> <lb n="39" facs="#f0358-l39"/><placeName ref="#place-burgk">Burgk</placeName> mit <placeName ref="#place-schleiz">Schleiz</placeName>, <placeName ref="#place-reichenfels">Reichenfels</placeName>, <placeName ref="#place-langenberg">Langenberg</placeName> und <placeName ref="#place-tinz">Tinz</placeName>, <persName ref="#person-heinrich-d-m">Heinrich d. m.</persName> <placeName ref="#place-lobenstein">Loben<lb n="40" break="no" facs="#f0358-l40"/>stein</placeName> mit <placeName ref="#place-saalburg">Saalburg</placeName>, <placeName ref="#place-nordhalben">Nordhalben</placeName>, den höfer Lehen und den <rs type="concept" ref="#concept-weinberg">Weinbergen</rs> bei <lb n="41" facs="#f0358-l41"/><placeName ref="#place-rudolstadt">Rudolstadt</placeName> und <persName ref="#person-heinrich-d-j">Heinrich d. j.</persName> <placeName ref="#place-gera">Gera</placeName> erhielt. Die Bergwerke übrigens und die <lb n="42" facs="#f0358-l42"/>große <rs type="concept" ref="#concept-buechse">Büchse</rs> (Kanone), welche nach <placeName ref="#place-lobenstein">Lobenstein</placeName> gebracht wurde, blieben gemein-</p>
<p><note place="foot" n="†)" xml:id="p346-fn4" facs="#f0358-fn4"><lb n="49" facs="#f0358-l49"/>Möglich, daß einer von ihnen in den Dienst der Kirche getreten war.</note><note place="foot" n="††)" xml:id="p346-fn5" facs="#f0358-fn5"><lb n="50" facs="#f0358-l50"/>Dem jüngsten Bruder, 1415 geboren, wird die Belehnung zugesagt.</note></p>
</div></body></text>
