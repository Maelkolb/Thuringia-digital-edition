="1890" lrx="1407" lry="1934"/><zone xml:id="f0753-l41" type="line" n="41" ulx="52" uly="1932" lrx="1410" lry="1976"/><zone xml:id="f0753-l42" type="line" n="42" ulx="53" uly="1973" lrx="1412" lry="2017"/><zone xml:id="f0753-l43" type="line" n="43" ulx="55" uly="2016" lrx="1409" lry="2060"/><zone xml:id="f0753-l44" type="line" n="44" ulx="53" uly="2060" lrx="1410" lry="2103"/><zone xml:id="f0753-l45" type="line" n="45" ulx="52" uly="2102" lrx="1410" lry="2146"/><zone xml:id="f0753-l46" type="line" n="46" ulx="53" uly="2147" lrx="1410" lry="2191"/><zone xml:id="f0753-l47" type="line" n="47" ulx="52" uly="2188" lrx="1412" lry="2232"/><zone xml:id="f0753-l48" type="line" n="48" ulx="53" uly="2230" lrx="1412" lry="2274"/><zone xml:id="f0753-l49" type="line" n="49" ulx="53" uly="2273" lrx="1413" lry="2316"/><zone xml:id="f0753-l50" type="line" n="50" ulx="53" uly="2317" lrx="1416" lry="2360"/><zone xml:id="f0753-l51" type="line" n="51" ulx="55" uly="2360" lrx="1413" lry="2404"/></surface></facsimile>
<text><body><div type="page" n="741"><pb n="741" facs="#f0753"/>
<fw type="header" place="top">III. Der Landestheil Lobenstein-Ebersdorf.</fw>
<p xml:id="p741-b1"><lb n="1" facs="#f0753-l1"/>ein Bürgermeister und neun Gemeinderathsmitglieder sind, hat weder aktives <lb n="2" facs="#f0753-l2"/>noch passives Vermögen, aber eine Jahresausgabe von 150—200 Thlr. Der <lb n="3" facs="#f0753-l3"/>Grundbesitz der weiteren politischen Gemeinde besteht aus 1 Morgen 132 □<lb n="4" facs="#f0753-l4"/>Ruthen Hutung, circa 25 Thlr. werth; der der engeren, von 39 Bauern <lb n="5" facs="#f0753-l5"/>und 15 Kleinhäuslern gebildet, umfasst 23 Morgen 122 □Ruthen („heil’ge <lb n="6" facs="#f0753-l6"/>Wiese, heil’ge Stauden, <placeName ref="#place-goldbachswiese">Goldbachswiese</placeName>, Hirten- und <placeName ref="#place-ochsenwiese">Ochsenwiese</placeName>“), circa <lb n="7" facs="#f0753-l7"/>1080 Thlr. werth. Die Obergerichte waren landesherrlich und auch größten<lb n="8" break="no" facs="#f0753-l8"/>theils die Erbgerichte; über einige Güter hatte die <orgName ref="#organisation-pfarrei-lobenstein">lobensteiner Pfarrei</orgName> das <lb n="9" facs="#f0753-l9"/>Patrimonalgericht. An Lehen bestanden zumeist Amtslehen, dann Pfarr- und <lb n="10" facs="#f0753-l10"/>Klosterlehen. Zur Flur und Gemeinde gehören vier unfern vom Orte gelegene <lb n="11" facs="#f0753-l11"/>Einzelhäuser:</p>
<p xml:id="p741-b2"><lb n="12" facs="#f0753-l12"/><placeName ref="#place-bellevue">Bellevue</placeName>, ein auf dem höchsten Punkte der von <placeName ref="#place-schoenbrunn">Schönbrunn</placeName> nach <placeName ref="#place-ebersdorf">Ebers<lb n="13" break="no" facs="#f0753-l13"/>dorf</placeName> führenden <rs type="concept" ref="#concept-kunststrasse">Kunststraße</rs> gelegenes, 1783 von <persName ref="#person-heinrich-xxxv-fuerst-reuss-lobenstein">Heinrich XXXV.</persName> in Tempel<lb n="14" break="no" facs="#f0753-l14"/>form erbautes und von <persName ref="#person-heinrich-liv-fuerst-reuss-lobenstein-selbitz">Heinrich LIV.</persName> verschönertes kleines <rs type="concept" ref="#concept-lusthaus">Lusthaus</rs>, der herr<lb n="15" break="no" facs="#f0753-l15"/>lichen Aussicht wegen <placeName ref="#place-bellevue">Bellevue</placeName> genannt, und daneben das <rs type="concept" ref="#concept-forsthaus">Forsthaus</rs> des ebers<lb n="16" break="no" facs="#f0753-l16"/>dorfer Revierförsters, das nach <placeName ref="#place-schoenbrunn">Schönbrunn</placeName> pfarrt und schult. Ursprünglich <lb n="17" facs="#f0753-l17"/>war das <rs type="concept" ref="#concept-forsthaus">Forsthaus</rs> zum Zweck einer in <placeName ref="#place-ebersdorf">Ebersdorf</placeName> errichteten, aus Mangel an <lb n="18" facs="#f0753-l18"/><rs type="concept" ref="#concept-brunnenwasser">Brunnenwasser</rs> nur kurze Zeit bestandenen <orgName ref="#organisation-kaltwasserheilanstalt-langenberg">Kaltwasserheilanstalt</orgName> gegründet.</p>
<p xml:id="p741-b3"><lb n="19" facs="#f0753-l19"/><placeName ref="#place-pohligshaus">Pohligshaus</placeName>, im Volke „Pollershaus“, früher <placeName ref="#place-pohligshaus">Pohligshammer</placeName> genannt, <lb n="20" facs="#f0753-l20"/>weil es angeblich ein <rs type="concept" ref="#concept-eisenhammer">Eisenhammer</rs> gewesen sein soll, liegt im NO. von <placeName ref="#place-schoenbrunn">Schön<lb n="21" break="no" facs="#f0753-l21"/>brunn</placeName>, wohin es pfarrt und schult.</p>
<p xml:id="p741-b4"><lb n="22" facs="#f0753-l22"/>Das <rs type="concept" ref="#concept-wirthshaus-zum-weissen-trutz">Wirthshaus zum weißen Trutz</rs> und dicht dabei der <placeName ref="#place-grauer-affe">grüne oder <lb n="23" facs="#f0753-l23"/>graue Affe</placeName>, beide im Volke der grüne Esel genannt, im SO. von <placeName ref="#place-schoenbrunn">Schön<lb n="24" break="no" facs="#f0753-l24"/>brunn</placeName>, am <rs type="concept" ref="#concept-teich">Kalkteiche</rs> und an der alten <rs type="concept" ref="#concept-heerstrasse">Heerstraße</rs> gelegen, schulen nach <placeName ref="#place-schoenbrunn">Schön<lb n="25" break="no" facs="#f0753-l25"/>brunn</placeName>. Der <rs type="concept" ref="#concept-wirthshaus-zum-weissen-trutz">weiße Trutz</rs> pfarrt nach <placeName ref="#place-lobenstein">Lobenstein</placeName>.</p>
<p xml:id="p741-b5"><lb n="26" facs="#f0753-l26"/>An Einwohnern zählt die Gesammtgemeinde <placeName ref="#place-schoenbrunn">Schönbrunn</placeName> in 125 Familien <lb n="27" facs="#f0753-l27"/>561 (1861: 558) Seelen und an Vieh 287 <name type="organism" ref="#organism-rind">R.</name>, 264 <name type="organism" ref="#organism-schaf">Schf.</name>, 78 <name type="organism" ref="#organism-schwein">Schw.</name>, 46 <name type="organism" ref="#organism-ziege">Z.</name>, <lb n="28" facs="#f0753-l28"/>240 <name type="organism" ref="#organism-gans">G.</name> und 5 Bnst. Ackerbau treiben 39 Familien als Haupt- und 80 als <lb n="29" facs="#f0753-l29"/>Nebengeschäft; 54 sind Gewerbtreibende, darunter 18 Maurer, 12 Schieferdecker <lb n="30" facs="#f0753-l30"/>und Zimmerleute, 3 Schmiede, 2 Fleischer, Schneider, Schuhmacher und Weber, <lb n="31" facs="#f0753-l31"/>1 Bäcker und Böttcher. Die Vermögensverhältnisse sind im Ganzen nicht un<lb n="32" break="no" facs="#f0753-l32"/>günstig. Zwar keine Kapitalisten, aber auch wenig Almosenarme. An Privat<lb n="33" break="no" facs="#f0753-l33"/>grundbesitz bestehen 38 Bauerngüter (13 unter 40, 17 von 40—60 und 8 von <lb n="34" facs="#f0753-l34"/>60—80 Morgen), 24 Grundstücksverbände und 95 ledige Grundstücke. Von den <lb n="35" facs="#f0753-l35"/>Einwohnern (27 Halb-, 12 Viertelsbauern, 51 Häusler, 12 Taglöhner und 19 <lb n="36" facs="#f0753-l36"/>Dienstboten) bauen 49 ihr Jahresbrod. Die Flur begreift 2562½ Morgen. <lb n="37" facs="#f0753-l37"/>Ihre Ergiebigkeit ist zu ⅔ gut. Besser die <rs type="concept" ref="#concept-wiese">Wiesen</rs> als das Feld, namentlich <lb n="38" facs="#f0753-l38"/>dies nach der mageren Mark hin. In ihr 13 <rs type="concept" ref="#concept-teich">Teiche</rs>, 4 <rs type="concept" ref="#concept-steinbruch">Steinbrüche</rs> und 4 <lb n="39" facs="#f0753-l39"/><rs type="concept" ref="#concept-lehmgrube">Lehmgruben</rs>. Hauptflurstücke sind: Gartengelänge, <placeName ref="#place-altenebersdorf">Altenebersdorf</placeName>, Koppen<lb n="40" break="no" facs="#f0753-l40"/>gelänge, <name type="nature" ref="#nature-moosholz">Moosholz</name>, <rs type="concept" ref="#concept-strasse-nach-lobenstein">lobensteiner Straße</rs>, Dorfgelänge, Erlich, Suttenweg, <lb n="41" facs="#f0753-l41"/>Gehren, <name type="nature" ref="#nature-kohlwald">Kohlwald</name>, Losenberg, Dreilinden, <rs type="concept" ref="#concept-teichwiese">Teichwiesen</rs>, Kapfenberg, Harahtknock, <lb n="42" facs="#f0753-l42"/><rs type="concept" ref="#concept-auwiese">Auwiesen</rs>, am <name type="nature" ref="#nature-schwarzer-teich">schwarzen Teich</name>, Pfaffenstücke, <placeName ref="#place-pfaffenwiesen">Pfaffenwiesen</placeName>, Beunten, das untere <lb n="43" facs="#f0753-l43"/>Pohlig. <placeName ref="#place-schoenbrunn">Schönbrunn</placeName>, sicher eine deutsche Ansiedlung, hat seinen Namen jeden<lb n="44" break="no" facs="#f0753-l44"/>falls von der den Ort noch heute auszeichnenden Vorzüglichkeit und Fülle seines <lb n="45" facs="#f0753-l45"/><rs type="concept" ref="#concept-quellwasser">Quellwassers</rs>, daher außer dem „<placeName ref="#place-schoenbrunn">Schönbrunn</placeName>“ daselbst ein Quellenzug der <name type="nature" ref="#nature-goldbach">Gold<lb n="46" break="no" facs="#f0753-l46"/>bach</name> heißt. Leider fehlen über seine Entstehung und historische Entwickelung, <lb n="47" facs="#f0753-l47"/>sogar über seine späteren Geschicke bestimmte Nachrichten. Das bäuerliche Ele<lb n="48" break="no" facs="#f0753-l48"/>ment muß von Anfang an hier ziemlich begütert gewesen sein, weil die Landes<lb n="49" break="no" facs="#f0753-l49"/>herrschaft hier nur eine Schäferei (jetzt dem <placeName ref="#place-kammergut-galenberg">Kammergute Galenberg</placeName> eingethan) <lb n="50" facs="#f0753-l50"/>besaß und außerdem das alte <rs type="concept" ref="#concept-rittergut-ebersdorf">Rittergut Ebersdorf</rs> oder <placeName ref="#place-altenebersdorf">Altenebersdorf</placeName> daselbst <lb n="51" facs="#f0753-l51"/>außer Lehen und Gerechtsamen nur einen mäßigen Grundbesitz hatte, der später</p>
<fw type="sig" place="bottom">48</fw>
</div></body></text>
