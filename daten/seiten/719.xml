-l38" type="line" n="38" ulx="104" uly="1839" lrx="1460" lry="1882"/><zone xml:id="f0731-l39" type="line" n="39" ulx="106" uly="1884" lrx="779" lry="1928"/><zone xml:id="f0731-l40" type="line" n="40" ulx="193" uly="1926" lrx="1461" lry="1970"/><zone xml:id="f0731-l41" type="line" n="41" ulx="101" uly="1969" lrx="1463" lry="2013"/><zone xml:id="f0731-l42" type="line" n="42" ulx="104" uly="2014" lrx="1458" lry="2055"/><zone xml:id="f0731-l43" type="line" n="43" ulx="104" uly="2055" lrx="1461" lry="2099"/><zone xml:id="f0731-l44" type="line" n="44" ulx="104" uly="2096" lrx="1460" lry="2140"/><zone xml:id="f0731-l45" type="line" n="45" ulx="101" uly="2141" lrx="1461" lry="2184"/><zone xml:id="f0731-l46" type="line" n="46" ulx="175" uly="2234" lrx="1460" lry="2278"/><zone xml:id="f0731-l47" type="line" n="47" ulx="161" uly="2274" lrx="1458" lry="2318"/><zone xml:id="f0731-l48" type="line" n="48" ulx="101" uly="2320" lrx="455" lry="2355"/><zone xml:id="f0731-l49" type="line" n="49" ulx="148" uly="2354" lrx="959" lry="2397"/><zone xml:id="f0731-l50" type="line" n="50" ulx="175" uly="2397" lrx="766" lry="2441"/></surface></facsimile>
<text><body><div type="page" n="719"><pb n="719" facs="#f0731"/>
<fw type="header" place="top">III. Der Landestheil Lobenstein-Ebersdorf.</fw>
<p xml:id="p719-b1"><lb n="1" facs="#f0731-l1"/>die Mehrzahl derselben und ist jetzt außer den 3 Geistlichen und 8 Lehrern <lb n="2" facs="#f0731-l2"/>der Sitz 1 <rs type="concept" ref="#concept-superintendentur">Superintendentur</rs>, 2 <orgName ref="#organisation-justizamt">Justizämter</orgName>, 3 Anwälte, 1 Friedensrichters, <lb n="3" facs="#f0731-l3"/>1 Gensd'arms, 1 Physicats, 3 Aerzte, 1 Apothekers, 1 <orgName ref="#organisation-bergamt-zu-lobenstein">Bergamtes</orgName>, 1 <orgName ref="#organisation-steueramt">Steuer<lb n="4" break="no" facs="#f0731-l4"/>amtes</orgName>, 2 Steueraufseher, 1 Revierförsters, 1 <orgName ref="#organisation-sparkasse-zu-schleiz">Sparkassenverwaltung</orgName>, 1 <rs type="concept" ref="#concept-post">Post<lb n="5" break="no" facs="#f0731-l5"/>expedition</rs><note place="foot" n="*)" xml:id="p719-fn1" facs="#f0731-fn1"><lb n="46" facs="#f0731-l46"/>Seit 1751 besteht zu <placeName ref="#place-lobenstein">Lobenstein</placeName> eine <rs type="concept" ref="#concept-post">Post</rs>, zuerst eine reitende, später eine fahrende.</note>, 1 <rs type="concept" ref="#concept-telegraphenbureau">Telegraphenstation</rs>, 3 Chaussee- und <rs type="concept" ref="#concept-bruecke">Brücke</rs>ngeldeinnahmen. Die <lb n="6" facs="#f0731-l6"/>Gemeindebehörde besteht aus dem Gemeindevorstande (<orgName ref="#organisation-stadtrath">Stadtrath</orgName>), der vom Bür<lb n="7" break="no" facs="#f0731-l7"/>germeister und vom Stadtschreiber gebildet wird und die Polizei durch einen <lb n="8" facs="#f0731-l8"/>Polizisten ausübt, und aus dem Gemeinderathe, der außer dem Vertreter der <lb n="9" facs="#f0731-l9"/><orgName ref="#organisation-fuerstliche-kammer">fürstlichen Kammer</orgName> 18 Mitglieder zählt. Das städtische Kassenwesen besorgt ein <lb n="10" facs="#f0731-l10"/>Kämmerer und das Armenwesen eine <orgName ref="#organisation-armencommission">Armencommission</orgName>. Das Gemeindevermögen <lb n="11" facs="#f0731-l11"/>ist vorzüglich durch den <rs type="concept" ref="#concept-brand">Brand</rs> von 1862 mit Schulden belastet. Die Activa <lb n="12" facs="#f0731-l12"/>belaufen sich auf 44,845 Thlr. (7404 Mobilien und 37,444 Immobilien an <lb n="13" facs="#f0731-l13"/><rs type="concept" ref="#concept-garten">Gärten</rs>, <rs type="concept" ref="#concept-feld">Feld</rs>, <rs type="concept" ref="#concept-wiese">Wiesen</rs>, <rs type="concept" ref="#concept-teich">Teichen</rs> und <rs type="concept" ref="#concept-holz">Holz</rs>), die Passiva auf 22,000 und die <lb n="14" facs="#f0731-l14"/>jährlichen Gemeindebedürfnisse (Etat 1869) auf 5800 Thlr., wovon einen großen <lb n="15" facs="#f0731-l15"/>Theil das vom Bürgermeister geleitete Bauwesen erfordert, welches außer den <lb n="16" facs="#f0731-l16"/>Communalhäusern noch kostspielige <rs type="concept" ref="#concept-wasserleitung">Wasserleitungen</rs><note place="foot" n="**)" xml:id="p719-fn2" facs="#f0731-fn2"><lb n="47" facs="#f0731-l47"/>Nennenswerth ist die vom Fuße des <name type="nature" ref="#nature-sieglitzberg">Sieglitzbergs</name> in die Stadt nach dem <rs type="concept" ref="#concept-hain">Hain</rs> <lb n="48" facs="#f0731-l48"/>geführte <rs type="concept" ref="#concept-wasserleitung">Wasserleitung</rs>.</note> mit 13 <rs type="concept" ref="#concept-brunnen">Brunnen</rs>, 4 <lb n="17" facs="#f0731-l17"/>Straßen mit nächtlicher Beleuchtung<note place="foot" n="***)" xml:id="p719-fn3" facs="#f0731-fn3"><lb n="49" facs="#f0731-l49"/>Schon 1784 hatte <placeName ref="#place-lobenstein">Lobenstein</placeName> Laternenbeleuchtung.</note>, 15 Gassen, 5 Vicinal- und 8 Flur<lb n="18" break="no" facs="#f0731-l18"/>wege zu erhalten hat. Auch die in jüngster Zeit verbesserten Feuerlöschanstalten (<lb n="19" facs="#f0731-l19"/>5 größere, 5 kleinere <rs type="concept" ref="#concept-feuerspritze">Spritzen</rs>, 2 Zubringer, viele Schläuche und die Aus<lb n="20" break="no" facs="#f0731-l20"/>rüstung nicht allein eines Feuerwehrcorps von 70 Mann, eines der bestorgani<lb n="21" break="no" facs="#f0731-l21"/>sirten und geübtesten im Lande, sondern auch einer Löschmannschaft von 300 als <lb n="22" facs="#f0731-l22"/>zweiten Aufgebotes) beanspruchen gleichfalls einigen Aufwand. Uebrigens be<lb n="23" break="no" facs="#f0731-l23"/>stand schon 1782 eine 31 Mann umfassende Stadtcompagnie, welche bei Feuers<lb n="24" break="no" facs="#f0731-l24"/>gefahr und an den Jahrmärkten Dienste der Rettung und Ordnung leistete. <lb n="25" facs="#f0731-l25"/><placeName ref="#place-lobenstein">Lobenstein</placeName> hat sechs Jahrmärkte, sechs <name type="organism" ref="#organism-vieh">Vieh</name>märkte und seit 1863 einen Woll<lb n="26" break="no" facs="#f0731-l26"/>markt. Schon im Mittelalter war sie von den Landesherrn mit vier Jahr<lb n="27" break="no" facs="#f0731-l27"/>märkten (Philippi-Jacobi, Pauli-Petri, Michaelis und Andreas), 1656 mit dem <lb n="28" facs="#f0731-l28"/>fünften (Fastnacht) und 1757 mit dem sechsten (Laurentii) begnadigt. Im Jahre <lb n="29" facs="#f0731-l29"/>1783 gewährte ihr Graf <persName ref="#person-heinrich-x">Heinrich X.</persName> sechs besondere Viehmärkte, die nach <lb n="30" facs="#f0731-l30"/>späterer Einrichtung in den Fasten mit den <name type="organism" ref="#organism-getreide">Getreide</name>märkten abgehalten werden.</p>
<p xml:id="p719-b2"><lb n="31" facs="#f0731-l31"/>Unter den Privatgebäuden befinden sich drei Gasthäuser (der <rs type="concept" ref="#concept-bayerischer-hof">bayerische Hof</rs>, <lb n="32" facs="#f0731-l32"/>der <rs type="concept" ref="#concept-goldener-loewe">goldene Löwe</rs> und der <rs type="concept" ref="#concept-reussischer-hof">reußische Hof</rs>), zwei Traiteurhäuser, eine erst jetzt <lb n="33" facs="#f0731-l33"/>gegründete Buchhandlung, eine schon im vorigen Jahrhundert bestandene Buch<lb n="34" break="no" facs="#f0731-l34"/>druckerei, eine Apotheke und ein einziges Fabrikgebäude, wo Tuch bereitet wird. <lb n="35" facs="#f0731-l35"/>An der <name type="nature" ref="#nature-kosel">Kosel</name> liegen vier <rs type="concept" ref="#concept-mahlmuehle">Mahlmühlen</rs> mit <rs type="concept" ref="#concept-schneidemuehle">Schneidemühlen</rs> (die obere, Karls-, <lb n="36" facs="#f0731-l36"/>Mittel-†) und <rs type="concept" ref="#concept-pickertsmuehle">Pickertsmühle</rs>) und im <name type="nature" ref="#nature-lemnitzgrund">Lemnitzgrunde</name> die <placeName ref="#place-herrnmuehle">Herrnmühle</placeName> mit Schneide<lb n="37" break="no" facs="#f0731-l37"/>mühle, zwei <rs type="concept" ref="#concept-tuchfabrik">Tuchfabriken</rs> und zwei <rs type="concept" ref="#concept-walkmuehle">Walkmühlen</rs>, von denen die ältere in der <lb n="38" facs="#f0731-l38"/>Vorstadt bei dem herrschaftlichen Teiche, die jüngere (1800 errichtet) am Ein<lb n="39" break="no" facs="#f0731-l39"/>flusse der <name type="nature" ref="#nature-sieglitz">Sieglitz</name> in die <name type="nature" ref="#nature-lemnitz">Lemnitz</name> liegt.</p>
<p xml:id="p719-b3"><lb n="40" facs="#f0731-l40"/>Die Bevölkerung der Stadt betrug 1509 an 509; 1784: 2243; 1833: <lb n="41" facs="#f0731-l41"/>3274; 1840: 4180; 1846: 3643; 1861: 2972 und 1867 in 687 Familien <lb n="42" facs="#f0731-l42"/>2843 Seelen und der Viehstand 48 Pf., 411 <name type="organism" ref="#organism-rind">R.</name>, 593 Schf., 238 Schw., 247 <lb n="43" facs="#f0731-l43"/>Z., 33 G. und 81 Bnst. Die Volkszunahme bis zum Jahre 1840, trotz des <lb n="44" facs="#f0731-l44"/>Verlustes der Residenz, lag mehr in dem glücklichen Emporbringen einiger <lb n="45" facs="#f0731-l45"/>Industriezweige, namentlich der Tuchfabrikation, der Wollkämmerei und des</p>
<p><note place="foot" n="†)" xml:id="p719-fn4" facs="#f0731-fn4"><lb n="50" facs="#f0731-l50"/>Auch früher <rs type="concept" ref="#concept-pfeffersmuehle">Pfeffersmühle</rs> genannt.</note></p>
</div></body></text>
