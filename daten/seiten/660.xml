"1504" lry="2060"/><zone xml:id="f0672-l44" type="line" n="44" ulx="155" uly="2057" lrx="1505" lry="2101"/><zone xml:id="f0672-l45" type="line" n="45" ulx="156" uly="2101" lrx="1504" lry="2145"/><zone xml:id="f0672-l46" type="line" n="46" ulx="155" uly="2145" lrx="1502" lry="2188"/><zone xml:id="f0672-l47" type="line" n="47" ulx="156" uly="2189" lrx="1507" lry="2230"/><zone xml:id="f0672-l48" type="line" n="48" ulx="156" uly="2229" lrx="1502" lry="2272"/><zone xml:id="f0672-l49" type="line" n="49" ulx="156" uly="2271" lrx="1502" lry="2315"/><zone xml:id="f0672-l50" type="line" n="50" ulx="156" uly="2313" lrx="1502" lry="2357"/><zone xml:id="f0672-l51" type="line" n="51" ulx="158" uly="2356" lrx="1504" lry="2400"/></surface></facsimile>
<text><body><div type="page" n="660"><pb n="660" facs="#f0672"/>
<fw type="header" place="top">Ortskunde des Fürstenthums Reuß j. L.</fw>
<p xml:id="p660-b1"><lb n="1" facs="#f0672-l1"/>und Grenzdorf, 1/2 Stunde westlich von <placeName ref="#place-zeulenroda">Zeulenroda</placeName> und 1/2 Stunde nördlich <lb n="2" facs="#f0672-l2"/>von <placeName ref="#place-langenwolschendorf">Langenwolschendorf</placeName>, in der oberen, hier breiten <rs type="concept" ref="#concept-mulde">Mulde</rs> des <name type="nature" ref="#nature-binnenbach">Binnenbachs</name> (<lb n="3" facs="#f0672-l3"/><name type="nature" ref="#nature-binnenbach">Bingebach</name>) oder <name type="nature" ref="#nature-saugrund">Saugrundes</name>, an der Südwand des <name type="nature" ref="#nature-leitenberg">Leitenbergs</name> gelegen und <lb n="4" facs="#f0672-l4"/>von NO. nach SW. sanft ansteigend, zählt 4 Communalgebäude (1 <rs type="concept" ref="#concept-kirche">Kirche</rs>, 1 <lb n="5" facs="#f0672-l5"/>Brau=, 1 Hirten= und 1 <rs type="concept" ref="#concept-spritzenhaus">Spritzenhaus</rs>), 28 <rs type="concept" ref="#concept-privathaus">Privathäuser</rs> mit 27 <rs type="concept" ref="#concept-scheune">Scheunen</rs>, <lb n="6" facs="#f0672-l6"/>36 Familien, 206 (1861: 202) Seelen und an Vieh 5 <name type="organism" ref="#organism-pferd">Pf.</name>, 197 <name type="organism" ref="#organism-rind">R.</name>, 68 <name type="organism" ref="#organism-schaf">Schf.</name> (<lb n="7" facs="#f0672-l7"/>22 Besitzer), 91 <name type="organism" ref="#organism-schwein">Schw.</name>, 19 <name type="organism" ref="#organism-ziege">Z.</name>, 200 <name type="organism" ref="#organism-gans">G.</name>, 21 <name type="organism" ref="#organism-biene">Bnst.</name> Unter den Häusern sind <lb n="8" facs="#f0672-l8"/>28 zwei= und 4 einstöckig; 17 haben zur Dachung <rs type="concept" ref="#concept-schiefer">Schiefer</rs>, 6 <rs type="concept" ref="#concept-ziegel">Ziegel</rs>, 1 <lb n="9" facs="#f0672-l9"/><rs type="concept" ref="#concept-schindel">Schindeln</rs> und 8 Mischdachung. Der Hauptkern der meist ansehnlichen Bauern<lb n="10" break="no" facs="#f0672-l10"/>höfe liegt ringförmig um einen <rs type="concept" ref="#concept-teich">Teich</rs>. Da steht auch auf freiem, ebenem Platze <lb n="11" facs="#f0672-l11"/>am ummauerten <rs type="concept" ref="#concept-friedhof">Friedhofe</rs> die <rs type="concept" ref="#concept-dorfkirche">Dorfkirche</rs>, ein im Äeußeren und Inneren freund<lb n="12" break="no" facs="#f0672-l12"/>licher, schmallänglicher Bau mit massivem Thurme. Sie ist, nachdem die frühere <lb n="13" facs="#f0672-l13"/>1723 nebst einem großen Theile der Bauernhöfe vom <rs type="concept" ref="#concept-brand">Feuer</rs> verwüstet worden <lb n="14" facs="#f0672-l14"/>war, 1726 neu erbaut und 1846 reparirt worden. In ihr keine Denkmale <lb n="15" facs="#f0672-l15"/>und Bilder, aber eine gute <rs type="concept" ref="#concept-orgel">Orgel</rs>. Von ihren zwei <rs type="concept" ref="#concept-glocke">Glocken</rs>, beide mit In<lb n="16" break="no" facs="#f0672-l16"/>schriften, stammt die größere vom Jahre 1730. Ihre Bücher reichen bis 1568 <lb n="17" facs="#f0672-l17"/>zurück. Ihr Vermögen beträgt 783 4/5 Thlr. Schon 1415 stand hier eine <lb n="18" facs="#f0672-l18"/><rs type="concept" ref="#concept-kapelle">Kapelle</rs>, über deren Gründung indeß nichts bekannt ist. Wie <placeName ref="#place-langenwolschendorf">Langenwolschen<lb n="19" break="no" facs="#f0672-l19"/>dorf</placeName>, so war auch <placeName ref="#place-kleinwolschendorf">Kleinwolschendorf</placeName> kirchlich stets an <placeName ref="#place-zeulenroda">Zeulenroda</placeName> gebunden und <lb n="20" facs="#f0672-l20"/>ist dies noch. Da beide Gemeinden eine Parochie bilden und in gleichem <lb n="21" facs="#f0672-l21"/>Filialverhältnisse zu <placeName ref="#place-zeulenroda">Zeulenroda</placeName> stehen, so gilt hier, was in dieser Beziehung <lb n="22" facs="#f0672-l22"/>bei <placeName ref="#place-langenwolschendorf">Langenwolschendorf</placeName> angegeben ist. Der Ort schult wie früher so heute nach <lb n="23" facs="#f0672-l23"/><placeName ref="#place-langenwolschendorf">Langenwolschendorf</placeName>, gegenwärtig mit circa 40 Kindern und hat 1/3 der Schul<lb n="24" break="no" facs="#f0672-l24"/>bauunkosten zu tragen. Verlangen und Versuch zur Gründung einer eigenen <lb n="25" facs="#f0672-l25"/><rs type="concept" ref="#concept-schule">Schule</rs> lag bisher wohl fern. Im Orte 1 <rs type="concept" ref="#concept-pachtschenke">Pachtschenke</rs>, 1 <rs type="concept" ref="#concept-feuerspritze">Feuerspritze</rs> und 1 <lb n="26" facs="#f0672-l26"/><rs type="concept" ref="#concept-ziegelei">Ziegelei</rs>; auch gehören zum Orte zwei an der <name type="nature" ref="#nature-weida">Weida</name> gelegene, in trockenen <lb n="27" facs="#f0672-l27"/>Jahren oft wasserlose <rs type="concept" ref="#concept-mahl-und-schneidemuehle">Mahl= und Schneidemühlen</rs>, die <rs type="concept" ref="#concept-riedelmuehle">Riedelmühle</rs> im W. <lb n="28" facs="#f0672-l28"/>vom Dorfe da, wo der <name type="nature" ref="#nature-igelsbach">Igelsbach</name> in die <name type="nature" ref="#nature-weida">Weida</name> mündet und im NO. die <lb n="29" facs="#f0672-l29"/><rs type="concept" ref="#concept-starkenmuehle">Starkenmühle</rs>. Bei der <rs type="concept" ref="#concept-riedelmuehle">Riedelmühle</rs> standen vordem <rs type="concept" ref="#concept-eisenhammer">Eisenhämmer</rs>. Die <lb n="30" facs="#f0672-l30"/>Gemeinde hat einen aus Viehtriften, Wegen, 5 <rs type="concept" ref="#concept-teich">Teichen</rs> und einigen <rs type="concept" ref="#concept-wiese">Wiesen</rs> <lb n="31" facs="#f0672-l31"/>bestehenden Grundbesitz von 109 Morgen, im Werthe von 650 Thlr., daneben <lb n="32" facs="#f0672-l32"/>200 Thlr. Schulden und 60 Thlr. Jahresausgabe. Außer der <rs type="concept" ref="#concept-dorfstrasse">Dorfstraße</rs> sind <lb n="33" facs="#f0672-l33"/>hier 4 Communications= und <rs type="concept" ref="#concept-vicinalweg">Vicinalwege</rs>, alle in gutem Zustande. Der bäuer<lb n="34" break="no" facs="#f0672-l34"/>liche Grundbesitz begreift 24 Bauerngüter (6 unter 40, 16 von 40—80 und 2 bis <lb n="35" facs="#f0672-l35"/>100 Morgen), 2 Grundstücksverbände und 19 ledige Grundstücke. <placeName ref="#place-kleinwolschendorf">Kleinwol<lb n="36" break="no" facs="#f0672-l36"/>schendorf</placeName> gehört zu den wenigen Dörfern des <placeName ref="#place-oberland">Oberlandes</placeName>, die größtentheils aus <lb n="37" facs="#f0672-l37"/>Bauern bestehen und die sich schon vor längerer Zeit von ihren Frohnlasten <lb n="38" facs="#f0672-l38"/>befreit haben. Es finden sich hier 22 Bauern, 6 Häusler, von denen 2 nebenbei <lb n="39" facs="#f0672-l39"/>Feldbau treiben, 1 Taglöhner und 14 Dienstboten. Dem Handwerke gehören <lb n="40" facs="#f0672-l40"/>4 Strumpfwirker, 3 Zimmerleute und 1 Tischler, außerdem 2 Müller und 1 <lb n="41" facs="#f0672-l41"/>Ziegler. 24 Familien bauen ihr Jahresbrod und führen <name type="organism" ref="#organism-roggen">Korn</name> und <name type="organism" ref="#organism-vieh">Vieh</name> aus, <lb n="42" facs="#f0672-l42"/>8 Kapitalisten und keine Ortsarmen, demnach der Ort in Wohlhäbigkeit. Auch <lb n="43" facs="#f0672-l43"/>seine Gesittung mit Ausnahme einiger Familien lobenswerth. Selbst keine <lb n="44" facs="#f0672-l44"/>Gebrechlichen. Die im O. an <placeName ref="#place-fuerstenthum-reuss-aelterer-linie">greizer</placeName>, im N. an <placeName ref="#place-sachsen-weimar">weimarer</placeName> Gebiet anstoßende <lb n="45" facs="#f0672-l45"/>Flur enthält 1498 2/5 Morgen von meist mittelmäßig ergiebigem, aber gut be<lb n="46" break="no" facs="#f0672-l46"/>wirthetem Boden. Verpachtung findet selten statt. In der Flur 25 <rs type="concept" ref="#concept-teich">Teiche</rs>. <lb n="47" facs="#f0672-l47"/>Hauptflurstücke sind: <rs type="concept" ref="#concept-anger">Anger</rs>, <name type="nature" ref="#nature-scheibenbuesche">Scheibenbüsche</name>, <placeName ref="#place-goltzsch-goltischfelder">Goltzsch</placeName> oder <placeName ref="#place-goltzsch-goltischfelder">Goltischfelder</placeName>, alter <lb n="48" facs="#f0672-l48"/><rs type="concept" ref="#concept-bach">Bach</rs>, Höhe, <name type="nature" ref="#nature-saugrund">Saugrund</name>, <placeName ref="#place-letschigwiese">Letschigwiese</placeName>, <placeName ref="#place-wiesenau">Wiesenau</placeName>, <placeName ref="#place-leitenwiesen">Leitenwiesen</placeName>, <rs type="concept" ref="#concept-hofgelaenge">Hofgelänge</rs>, <name type="nature" ref="#nature-leitenberg">Leiten<lb n="49" break="no" facs="#f0672-l49"/>berg</name>, <placeName ref="#place-eschigsleite">Eschigsleite</placeName>, <placeName ref="#place-schmalgelaenge">Schmalgelänge</placeName>, <placeName ref="#place-erlichsfelder">Erlichsfelder</placeName>, <placeName ref="#place-erlichswiesen">Erlichswiesen</placeName> und <name type="nature" ref="#nature-igelsbach">Igelsbach</name>. <lb n="50" facs="#f0672-l50"/>Die kreisförmige Anlage des Centraldorfes um Teich und Kirche, die Orts<lb n="51" break="no" facs="#f0672-l51"/>benennung und einige Flurstücksnamen thun dar, daß der Ort ein sorbischer</p>
</div></body></text>
