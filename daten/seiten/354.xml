38" type="line" n="38" ulx="191" uly="1803" lrx="1542" lry="1846"/><zone xml:id="f0366-l39" type="line" n="39" ulx="193" uly="1847" lrx="1545" lry="1890"/><zone xml:id="f0366-l40" type="line" n="40" ulx="194" uly="1950" lrx="1544" lry="1993"/><zone xml:id="f0366-l41" type="line" n="41" ulx="193" uly="1991" lrx="1542" lry="2028"/><zone xml:id="f0366-l42" type="line" n="42" ulx="193" uly="2027" lrx="1470" lry="2062"/><zone xml:id="f0366-l43" type="line" n="43" ulx="274" uly="2064" lrx="1542" lry="2104"/><zone xml:id="f0366-l44" type="line" n="44" ulx="191" uly="2105" lrx="1400" lry="2139"/><zone xml:id="f0366-l45" type="line" n="45" ulx="248" uly="2135" lrx="1541" lry="2178"/><zone xml:id="f0366-l46" type="line" n="46" ulx="191" uly="2182" lrx="1541" lry="2216"/><zone xml:id="f0366-l47" type="line" n="47" ulx="191" uly="2215" lrx="1539" lry="2250"/><zone xml:id="f0366-l48" type="line" n="48" ulx="193" uly="2253" lrx="386" lry="2285"/><zone xml:id="f0366-l49" type="line" n="49" ulx="232" uly="2283" lrx="1305" lry="2326"/><zone xml:id="f0366-l50" type="line" n="50" ulx="262" uly="2326" lrx="1539" lry="2369"/><zone xml:id="f0366-l51" type="line" n="51" ulx="193" uly="2361" lrx="1541" lry="2404"/></surface></facsimile>
<text><body><div type="page" n="354"><pb n="354" facs="#f0366"/>
<fw type="header" place="top">V. Geschichte des Landes und seines Fürstenhauses.</fw>
<p xml:id="p354-b1"><lb n="1" facs="#f0366-l1"/>Unter den Augen und der Führung seines Vaters, des Deutschherrn, hat er sich <lb n="2" facs="#f0366-l2"/>ohne Zweifel ruhmvoll ausgezeichnet und den Namen des Ruthenen als Lohn <lb n="3" facs="#f0366-l3"/>und Zeugnis seiner Thaten heimgetragen. Merkwürdig bleibt immerhin, dass <lb n="4" facs="#f0366-l4"/>von dem Regentenhause der Voigte alle Linien, welche sich des Namens Reuss <lb n="5" facs="#f0366-l5"/>enthielten, untergegangen sind und dass nur die jüngere Linie Plauen, welche <lb n="6" facs="#f0366-l6"/>den Namen ihres Stammvaters Reuss fortpflanzte, sich blühend erhalten hat.</p>
<p xml:id="p354-b2"><lb n="7" facs="#f0366-l7"/>Wie als Jüngling, so zeigt <persName ref="#person-heinrich-der-ruthene-ruzze-reuss">Heinrich der Ruthene</persName> als Mann in seiner <lb n="8" facs="#f0366-l8"/>Wirksamkeit einen tüchtigen Charakter. Er schloss in Verbindung mit seinen <lb n="9" facs="#f0366-l9"/>Brüdern 1254, somit gleich im Beginne des deutschen Interregnums und des <lb n="10" facs="#f0366-l10"/>wilden Faustrechtes, mit <persName ref="#person-heinrich-der-erlauchte-markgraf-von-meissen">Heinrich dem Erlauchten von Meissen</persName> ein gegenseitiges <lb n="11" facs="#f0366-l11"/>Schutzbündnis ab, verträgt sich 1261 mit dem Pfalzgrafen zu Rhein des Banners <lb n="12" facs="#f0366-l12"/>wegen, empfängt 1272 vom König <persName ref="#person-ottokar-von-boehmen">Ottokar von Böhmen</persName> als Entgelt für seine <lb n="13" facs="#f0366-l13"/>hochwichtigen Thaten das Schloss <placeName ref="#place-graeslitz">Gräslitz</placeName>, 1278 vom Grafen <persName ref="#person-conrad-von-eberstein">Conrad von <lb n="14" facs="#f0366-l14"/>Eberstein</persName> dessen Lehen im Gau Dobene, 1281 vom Kaiser <persName ref="#person-rudolf-von-habsburg">Rudolf</persName> zum Pfande <lb n="15" facs="#f0366-l15"/>die Märkte <placeName ref="#place-asch">Asch</placeName> und <placeName ref="#place-selb">Selb</placeName>, 1288 die Güter des <persName ref="#person-albert-von-neiperg">Albert von Neiperg</persName>, 1290 <lb n="16" facs="#f0366-l16"/>vom Landgrafen <persName ref="#person-friedrich-von-thueringen">Friedrich von Thüringen</persName> das Gut <placeName ref="#place-tinz">Tinz</placeName> als Pfand und 1296 <lb n="17" facs="#f0366-l17"/>vom König <persName ref="#person-adolf-von-nassau">Adolf</persName> das Schloss <placeName ref="#place-hirschberg">Hirschberg</placeName>. Zu diesen Gütern erwarb er von <lb n="18" facs="#f0366-l18"/>den Linien seiner Brüder noch <placeName ref="#place-greiz">Greiz</placeName>, <placeName ref="#place-reichenbach">Reichenbach</placeName>, <placeName ref="#place-mylau">Mylau</placeName>, <placeName ref="#place-ronneburg">Ronneburg</placeName> und <lb n="19" facs="#f0366-l19"/><placeName ref="#place-werdau">Werdau</placeName> und durch <persName ref="#person-ulrich-sack">Ulrich Sack</persName> Antheile an <placeName ref="#place-sparnberg">Sparnberg</placeName>, <placeName ref="#place-waldstein">Waldstein</placeName> und <placeName ref="#place-muenchberg">Münch<lb n="20" break="no" facs="#f0366-l20"/>berg</placeName>. Auch ward er von 1282 an königlicher Richter (judex imperii) im <lb n="21" facs="#f0366-l21"/>pleissener Lande und befand sich öfters im Gefolge der Könige. Neben dieser <lb n="22" facs="#f0366-l22"/>Wirksamkeit bedachte er im Geiste seiner Zeit außer den Klöstern <orgName ref="#organisation-kloster-cronswitz">Cronswitz</orgName>, <lb n="23" facs="#f0366-l23"/><orgName ref="#organisation-kloster-lausnitz">Lausnitz</orgName> und <orgName ref="#organisation-marienkloster-altenburg">Altenburg</orgName> besonders den <orgName ref="#organisation-deutscher-orden">deutschen Ritterorden</orgName> in <placeName ref="#place-plauen">Plauen</placeName>. Hoch<lb n="24" break="no" facs="#f0366-l24"/>bejahrt starb er Ende des Jahres 1303. In den letzten Jahren seines Lebens <lb n="25" facs="#f0366-l25"/>standen ihm nur seine zwei Enkel zur Seite<note place="foot" n="*)" xml:id="p354-fn1" facs="#f0366-fn1"><lb n="43" facs="#f0366-l43"/>1302 beurkundet er: Henricus advocatus de <placeName ref="#place-plauen">Plauen</placeName> senior et filii filiorum <lb n="44" facs="#f0366-l44"/>meorum; 1303: Henricus senior nec non H. et H. juniores adv. de <placeName ref="#place-plauen">Plauen</placeName>.</note>, da seine Söhne vor ihm mit <lb n="26" facs="#f0366-l26"/>Tod abgegangen waren. Seine Gemahlin, der er 1270 Güter in <placeName ref="#place-strassberg">Strassberg</placeName> <lb n="27" facs="#f0366-l27"/>überwiesen hatte, war Gräfin <persName ref="#person-kunigunde">Kunigunde</persName>, Tochter <persName ref="#person-conrad-von-eberstein">Conrads von Eberstein</persName> und <lb n="28" facs="#f0366-l28"/>der <persName ref="#person-irmgard-von-dassel">Irmgard von Dassel</persName>. Mit Bewilligung ihres Gatten hatte sie 1298 und <lb n="29" facs="#f0366-l29"/>kurz vor ihrem Tode (1301) <orgName ref="#organisation-kloster-cronswitz">Cronswitz</orgName> reichlich begnadigt. Als ihr Gatte das <lb n="30" facs="#f0366-l30"/>Zeitliche segnete, waren von den drei Söhnen und drei Töchtern seiner Ehe nur <lb n="31" facs="#f0366-l31"/>die letzteren, sämmtlich Nonnen zu <orgName ref="#organisation-kloster-cronswitz">Cronswitz</orgName>, am Leben<note place="foot" n="**)" xml:id="p354-fn2" facs="#f0366-fn2"><lb n="45" facs="#f0366-l45"/>Das <orgName ref="#organisation-kloster-cronswitz">Stift Cronswitz</orgName> verspricht 1302 urkundlich, gewisse Geldzinsen in <placeName ref="#place-strassberg">Strassberg</placeName> <lb n="46" facs="#f0366-l46"/>nach der Verordnung der eben verstorbenen <persName ref="#person-kunigunde">Kunigunde</persName>, Voigtin von <placeName ref="#place-plauen">Plauen</placeName> und Gemahlin <lb n="47" facs="#f0366-l47"/>des Voigts <persName ref="#person-heinrich-der-ruthene-ruzze-reuss">Heinrich von Plauen d. ä.</persName>, an seine drei im Stifte <orgName ref="#organisation-kloster-cronswitz">Cronswitz</orgName> befindlichen Töchter <lb n="48" facs="#f0366-l48"/>auszuzahlen.</note>. Einer der drei <lb n="32" facs="#f0366-l32"/>Söhne war Mönch geworden und als Prior zu <placeName ref="#place-plauen">Plauen</placeName> vor 1300 gestorben; <lb n="33" facs="#f0366-l33"/>von den beiden übrigen nannte sich der ältere <persName ref="#person-heinrich-der-boehme-voigt-von-plauen">Heinrich der Böhme</persName>, der jüngere <lb n="34" facs="#f0366-l34"/><persName ref="#person-heinrich-reuss">Heinrich Reuss</persName> oder <persName ref="#person-ruzze">Ruzze</persName>. Jener, schon 1272 volljährig<note place="foot" n="***)" xml:id="p354-fn3" facs="#f0366-fn3"><lb n="49" facs="#f0366-l49"/>Von 1275 an kommt er neben seinem Vater in den Urkunden vor.</note>, weil damals sein <lb n="35" facs="#f0366-l35"/>Vater <persName ref="#person-heinrich-d-ae">Heinrich d. ä.</persName> genant wird, hatte höchstwahrscheinlich an den für König <lb n="36" facs="#f0366-l36"/><persName ref="#person-ottokar-von-boehmen">Ottokar von Böhmen</persName> verrichteten Thaten seines Vaters wesentlichen Antheil <lb n="37" facs="#f0366-l37"/>und sich dadurch den Namen des Böhmen errungen. Daneben führte er auch <lb n="38" facs="#f0366-l38"/>den Beinamen des Langen, wie dies aus einer Urkunde vom Jahre 1333 he<lb n="39" break="no" facs="#f0366-l39"/>rvorgeht†). Dass er übrigens in hohem Ansehen stand, zeigt sich im Jahre</p>
<p xml:id="p354-b3"><lb n="40" facs="#f0366-l40"/>Verwaltung des Landes betraut und darum im Lande zurückgehalten war, vor Allem der <lb n="41" facs="#f0366-l41"/>Umstand entgegen, dass nicht ihn, den Sohn aus erster Ehe, sondern den ältesten Sohn aus <lb n="42" facs="#f0366-l42"/>der zweiten Ehe Sagen ruhmreicher Kämpfe und ein kriegerischer Beiname schmücken.</p>
<p><note place="foot" n="†)" xml:id="p354-fn4" facs="#f0366-fn4"><lb n="50" facs="#f0366-l50"/>In einer Urkunde vom 19. August 1333 heißt es: <persName ref="#person-heinrich">Heinrich</persName>, Voigt von <placeName ref="#place-plauen">Plauen</placeName>, <lb n="51" facs="#f0366-l51"/>ältester Sohn <persName ref="#person-heinrich-der-lange">Heinrichs des Langen</persName>, verzichtet mit Zustimmung seiner Gattin <persName ref="#person-agnes">Agnes</persName> von</note></p>
</div></body></text>
