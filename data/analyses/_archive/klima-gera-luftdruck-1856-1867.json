{
 "id": "klima-gera-luftdruck-1856-1867",
 "title": {
  "de": "Luftdruck in Gera 1856–1867",
  "en": "Air pressure at Gera, 1856–1867"
 },
 "category": "climate",
 "section": "t1-1-7",
 "sources": [
  {
   "page": "54",
   "block": "b4",
   "rows": "r2-r14"
