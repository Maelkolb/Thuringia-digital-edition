{
 "id": "bevoelkerung-todtgeborene-1858-1867",
 "title": {
  "de": "Totgeborene 1858–1867",
  "en": "Stillbirths 1858–1867"
 },
 "category": "population",
 "section": "t1-2-1",
 "sources": [
  {
   "page": "111",
