 "id": "bevoelkerung-entwicklung-1647-1867",
 "title": {
  "de": "Bevölkerungsentwicklung 1647–1867 nach Landratsbezirken",
  "en": "Population development by district, 1647–1867"
 },
 "category": "population",
 "section": "t1-2-1",
