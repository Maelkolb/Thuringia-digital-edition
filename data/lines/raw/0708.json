.5}, {"id": "k029", "baseline": [[159, 1414], [1520, 1414]], "polygon": [[159, 1414], [159, 1435], [1520, 1431], [1520, 1414], [1520, 1383], [159, 1380], [159, 1414]], "box": [155, 1377, 1524, 1438], "region": "_31b0996c-d63c-4976-9843-975b666e1466", "ocr": "Vortheil ganz ausgemergelt worden. Das jetzige Schulhaus, 1863 ganz nen", "conf": 87.1}, {"id": "k030", "baseline": [[159, 1459], [1520, 1456]], "polygon": [[159, 1459], [159, 1473], [1517, 1476], [1520, 1456], [1517, 1426], [189, 1422], [187, 1422], [186, 1422], [158, 1429], [159, 1459]], "box": [154, 1419, 1524, 1479], "region": "_31b0996c-d63c-4976-9843-975b666e1466", "ocr": "erbaut, iſt ein Schmuck des Dorfes. An 80 Schüler erhalten in zwei Klaſſen", "conf": 91.9}, {"id": "k031", "baseline": [[159, 1501], [1520, 1501]], "polygon": [[159, 1501], [159, 1514], [1518, 1516], [1520, 1501], [1520, 1471], [159, 1470], [159, 1501]], "box": [155, 1467, 1524, 1519], "region": "_31b0996c-d63c-4976-9843-975b666e1466", "ocr": "Unterricht. Ein Rittergut beſtand nicht im Orte. Die Obergerichte gehörten", "conf": 89.8}, {"id": "k032", "baseline": [[159, 1543], [1515, 1543]], "polygon": [[159, 1543], [159, 1559], [1514, 1563], [1515, 1543], [1515, 1514], [159, 1507], [159, 1543]], "box": [155, 1504, 1519, 1566], "region": "_31b0996c-d63c-4976-9843-975b666e1466", "ocr": "dem Landesherrn und außer 19 Häuſern, über welche die Gutsherrn zu Zoll⸗", "conf": 91.5}, {"id": "k033", "baseline": [[159, 1586], [1517, 1586]], "polygon": [[159, 1586], [159, 1601], [1515, 1605], [1517, 1586], [1517, 1554], [159, 1549], [159, 1586]], "box": [155, 1546, 1521, 1608], "region": "_31b0996c-d63c-4976-9843-975b666e1466", "ocr": "grün und Frankendorf die Niedergerichte beſaßen, und außer einem der mühl⸗", "conf": 89.8}, {"id": "k034", "baseline": [[159, 1627], [1518, 1627]], "polygon": [[159, 1627], [159, 1645], [1515, 1648], [1518, 1627], [1515, 1596], [159, 1596], [159, 1627]], "box": [155, 1593, 1522, 1651], "region": "_31b0996c-d63c-4976-9843-