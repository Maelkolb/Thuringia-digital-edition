": "kaiſerlichen Hauptquartier in Ebersdorf an. Napoleon nahm ſeine Wohnung im Schloſſe.", "conf": 92.3}, {"id": "k025", "baseline": [[68, 1263], [1408, 1258]], "polygon": [[68, 1263], [68, 1276], [1405, 1278], [1408, 1258], [1403, 1234], [67, 1237], [68, 1263]], "box": [63, 1231, 1412, 1281], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Der Fürſt Heinrich LI. war eben kränklich, aber ſeine Gemahlin, eine ebenſo menſchenfreund⸗", "conf": 90.6}, {"id": "k026", "baseline": [[67, 1294], [1408, 1297]], "polygon": [[67, 1294], [65, 1308], [1405, 1314], [1408, 1297], [1406, 1272], [67, 1270], [67, 1294]], "box": [61, 1267, 1412, 1317], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "liche, als geiſtvolle Dame, mit welcher der Kaiſer ſich lange unterhielt, erwarb ſich die Achtung", "conf": 91.9}, {"id": "k027", "baseline": [[67, 1330], [1409, 1327]], "polygon": [[67, 1330], [67, 1344], [1408, 1342], [1409, 1327], [1406, 1303], [65, 1300], [67, 1330]], "box": [61, 1297, 1413, 1347], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "des großen Mannes. Ihr verdankte die Herrſchaft Ebersdorf Befreiung von weiterer Ein⸗", "conf": 92.1}, {"id": "k028", "baseline": [[67, 1364], [1409, 1360]], "polygon": [[67, 1364], [67, 1379], [1408, 1378], [1409, 1360], [1406, 1336], [65, 1335], [67, 1364]], "box": [61, 1332, 1413, 1382], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "guartierung und Vorſpann, ſowie das ganze reußiſche Land ſpäterhin einen kaiſerlichen Schutz⸗", "conf": 86.6}, {"id": "k029", "baseline": [[68, 1394], [1409, 1397]], "polygon": [[68, 1394], [67, 1408], [1406, 1411], [1409, 1397], [1408, 1373], [68, 1367], [68, 1394]], "box": [63, 1364, 1413, 1414], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "brief und gänzliche Befreiung von jeder Contribution. Zudem blieben die reußiſchen Mann⸗", "conf": 92.0}, {"id": "k030", "baseline": [[70, 1433], [1409, 1433]], "polygon": [[70, 1433], [70, 1454], [1409, 1454], [1409, 1433], [1408, 1405], [70, 1406], [70, 1433]], "box": [66, 1402, 1413, 1457], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "ſchaften unentwaffnet. Am 9. October Vormittags machte Napoleon eine Recognoſcirung", "conf": 90.5}, {"id": "k031", "baseline": [[68, 1466], [1409, 1466]], "polygon": [[68, 1466], [68, 1486], [1409, 1484], [1409, 1466], [1409, 1444], [68, 1444], [68, 1466]], "box": [64, 1441, 1413, 1489], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "gegen Schleiz hin und ertheilte darauf dem Marſchall Fürſt v. Ponte-Corvo den Befehl,", "conf": 92.2}, {"id": "k032", "baseline": [[70, 1502], [1409, 1502]], "polygon": [[70, 1502], [70, 1513], [1408, 1519], [1409, 1502], [1408, 1474], [70, 1475], [70, 1502]], "box": [66, 1471, 1413, 1522], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Schleiz zu nehmen. Als er am Morgen des 10. Octobers von Ebersdorf aufbrach, ließ er", "conf": 91.7}, {"id": "k033", "baseline": [[67, 1534], [1408, 1537]], "polygon": [[67, 1534], [65, 1547], [1405, 1553], [1408, 1537], [1406, 1510], [67, 1507], [67, 1534]], "box": [61, 1504, 1412, 1556], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "daſelbſt ein Commando ſeiner Garden als Sauvegarde zurück mit dem gemeſſenen Befehle,", "conf": 89.4}, {"id": "k034", "baseline": [[68, 1570], [1411, 1570]], "polygon": [[68, 1570], [68, 1586], [1411, 1582], [1411, 1570], [1411, 1544], [68, 1540], [68, 1570]], "box": [64, 1537, 1415, 1589], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "nicht zu geſtatten, daß irgend ein Militär im Schloſſe oder in Ebersdorf ſich einquartiere.", "conf": 89.0}, {"id": "k035", "baseline": [[68, 1604], [1408, 1604]], "polygon": [[68, 1604], [68, 1622], [1408, 1619], [1408, 1604], [1408, 1580], [68, 1579], [68, 1604]], "box": [64, 1576, 1412, 1625], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Am Abende deſſelben Tages, wo das kaiſerliche Hauptquartier abgegangen war, traf Mar⸗", "conf": 91.4}, {"id": "k036", "baseline": [[68, 1639], [1408, 1636]], "polygon": [[68, 1639], [68, 1658], [125, 1651], [686, 1657], [688, 1657], [757, 1649], [1405, 1655], [1408, 1636], [1405, 1615], [67, 1612], [68, 1639]], "box": [63, 1609, 1412, 1661], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "ſchall Lefobre an der Spitze von 3000 Garden ein. Ebersdorf war ihm zum Quartier an⸗", "conf": 88.1}, {"id": "k037", "baseline": [[68, 1673], [1411, 1673]], "polygon": [[68, 1673], [68, 1688], [1409, 1690], [1411, 1673], [1409, 1648], [68, 1648], [68, 1673]], "box": [64, 1645, 1415, 1693], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "gewieſen, dennoch ging er weiter, obgleich die Truppen ſchon einen ſtarken Marſch gemacht", "conf": 92.4}, {"id": "k038", "baseline": [[67, 1708], [1411, 1708]], "polygon": [[67, 1708], [67, 1721], [1411, 1721], [1411, 1708], [1411, 1679], [67, 1678], [67, 1708]], "box": [63, 1675, 1415, 1724], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "hatten. Zwei Tage ſpäter kam der Staatsſeeretär Maret, welcher auf dem ganzen Wege", "conf": 89.1}, {"id": "k039", "baseline": [[67, 1739], [1409, 1742]], "polygon": [[277, 1709], [262, 1709], [247, 1709], [232, 1709], [217, 1709], [202, 1709], [187, 1709], [172, 1709], [157, 1709], [142, 1709], [127, 1709], [112, 1709], [97, 1709], [82, 1709], [67, 1709], [67, 1739], [65, 1757], [1406, 1759], [1409, 1742], [1408, 1717], [290, 1709], [277, 1709]], "box": [61, 1706, 1413, 1762], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "in den vormaligen Quartieren des Kaiſers das ſeinige genommen hatte. Er hielt vor dem", "conf": 90.5}, {"id": "k040", "baseline": [[68, 1775], [1408, 1775]], "polygon": [[68, 1775], [68, 1789], [1406, 1795], [1408, 1775], [1408, 1751], [68, 1751], [68, 1775]], "box": [64, 1748, 1412, 1798], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Schloſſe, nannte der Wache ſeinen Namen, erhielt aber zur Antwort, daß ſie ohne Unter⸗", "conf": 92.2}, {"id": "k041", "baseline": [[65, 1809], [1406, 1809]], "polygon": [[65, 1809], [65, 1829], [1406, 1829], [1406, 1809], [1406, 1787], [65, 1780], [65, 1809]], "box": [61, 1777, 1410, 1832], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "ſchied Niemand einlaſſen dürfe. Jetzt verlangte er, dem Fürſten ſeinen Namen zu melden,", "conf": 90.3}, {"id": "k042", "baseline": [[67, 1844], [1411, 1844]], "polygon": [[67, 1844], [67, 1857], [1409, 1859], [1411, 1844], [1411, 1820], [67, 1820], [67, 1844]], "box": [63, 1817, 1415, 1862], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "und erſt nach der Einladung vom Fürſten ließ ihn die Wache durch. Am 10. Oetober nahm", "conf": 90.1}, {"id": "k043", "baseline": [[67, 1878], [1411, 1878]], "polygon": [[67, 1878], [67, 1890], [1409, 1896], [1411, 1878], [1411, 1854], [67, 1854], [67, 1878]], "box": [63, 1851, 1415, 1899], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Napoleon ſein Hauptquartier zu Schleiz, am 11. zu Auma. Bereits am Vormittage des", "conf": 92.5}, {"id": "k044", "baseline": [[65, 1910], [1411, 1913]], "polygon": [[275, 1880], [260, 1880], [245, 1880], [230, 1880], [215, 1880], [200, 1880], [185, 1880], [170, 1880], [155, 1880], [140, 1880], [125, 1880], [110, 1880], [95, 1880], [80, 1880], [65, 1878], [65, 1910], [64, 1928], [1408, 1931], [1411, 1913], [1409, 1887], [289, 1880], [275, 1880]], "box": [60, 1875, 1415, 1934], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "letzten Tages waren die franzöſiſchen Truppen unter dem Großherzog von Berg und dem Mar⸗", "conf": 88.6}, {"id": "k045", "baseline": [[67, 1947], [1411, 1947]], "polygon": [[67, 1947], [67, 1961], [1409, 1965], [1411, 1947], [1411, 1923], [67, 1923], [67, 1947]], "box": [63, 1920, 1415, 1968], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "ſchall Ponte⸗Corvo in Gera eingerückt und bis Langenberg vorgedrungen; am Nachmittage", "conf": 84.2}, {"id": "k046", "baseline": [[67, 1980], [1409, 1983]], "polygon": [[67, 1980], [65, 1995], [1406, 2000], [1409, 1983], [1408, 1955], [67, 1953], [67, 1980]], "box": [61, 1950, 1413, 2003], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "traf auch Napoleon in Gera ein, ritt aber ſogleich auf den Galgenberg zur Recognoſcirung", "conf": 90.9}, {"id": "k047", "baseline": [[67, 2012], [1411, 2016]], "polygon": [[67, 2012], [67, 2031], [1409, 2031], [1411, 2016], [1409, 1991], [67, 1988], [67, 2012]], "box": [63, 1985, 1415, 2034], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "der Gegend, entwarf nach ſeiner Rückkunft in die Stadt in Gegenwart des Großherzogs", "conf": 92.1}, {"id": "k048", "baseline": [[65, 2046], [1411, 2051]], "polygon": [[65, 2046], [65, 2064], [1409, 2063], [1411, 2051], [1409, 2025], [65, 2022], [65, 2046]], "box": [61, 2019, 1415, 2067], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "von Berg, in deſſen Quartier er einige Stunden abgeſtiegen war, und in Gegenwart der", "conf": 92.4}, {"id": "k049", "baseline": [[65, 2081], [1411, 2085]], "polygon": [[65, 2081], [64, 2099], [1408, 2103], [1411, 2085], [1408, 2054], [65, 2054], [65, 2081]], "box": [60, 2051, 1415, 2106], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Marſchälle von Neufchatel, Ponte⸗Corvo und Davouſt den Plan zur Schlacht bei Jena und", "conf": 91.2}, {"id": "k050", "baseline": [[67, 2117], [1409, 2120]], "polygon": [[67, 2117], [65, 2132], [1406, 2135], [1409, 2120], [1408, 2093], [67, 2090], [67, 2117]], "box": [61, 2087, 1413, 2138], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "ging hierauf in ſein Hauptquartier nach Auma zurück. Am 12. October Nachmittags 3 Uhr", "conf": 91.3}, {"id": "k051", "baseline": [[65, 2148], [1411, 2153]], "polygon": [[65, 2148], [65, 2168], [1409, 2166], [1411, 2153], [1409, 2127], [65, 2120], [65, 2148]], "box": [61, 2117, 1415, 2171], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "kam die Fußgarde Napoleons, 10,000 Mann ſtark, nach Gera und eine Stunde darauf der", "conf": 91.2}, {"id": "k052", "baseline": [[65, 2184], [1409, 2190]], "polygon": [[65, 2184], [64, 2196], [1406, 2204], [1409, 2190], [1408, 2163], [65, 2157], [65, 2184]], "box": [60, 2154, 1413, 2207], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Kaiſer ſelbſt. Er nahm, nachdem er wiederum den mit zwei Kanonen beſetzten Galgenberg", "conf": 90.7}, {"id": "k053", "baseline": [[65, 2219], [1411, 2222]], "polygon": [[1409, 2196], [91, 2196], [67, 2187], [65, 2219], [65, 2235], [1409, 2234], [1411, 2222], [1409, 2196]], "box": [61, 2184, 1415, 2238], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "beſtiegen hatte, ſein Hauptquartier im Gebände der Landesregierung. Hier war es, wo er", "conf": 91.2}, {"id": "k054", "baseline": [[64, 2251], [1411, 2256]], "polygon": [[64, 2251], [62, 2268], [1408, 2269], [1411, 2256], [1409, 2229], [64, 2226], [64, 2251]], "box": [58, 2223, 1415, 2272], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "die erſten Trophäen des Sieges ſeiner Armee bei Saalfeld erhielt. Mit Napoleon waren", "conf": 92.3}, {"id": "k055", "baseline": [[65, 2286], [1408, 2290]], "polygon": [[65, 2286], [64, 2305], [1405, 2308], [1408, 2290], [1406, 2265], [65, 2257], [65, 2286]], "box": [60, 2254, 1412, 2311], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "zugleich in Gera die Marſchälle Düroe, Soult, Lefebre, Beſſieres, die Generäle Oudinot,", "conf": 82.5}, {"id": "k056", "baseline": [[65, 2323], [1408, 2323]], "polygon": [[65, 2323], [65, 2337], [1406, 2343], [1408, 2323], [1408, 2301], [65, 2299], [65, 2323]], "box": [61, 2296, 1412, 2346], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "Villemaney, Savary, Rapp, Hülin, Eſteve, Chaſſeloup, Macon, Berthier, Clarke, Caulin⸗", "conf": 87.7}, {"id": "k057", "baseline": [[64, 2353], [1406, 2361]], "polygon": [[65, 2323], [64, 2353], [62, 2371], [1403, 2379], [1406, 2361], [1405, 2334], [77, 2331], [68, 2323], [65, 2323]], "box": [58, 2320, 1410, 2382], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "court und der Kunſtkenner Dinon. Am 13. October Vormittags 10 Uhr'rückte Napoleon,", "conf": 83.8}, {"id": "k058", "baseline": [[64, 2389], [1409, 2395]], "polygon": [[64, 2389], [64, 2410], [382, 2404], [473, 2404], [496, 2415], [497, 2415], [499, 2415], [500, 2415], [502, 2415], [512, 2407], [530, 2413], [532, 2413], [533, 2413], [727, 2406], [841, 2419], [842, 2421], [968, 2421], [968, 2419], [970, 2419], [1003, 2410], [1072, 2421], [1073, 2422], [1220, 2422], [1220, 2421], [1222, 2421], [1256, 2410], [1273, 2418], [1274, 2418], [1276, 2418], [1321, 2409], [1406, 2416], [1409, 2395], [1408, 2368], [64, 2364], [64, 2389]], "box": [60, 2361, 1413, 2425], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "an der Spitze ſeiner Garden, aus Gera und nahm den Weg über Köſtritz nach Jena. Dies", "conf": 87.0}, {"id": "k059", "baseline": [[64, 2427], [748, 2424]], "polygon": [[64, 2427], [64, 2446], [101, 2458], [103, 2458], [104, 2458], [164, 2448], [179, 2460], [181, 2460], [182, 2460], [184, 2460], [185, 2460], [217, 2448], [244, 2460], [245, 2460], [247, 2461], [305, 2461], [305, 2460], [307, 2460], [340, 2448], [385, 2454], [386, 2454], [388, 2454], [404, 2446], [422, 2458], [424, 2458], [425, 2458], [427, 2460], [493, 2460], [493, 2458], [494, 2458], [496, 2458], [512, 2448], [587, 2458], [589, 2458], [748, 2448], [748, 2424], [743, 2397], [62, 2401], [64, 2427]], "box": [58, 2394, 752, 2464], "region": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "ocr": "der Zug Napoleons durch das reußiſche Land.", "conf": 92.7}], "regions": [{"id": "_56ead04b-5040-4cf7-ab5b-de00c4325d62", "type": "text", "polygon": [[415, 161], [1058, 161], [1070, 196], [473, 208], [413, 202], [415, 161]]}, {"id": "_bc478b5a-ef2c-45fd-8e6e-79d6fc44b344", "type": "text", "polygon": [[422, 245], [1417, 257], [1423, 2222], [1417, 2401], [1399, 2413], [796, 2413], [746, 2443], [59, 2431], [59, 263], 